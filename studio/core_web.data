# ç©ã¿ã‹ã•ã­

```fmrb
gfx = $fmrb_gfx
x = $fmrb_x
y = $fmrb_y
w = $fmrb_w

layers = [
  [0xE0, "ãƒ¦ãƒ¼ã‚¶ã®ã‚¢ãƒ—ãƒª"],
