## id: send_public_send
## area: meta
## title: send reaches private, public_send does not
## expect: [:secret, :no_method_error]
## mrblib: uses (__send__)
class RpPriv
  private
  def s = :secret
end
r = [RpPriv.new.send(:s)]
begin
  RpPriv.new.public_send(:s)
  r << :called
rescue NoMethodError
  r << :no_method_error
end
r

