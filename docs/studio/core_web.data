  TmpReaderApp.new.start
rescue => e
  Log.error("TMPR: exception #{e.class}: #{e.message}")
end
app_handle_name = "tmp_reader"
app_screen_name = "TmpReader"
default_window_mode = "window"
default_window_width = 150
