app_screen_name = "Lua app demo"
app_screen_name_ja = "Lua„Éá„É¢"
#default_window_mode = "background" # or "fullwindow" or "window" or "background"
default_window_mode = "window" # or "fullwindow" or "window" or "background"

# if fullscreen/fullwindow, they will be ignored
default_window_width = 150
default_window_height = 150

