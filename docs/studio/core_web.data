,*ş‡©’.¿Ä«¹␀␀␀␀IEND®B`‚# HID Device Configuration
# Define mouse and gamepad report formats for specific USB devices.
# When a device matching vid/pid is connected, this layout is used
# instead of auto-detection or boot protocol fallback.
#
# [[mouse]] fields:
#   vid, pid         - USB Vendor/Product ID (hex integers)
#   name             - Human-readable device name (for logging)
#   report_id        - Report ID byte value (-1 or omit if no report ID)
#   report_len       - Report data length in bytes (excluding Report ID)
#   skip_control_transfer - Skip USB control transfers for this device (default: false)
#   buttons          - Button field: offset (bits), size (bits)
#   x, y             - Axis fields: offset, size, min, max, relative
#
# [[gamepad]] fields:
#   vid, pid         - USB Vendor/Product ID (hex integers)
#   name             - Human-readable device name (for logging)
#   report_len       - Report data length in bytes
#   buttons          - Button bitmask: offset (bits), size (bits)
#   hat              - HAT/D-pad field: offset (bits), size (bits) (optional)
#   left_x, left_y, right_x, right_y, l2, r2 - Axis fields: offset, size, center
#
# Bit offsets are counted from the start of report data (after Report ID if present).
# For signed relative axes, set min to negative value (e.g., min = -2048).
# For absolute axes (e.g., touchpad), set relative = false.

# Logitech Unifying Receiver - Report Protocol mode with 12-bit X/Y
[[mouse]]
vid = 0x046D
pid = 0xC534
name = "Logitech Unifying"
report_id = 0x02
report_len = 7
buttons = { offset = 0, size = 8, min = 0, max = 1, relative = false }
x = { offset = 16, size = 12, min = -2048, max = 2047, relative = true }
y = { offset = 28, size = 12, min = -2048, max = 2047, relative = true }

# Logickeyboard TITAN keyboard (integrated touchpad)
[[mouse]]
vid = 0x258A
pid = 0x1205
name = "TITAN keyboard touchpad"
report_id = 0x01
report_len = 5
buttons = { offset = 0, size = 8, min = 0, max = 1, relative = false }
x = { offset = 8, size = 8, min = -127, max = 127, relative = true }
y = { offset = 16, size = 8, min = -127, max = 127, relative = true }

# HORI PAD 3 TURBO (PS3 era gamepad, 19-byte report)
# Byte layout: [buttons_lo, buttons_hi, hat|0x0F, lx, ly, rx, ry, ...]
#
# Button mapping (verified):
#   0=Square  1=Cross  2=Circle  3=Triangle
#   4=L1  5=R1  6=L2  7=R2
#   8=SELECT  9=START  10=L3  11=R3
#   12=Up  13=Down  14=Left  15=Right  (from HAT switch)
#
# Axis mapping (verified, range -128 ~ 127):
#   0=Left stick X   1=Left stick Y
#   2=Right stick X  3=Right stick Y
#
[[gamepad]]
vid = 0x0F0D
pid = 0x0009
name = "HORI PAD 3 TURBO"
report_len = 19
buttons = { offset = 0, size = 16 }
hat = { offset = 16, size = 4 }
left_x = { offset = 24, size = 8, center = 128 }
left_y = { offset = 32, size = 8, center = 128 }
right_x = { offset = 40, size = 8, center = 128 }
right_y = { offset = 48, size = 8, center = 128 }

# Sipeed NanoKVM-USB - Absolute coordinates, 13-bit X/Y
[[mouse]]
vid = 0x359F
pid = 0x3302
name = "NanoKVM-USB"
report_id = 0x02
report_len = 6
skip_control_transfer = true
buttons = { offset = 0, size = 5, min = 0, max = 1, relative = false }
x = { offset = 8, size = 13, min = 0, max = 4095, relative = false }
y = { offset = 24, size = 13, min = 0, max = 4095, relative = false }

# Generic OEM "USB Optical Mouse" - 5-byte report, no Report ID,
# 12-bit X/Y packed (X spans byte1 + low nibble of byte2,
# Y spans high nibble of byte2 + byte3). Byte 4 is wheel (ignored).
# Verified with: 00 02 F0 FF 00 -> X=+2, Y=-1 (12-bit signed)
# TEMPORARILY DISABLED to test descriptor parse auto-detect path.
# [[mouse]]
# vid = 0x30FA
# pid = 0x0300
# name = "USB Optical Mouse (12-bit packed)"
# report_len = 5
# buttons = { offset = 0, size = 8, min = 0, max = 1, relative = false }
# x = { offset = 8, size = 12, min = -2048, max = 2047, relative = true }
# y = { offset = 20, size = 12, min = -2048, max = 2047, relative = true }
# Settings for the WebAssembly (browser) build -- doc/wasm/.
#
# The web bundle stages ONLY git-tracked flash/ content plus this file, so
# nothing personal or secret can reach it. Based on system_conf_p4.toml: the
# wasm build reuses the Modern in-process display path (display_mode is not
# consulted on wasm; the value stays for the shared parser). No radios, no
# remote desktop.
system_name = "Family mruby OS (Web)"
display_width = 426
display_height = 240
# No overscan margin: the Tab5 LCD shows the full framebuffer, unlike
# the NTSC output where the border area is hidden by overscan.
display_margin_x = 0
display_margin_y = 0
default_user_app_width = 386
default_user_app_height = 180
display_mode = "tab5_dsi" # Tab5 MIPI-DSI panel, driven locally (ntsc_ipc / spi_direct / headless / tab5_dsi / sdl2 / atom_display)
# How many app slots to hand out. The device targets leave this out and get
# their build ceiling of 9; the web build raises the ceiling to 32
# (wasm/CMakeLists.txt) because browser memory is not the device's, and says so
# here. Anything above the ceiling is clamped with a warning at boot.
max_apps = 32
debug_mode = true
# No radios on the web build: BLE / WiFi settings are not present here.
mouse_scale_x = 0.5
mouse_scale_y = 0.5
timezone = "JST-9"
keyboard_layout = "jp" # "jp" or "us"
language = "en" # "ja" or "en"

# Web default: the cyberpunk palette (RGB332). 0x01 is OFF-LIMITS for any
# theme color: it is the desktop foreground canvas color key (transparent).
# The page's settings can put
# the classic device palette back (wasm/web/main.js rewrites this block in
# MEMFS before boot); the classic values live there, keep the two in step.
[theme]
desktop_bg = 0x00
menu_bg = 0x22
window_bg = 0x00
text = 0x1C
text_light = 0xFF
highlight = 0xE3
border = 0x0E
button = 0x46
dir_color = 0xFC

[[shortcuts]]
key = "l"
app = "launcher"

[[shortcuts]]
key = "s"
app = "default/shell"

[[shortcuts]]
key = "e"
app = "default/editor"

[[shortcuts]]
key = "n"
app = "app/tool/nsf_player.app.rb"

[[shortcuts]]
key = "i"
app = "default/inspector"

# App categories hidden from the launcher (files stay on flash and remain
# runnable via the editor / debugd). The Linux sim config has no entries,
# so the sim still shows everything.
[[launcher_exclude]]
dir = "debug"

[[launcher_exclude]]
dir = "test"

# The counterpart of the Retro configs' "modern" exclusion: apps that need
# hardware only a Retro machine has (NTSC output, the WROVER side) go under
# /app/retro and are hidden here. The directory does not exist yet -- an
# exclusion for a missing directory simply never matches. /app/modern stays
# visible on this board; that is what it is for.
[[launcher_exclude]]
dir = "retro"

# Remote desktop (browser viewer via WiFi). WiFi credentials live in
# /etc/wifi.toml (see config/wifi_p4.toml.example).
