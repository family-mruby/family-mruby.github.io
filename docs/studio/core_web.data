## id: comparable
## area: object
## title: include Comparable with <=>
## expect: [true, 2]
class RpVer
  include Comparable
  attr_reader :n
  def initialize(n) = @n = n
  def <=>(o) = n <=> o.n
end
[RpVer.new(1) < RpVer.new(2), [RpVer.new(3), RpVer.new(2)].min.n]

## id: enumerable_custom
## area: object
## title: include Enumerable with each
## expect: [[2], [2, 4, 6], true]
class RpBag
  include Enumerable
  def each
    yield 1
    yield 2
    yield 3
  end
end
b = RpBag.new
[b.select { |v| v % 2 == 0 }, b.map { |v| v * 2 }, b.include?(3)]

## id: prepend
## area: object
## title: Module#prepend and super
## expect: "[x]"
module RpWrap
  def show = "[#{super}]"
end
class RpShown
  prepend RpWrap
  def show = "x"
end
RpShown.new.show

## id: singleton_class_block
