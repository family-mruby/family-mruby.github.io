## id: flip_case_when
## area: syntax
## title: case/when with ranges, classes, splat
## expect: [:small, :str, :listed]
list = [7, 8]
r = []
[1, "s", 8].each do |v|
  r << case v
       when 0..3 then :small
       when String then :str
       when *list then :listed
       end
end
r

## id: pattern_hash_bind
## area: pattern
## title: in {x:} binds x
## expect: 1
## mrblib: uses (deconstruct_keys)
case {x: 1}
in {x:} then x
end

## id: pattern_hash_literal
## area: pattern
## title: in {x: 3} with a literal value
## expect: [:three, :other]
r = []
[{x: 3}, {x: 4}].each do |h|
  r << case h
       in {x: 3} then :three
       else :other
       end
end
r

