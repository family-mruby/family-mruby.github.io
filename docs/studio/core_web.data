    def hi = :cm
  end
end
RpCm.hi

## id: protected_method
## area: object
## title: protected method callable from same class
## expect: [true, :no_method_error]
class RpProt
  def initialize(v) = @v = v
  def same?(o) = v == o.v
  protected
  def v = @v
end
r = [RpProt.new(1).same?(RpProt.new(1))]
begin
  RpProt.new(1).v
  r << :called
rescue NoMethodError
  r << :no_method_error
end
r

## id: equal_eql_hash
## area: object
## title: custom eql?/hash as Hash keys
## expect: :found
class RpKey
  attr_reader :k
  def initialize(k) = @k = k
  def eql?(o) = o.is_a?(RpKey) && k == o.k
  def hash = k.hash
end
{RpKey.new(1) => :found}[RpKey.new(1)]

