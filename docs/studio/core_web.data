# Mahjong table: what only the 640x360 table draws (MJ8, doc/ruby_asterism/
# report/mj8.md): its buttons by the clock, the marks' redraw test, the
# melds with the called tile sideways, the own seat's label by the hand.
# Part of MahjongApp, read when the screen is 640x360 (m640_load in
# mahjong_panels.rb).

class MahjongApp < FmrbApp
  # ------------------------------------------------------------ the buttons

  CTRL_RIGHT = 556 # the buttons' right edge (the clock is right of it)

  def draw_buttons640(labels, y, msg)
    calls = false
    labels.each { |l| calls = true if l[2].is_a?(Array) }
    calls = false unless answering_call?
    gap = 4
    total = controls_width(labels, gap)
    if total > CTRL_RIGHT - 4
      # Too wide: the calls' buttons leave out their keys, closer together.
      labels.each { |l| l[2][2] = nil if l[2].is_a?(Array) }
      gap = 2
      total = controls_width(labels, gap)
    end
    x = @x0 + CTRL_RIGHT - total
    left = x
    labels.each do |l|
      tall = calls || l[2].is_a?(Array)
      h = tall ? CALL_BTN_H : u(20)
      by = calls ? hand_y - h : (tall ? y + u(20) - h : y)
      x += button(l[0], l[1], x, by, l[2], h) + gap
    end
    ty = calls ? hand_y - CALL_BTN_H + (CALL_BTN_H - 12) / 2 : y + 4
    room = left - @x0 - 12
    text(@x0 + 4, ty, fit(msg, room), C_TURN) unless msg.strip.empty? || room < 40
  end

  # ------------------------------------------------------------ the same tiles

  # The 640x360 table: choosing hand tile b after a changes the marks (the
  # whole table is drawn again, not only the two hand tiles).
  def marks_differ?(a, b)
    ca = a >= 0 ? hand_at(a) : nil
    cb = b >= 0 ? hand_at(b) : nil
    ka = ca ? tile_kind(ca) : nil
    kb = cb ? tile_kind(cb) : nil
    return false if ka == kb
    (ka && on_table?(ka)) || (kb && on_table?(kb)) ? true : false
  end

  # Whether a tile of kind k is in a river, a meld or the dora indicators.
  def on_table?(k)
    v = @view
    return false unless v
    list = bytes_of(v["dora"])
    kw = v["kw"].is_a?(Array) ? v["kw"] : []
    fu = v["fu"].is_a?(Array) ? v["fu"] : []
    s = 0
    while s < 4
      list += bytes_of(kw[s])
      b = bytes_of(fu[s])
      j = 0
      while j + 2 < b.size # [kind, from, n, n tiles] per meld
        list += b[j + 3, b[j + 2]]
        j += 3 + b[j + 2]
      end
      s += 1
    end
    i = 0
    while i < list.size
      c = list[i]
      return true if c & 0x80 == 0 && tile_kind(c & 0x3F) == k
      i += 1
    end
    false
  end

  # ------------------------------------------------------------ the melds
  #
  # In the small tiles, as at the 1280x720 table: the tile called lies
  # sideways on the side of the seat it came from (the left seat's at the
  # left end, the across seat's second, the right seat's at the right end;
  # xl_sideways_index), an added kan's tile on the sideways one. The own
  # melds at the bottom right, the first call rightmost, the added tile on
  # top of the sideways one; the others' (the across seat's on a line under
  # its name, a side seat's two to a row) in a row 32 high, so an added
  # tile lies 8 px over the sideways one (the row has no room for a whole
  # tile more). A row longer than its room closes up.

  def draw_melds640
    s = 0
    while s < 4
      draw_melds640_seat(rel(s), s)
      s += 1
    end
  end

  def draw_melds640_seat(rl, s)
    ms = xl_melds(s)
    return if ms.empty?
    pr = LAYOUT640[[:melds0, :melds1, :melds2, :melds3][rl]]
    side = rl == 1 || rl == 3
    rows = []
    row = nil
    a = 0
    k = 0
    while k < ms.size
      if row.nil? || (side && k % 2 == 0)
        row = []
        rows << row
        a = 0
      end
      m = ms[rl == 0 ? ms.size - 1 - k : k]
      kind = m[0]
      tl = m[2]
      n = kind == 5 ? 3 : tl.size
      si = xl_sideways_index(kind, m[1], tl.size)
      j = 0
      while j < n
        c = tl[j]
        c = 37 if kind == 3 && (j == 0 || j == n - 1)
        row << [c, j == si, false, a]
        row << [tl[3], true, true, a] if j == si && kind == 5
        a += j == si ? 32 : 24
        j += 1
      end
      a += 4
      k += 1
    end
    r = 0
    while r < rows.size
      list = rows[r]
      last = list[list.size - 1]
      llen = last[1] ? 32 : 24
      total = last[3] + llen
      room = pr[2]
      x0 = @x0 + (side ? pr[0] : pr[0] + pr[2] - (total < room ? total : room))
      y0 = @y0 + (side ? pr[1] + r * 32 : pr[1] + pr[3] - 32)
      i = 0
      while i < list.size
        e = list[i]
        x = x0 + (total <= room ? e[3] : e[3] * (room - llen) / (total - llen))
        if !e[1]
          small_tile(e[0], x, y0)
          same_mark(e[0], x, y0, 24, 32)
        else
          ty = y0 + 8
          ty -= rl == 0 ? 24 : 8 if e[2]
          side_tile(e[0], x, ty)
          same_mark(e[0], x, ty, 32, 24)
        end
        i += 1
      end
      r += 1
    end
  end

  # A small tile lying sideways (the river sheet turned a quarter left).
  def side_tile(c, x, y)
    load_turned_sheets(true)
    img = @turned ? @turned[3] : nil
    return draw_text_tile(c, x, y, 32, 24) unless img
    @gfx.draw_tile(img.id, (c % 10) * 32, (c / 10) * 24, 32, 24, dst_x: x, dst_y: y)
  end

  # ------------------------------------------------------------ the seat labels

  # A seat's wind, name and points: white on a dark box, framed in yellow on
  # that seat's turn. The own seat's (MJ8) is by the hand, the others' by
  # their rivers. rl names the seat for the overflow checker.
  def seat_box(_rl, x, y, label, away, turn)
    w = tw(label) + 8
    @gfx.fill_rect(x, y, w, 16, C_BOX)
    @gfx.draw_rect(x, y, w, 16, C_TURN) if turn
    text(x + 4, y + 2, label, away ? C_AWAY : C_TEXT)
  end
end
# Mahjong table: the local rules of the lobby, the result of a round (MJ3b,
# doc/ruby_asterism/report/mj3.md; two pages of rules and the worst cases
# fitted in MJ5, mj5.md) and the parts of the 640x360 table. Part
# of MahjongApp (mahjong.app.rb requires this file first, as mahjong_xl.rb;
# an app file is read whole and may be at most 64 KB).

class MahjongApp < FmrbApp
  # ------------------------------------------------------------ local rules
  #
  # The view's "ru" and "rx" (asterism-games README "Local rules"): one
  # value per item, in this order (items 0-10 in "ru", 11-14 in "rx"; a
  # host without "rx" has the first eleven only). The owner changes them in
  # the lobby (the host takes rule(token, item, value) before the game
  # only); everybody sees them. Item 9 is the extra round ("å»¶é•·"): the
  # west round of a hanchan and the south round of a tonpuu game (a host
  # before MJ-E2 has the west round only). Item 10 is the time (MJ-E3,
  # README "Time"): its value is a code, the seconds for a move plus 1000
  # times the bank's ("5+20" is 20005, a fixed 20 s is 20); "ru" has the
  # seconds for a move, "tb" the bank, "tc" the codes to choose from. A
  # host before MJ-E3 has none of the two: fixed times, RULE_TURNS. Items
  # 15 (the CPUs' level) and 16 (the spectators' delay, seconds; "dc" the
  # choices) are in "ry" (MJ5).
  #
  # The screen shows the items in an order of its own, in groups on two
  # pages (RULE_PAGES; a host's items that the screen does not know, or a
  # host without some of these, are left out).
  B_RULE = 108
  B_RULE_PAGE = 109
  RULE_TURNS = [10, 20, 30, 60]
  RULE_AKA = [0, 3, 4]
  RULE_DELAYS = [0, 60, 180, 300]
  RULE_PAGES = [
    [["å¯¾å±€ã®å½¢", [0, 9]], ["æŒã¡æ™‚é–“", [10]], ["ãƒ‰ãƒ©ãƒ»å½¹", [2, 1, 5, 13, 6, 7]]],
    [["å’Œäº†ãƒ»æµå±€", [3, 4, 11, 12]], ["çµ‚å±€", [8, 14]], ["CPUãƒ»è¦³æˆ¦", [15, 16]]]
  ]

  def setup_rule_strings
    @rule_names = ["åŠè˜ãƒ»æ±é¢¨", "å–°ã„ã‚¿ãƒ³", "èµ¤ãƒ‰ãƒ©", "ãƒ€ãƒ–ãƒ­ãƒ³", "ä¸‰å®¶å’Œ", "å½¹æº€ã®è¤‡åˆ", "æ•°ãˆå½¹æº€",
                   "åˆ‡ã‚Šä¸Šã’æº€è²«", "ãƒˆãƒ“", "å»¶é•·", "æŒã¡æ™‚é–“", "é€”ä¸­æµå±€", "æµã—æº€è²«", "ãƒ€ãƒ–ãƒ«å½¹æº€",
                   "ãƒ†ãƒ³ãƒ‘ã‚¤æ­¢ã‚", "CPU ã®å¼·ã•", "è¦³æˆ¦ã®é…ã‚Œ"]
    @rule_sel = 0   # the item chosen (its number)
    @seat_sel = nil # the seat chosen by the keys (nil: a rule is)
    @rule_page = 0
  end

  def rules
    ru = @view ? @view["ru"] : nil
    return nil unless ru.is_a?(Array)
    rx = @view["rx"]
    ry = @view["ry"]
    ru += rx if rx.is_a?(Array)
    ru += ry if rx.is_a?(Array) && ry.is_a?(Array)
    ru
  end

  # The pages as the host's items allow: [[heading, [items]], ...] each.
  def rule_pages
    n = rules ? rules.size : 0
    out = []
    RULE_PAGES.each do |page|
      groups = []
      page.each do |head, items|
        have = []
        items.each { |i| have << i if i < n }
        groups << [head, have] unless have.empty?
      end
      out << groups unless groups.empty?
    end
    out
  end

  # Every item shown, in the screen's order: [[item, page], ...].
  def rule_order
    out = []
    pages = rule_pages
    pi = 0
    while pi < pages.size
      pages[pi].each { |_h, items| items.each { |i| out << [i, pi] } }
      pi += 1
    end
    out
  end

  # The other page, its first item chosen.
  def rule_flip(page = nil)
    pages = rule_pages
    return if pages.size < 2
    @rule_page = page.nil? ? (@rule_page + 1) % pages.size : page % pages.size
    @rule_sel = pages[@rule_page][0][1][0]
    @dirty = true
  end

  # Item i's value in ru (item 10: its code, with the bank of "tb").
  def rule_value(ru, i)
    return ru[i] unless i == 10
    tb = @view["tb"]
    ru[i] + (tb.is_a?(Integer) ? tb : 0) * 1000
  end

  # The value of item i as the screen says it (item 10: the code).
  def rule_text(i, v)
    return v == 1 ? "æ±é¢¨" : "åŠè˜" if i == 0
    return v == 0 ? "ãªã—" : "#{v}æžš" if i == 2
    return v == 1 ? "æµå±€" : "å…¨å“¡å’Œäº†" if i == 4
    return (v >= 1000 ? "#{v % 1000}+#{v / 1000}" : v.to_s) + "ç§’" if i == 10
    return ["å¼±ã„", "ãµã¤ã†", "å¼·ã„"][v] || v.to_s if i == 15
    return v == 0 ? "ãªã—" : (v % 60 == 0 ? "#{v / 60}åˆ†" : "#{v}ç§’") if i == 16
    v == 1 ? "ã‚ã‚Š" : "ãªã—"
  end

  def rule_choices(i)
    return RULE_AKA if i == 2
    return [0, 1, 2] if i == 15
    if i == 16
      dc = @view["dc"]
      return dc.is_a?(Array) && dc.size > 0 ? dc : RULE_DELAYS
    end
    if i == 10
      tc = @view["tc"]
      return tc.is_a?(Array) && tc.size > 0 ? tc : RULE_TURNS
    end
    [0, 1]
  end

  # The time left on the player's own move, in whole seconds rounded up:
  # "3+20ç§’" (what is left of the move's own time and the bank; "dl" has
  # the bank's ms as its third number, README "Time") or "12ç§’".
  def time_left_text
    ms = @deadline - Machine.board_millis
    ms = 0 if ms < 0
    move = ms - @bank_ms
    if @bank_ms > 0
      return "#{(move + 999) / 1000}+#{@bank_ms / 1000}#{t(:mj_rest)}" if move > 0
      return "0+#{(ms + 999) / 1000}#{t(:mj_rest)}"
    end
    "#{(ms + 999) / 1000}#{t(:mj_rest)}"
  end

  # The owner steps item i to the next (step 1) or the last (-1) choice.
  def rule_step(i, step)
    ru = rules
    return unless ru && owner? && i < ru.size
    list = rule_choices(i)
    k = list.index(rule_value(ru, i))
    k = k.nil? ? 0 : (k + step) % list.size
    return if @cmd_f || @tc.token.nil?
    @cmd_f = @tc.proxy.async.rule(@tc.token, i, list[k])
  rescue ::Asterism::Error => e
    @cmd_f = nil
    @note = e.message.to_s
    @dirty = true
  end

  # The lobby's keys for the rules: up / down choose (on to the other page
  # past the end of one), Tab turns the page, left / right change (the
  # owner). True when the key was one of them.
  def rule_key(k)
    ru = rules
    return false unless ru && @big
    sc = k[0]
    if sc == FmrbConst::KEY_UP || sc == FmrbConst::KEY_DOWN
      order = rule_order
      return true if order.empty?
      pos = 0
      j = 0
      while j < order.size
        pos = j if order[j][0] == @rule_sel
        j += 1
      end
      pos = (pos + (sc == FmrbConst::KEY_UP ? -1 : 1)) % order.size
      @rule_sel = order[pos][0]
      @rule_page = order[pos][1]
      @dirty = true
    elsif sc == FmrbConst::KEY_TAB || k[1] == 9
      rule_flip
    elsif sc == FmrbConst::KEY_LEFT || sc == FmrbConst::KEY_RIGHT
      rule_step(@rule_sel, sc == FmrbConst::KEY_LEFT ? -1 : 1)
    else
      return false
    end
    true
  end

  # ------------------------------------------------------------ the seats (GS5c)
  #
  # The owner sets each seat that is not a player's with its button: empty,
  # CPU, then the AI players the host offers (the lobby view's "ak", in its
  # order; a kind without its key, or past the day's limit, is not there),
  # and empty again. One call each (asterism-games 0.12.1 turns a CPU or
  # AI seat into another kind at once; a refused AI leaves it as it was).
  # The others see the state only.

  # A seat's state: "" empty, "cpu", an AI player's kind; nil a player's.
  def seat_state(s)
    k = seat_kinds[s]
    return nil if k == 1
    return "" if k == 0
    ai = @view["ai"]
    kind = ai.is_a?(Array) ? ai[s].to_s : ""
    kind.empty? ? "cpu" : kind
  end

  def seat_label(st)
    return t(:mj_empty) if st == ""
    st == "cpu" ? t(:mj_cpu) : ai_label(st)
  end

  # The owner turns seat s to the next state (step 1) or the last (-1).
  def seat_step(s, step)
    st = seat_state(s)
    return unless owner? && st
    list = ["", "cpu"] + ai_kinds
    i = list.index(st)
    # An AI player no longer offered: on to empty, or back to a CPU.
    nx = i.nil? ? (step > 0 ? "" : "cpu") : list[(i + step) % list.size]
    if nx == ""
      lobby(B_CPU_OFF, s)
    else
      lobby(B_CPU_ON, s, nx == "cpu" ? nil : nx)
    end
  end

  # The seat's button (the owner) or its state (the others), at x, y.
  def draw_seat_state(s, x, y)
    l = seat_label(seat_state(s))
    if owner?
      w = button(B_SEAT, [s], x, y, l)
      @gfx.draw_round_rect(x, y, w, u(20), u(4), C_TURN) if s == @seat_sel
    else
      text(x + u(6), y + u(4), l, C_DIM)
    end
  end

  # The owner's keys for the seats: up / down choose a seat (the seats come
  # before the first rule: up from it, or down from the last), left / right
  # change the chosen one. True when the key was one of them.
  def seat_key(k)
    return false unless owner?
    sc = k[0]
    order = rules && @big ? rule_order : []
    if sc == FmrbConst::KEY_TAB || k[1] == 9
      @seat_sel = nil
      return false
    end
    up = sc == FmrbConst::KEY_UP
    if up || sc == FmrbConst::KEY_DOWN
      if @seat_sel.nil?
        unless order.empty?
          edge = up ? order[0][0] : order[order.size - 1][0]
          return false unless @rule_sel == edge
        end
        @seat_sel = up ? 3 : 0
      elsif !order.empty? && @seat_sel == (up ? 0 : 3)
        pos = up ? order.size - 1 : 0
        @rule_sel = order[pos][0]
        @rule_page = order[pos][1]
        @seat_sel = nil
      else
        @seat_sel = (@seat_sel + (up ? -1 : 1)) % 4
      end
      @dirty = true
      return true
    end
    return false if @seat_sel.nil?
    return false unless sc == FmrbConst::KEY_LEFT || sc == FmrbConst::KEY_RIGHT
    seat_step(@seat_sel, sc == FmrbConst::KEY_LEFT ? -1 : 1)
    true
  end

  # The rules beside the seats (640x360, and twice that at 1280x720): the
  # page's groups, a heading and a row an item; the owner's rows are
  # buttons (a click steps the value). The page tabs under the title (a
  # click, or Tab).
  def draw_rules
    ru = rules
    return unless ru
    unless @big
      # The small screen: one line under the title.
      s = "#{rule_text(0, ru[0])} å–°ã‚¿ãƒ³#{rule_text(1, ru[1])} èµ¤#{ru[2]} #{rule_text(10, rule_value(ru, 10))}"
      text(@x0 + u(8), @y0 + u(22), s, C_DIM) if net_line.nil?
      return
    end
    x = @x0 + u(452)
    w = @w - u(460)
    y = @y0 + u(36)
    own = owner?
    text(x, y, own ? "ãƒ«ãƒ¼ãƒ« (ä¸Šä¸‹ å·¦å³ Tab)" : "ãƒ«ãƒ¼ãƒ« (å“ã®ä¸»ãŒæ±ºã‚ã‚‹)", C_DIM)
    y += u(17)
    pages = rule_pages
    @rule_page = 0 if @rule_page >= pages.size
    if pages.size > 1
      tw2 = w / pages.size
      pi = 0
      while pi < pages.size
        on = pi == @rule_page
        @gfx.fill_rect(x - u(2) + pi * tw2, y - u(2), tw2 - u(2), u(16), on ? C_SEL : C_BOX)
        @gfx.draw_rect(x - u(2) + pi * tw2, y - u(2), tw2 - u(2), u(16), C_TURN) if on
        l = "#{pi + 1} / #{pages.size}"
        text(x - u(2) + pi * tw2 + (tw2 - tw(l)) / 2, y, l, on ? C_TURN : C_DIM)
        @hits.add(B_RULE_PAGE, x - u(2) + pi * tw2, y - u(2), tw2 - u(2), u(16), [pi])
        pi += 1
      end
      y += u(19)
    end
    (pages[@rule_page] || []).each do |head, items|
      text(x, y, head, C_DIM)
      y += u(16)
      items.each do |i|
        sel = own && @seat_sel.nil? && i == @rule_sel
        @gfx.fill_rect(x - u(2), y - u(2), w, u(16), sel ? C_SEL : C_BOX) if own
        v = rule_text(i, rule_value(ru, i))
        text(x + u(6), y, fit(@rule_names[i], w - tw(v) - u(18)), C_TEXT)
        text_spaced(x + w - tw(v) - u(8), y, v, sel ? C_TURN : C_TEXT)
        @hits.add(B_RULE, x - u(2), y - u(2), w, u(16), [i]) if own
        y += u(17)
      end
    end
  end

  # ------------------------------------------------------------ the player's name (MJ5)
  #
  # Set in the list of tables or the lobby (n, or a click on its button),
  # kept on this machine in /home/mahjong.toml (name = "..."; the browser build
  # keeps /home across a reload), and sent with join: the host keeps a
  # member's name and a join again from the same node changes it, at the
  # seat too. A name is needed before joining a table: the first Enter on a
  # table asks for it (starting from the machine's name, config.toml) and
  # joins once it is given. The node ID only tells the seats apart. Typed with the keyboard;
  # kana arrive as their UTF-8 bytes one key at a time when the machine's
  # kana input is on (Ctrl+Space), as in the editor. At most NAME_CHARS
  # characters and NAME_BYTES bytes (the host's limit); only characters the
  # font has: ASCII but the quote and the backslash, kana, kanji, full-width
  # forms.
  NAME_CHARS = 12
  NAME_BYTES = 32

  # s without what a name may not have, cut to the limits.
  def clean_player_name(s, strip = true)
    out = ""
    n = 0
    i = 0
    b = s.to_s
    while i < b.bytesize && n < NAME_CHARS
      c = b.getbyte(i)
      len = c < 0x80 ? 1 : (c >= 0xF0 ? 4 : (c >= 0xE0 ? 3 : 2))
      ch = b.byteslice(i, len)
      out << ch if name_char_ok?(ch) && out.bytesize + len <= NAME_BYTES
      n += 1 if name_char_ok?(ch)
      i += len
    end
    strip ? out.strip : out
  end

  def name_char_ok?(ch)
    c = ch.getbyte(0)
    return c >= 0x20 && c <= 0x7E && c != 34 && c != 92 if ch.bytesize == 1
    return false unless ch.bytesize == 3
    cp = ((c & 0x0F) << 12) | ((ch.getbyte(1) & 0x3F) << 6) | (ch.getbyte(2) & 0x3F)
    (cp >= 0x3041 && cp <= 0x30FF) || (cp >= 0x4E00 && cp <= 0x9FFF) || (cp >= 0xFF01 && cp <= 0xFF5E)
  end

  def name_begin
    @name_edit = (@name_set || @name_machine).to_s.dup
    @u8 = ""
    @u8_left = 0
    @dirty = true
  end

  # A key while the name is typed: Enter keeps it, Esc goes back, Backspace
  # takes the last character off, a printable byte (or the bytes of a kana)
  # goes on the end.
  def name_key(k)
    sc = k[0]
    ch = k[1]
    if enter?(k)
      name_done
    elsif sc == FmrbConst::KEY_ESC || ch == 27
      @name_edit = nil
      @pending_join = nil
    elsif sc == 0x2A || ch == 8 || ch == 127
      e = @name_edit
      i = e.bytesize - 1
      i -= 1 while i > 0 && (e.getbyte(i) & 0xC0) == 0x80
      @name_edit = i > 0 ? e.byteslice(0, i) : ""
    elsif ch >= 0x80
      # One byte of a kana; the character goes on once it is whole.
      if ch >= 0xC0
        @u8 = "x".dup
        @u8.setbyte(0, ch)
        @u8_left = ch >= 0xF0 ? 3 : (ch >= 0xE0 ? 2 : 1)
      elsif @u8_left > 0
        b = "x".dup
        b.setbyte(0, ch)
        @u8 << b
        @u8_left -= 1
        name_add(@u8) if @u8_left == 0
      end
    elsif ch >= 0x20
      b = "x".dup
      b.setbyte(0, ch)
      name_add(b)
    end
    @dirty = true
  end

  def name_add(chr)
    s = clean_player_name(@name_edit + chr, false)
    @name_edit = s if s.bytesize > @name_edit.bytesize
  end

  # The name typed is the name: kept, and told to the table (join again
  # from this node: the same membership, the new name).
  def name_done
    n = clean_player_name(@name_edit)
    @dirty = true
    return if n.empty? # a name is needed: the prompt stays
    @name_edit = nil
    changed = n != @name_set
    @name = n
    @name_set = n
    save_assist if changed
    if @pending_join
      p = @pending_join
      @pending_join = nil
      return join(p)
    end
    return unless changed && @tc.table && @tc.token
    @rename_f = @tc.proxy.async.join(@name)
  rescue ::Asterism::Error => e
    @note = e.message.to_s
  end

  # The game host's version (its views' "hv", games 0.16.1) at the bottom of
  # the list (right) and the lobby (left: the rules take the right); nothing
  # for a host that does not say, nor on the small table (426x240, where
  # the bottom line is taken).
  def draw_host_version(right)
    return unless @big && @host_ver && !@host_ver.empty?
    fnt(12, @k)
    s = "ã‚²ãƒ¼ãƒ ãƒ›ã‚¹ãƒˆ #{@host_ver}"
    x = right ? @x0 + @w - tw(s) - u(8) : @x0 + u(8)
    text(x, @y0 + @h - u(16), s, C_DIM)
  end

  # The name's button in the lobby (w: the room for it).
  def draw_name_button(x, y, w)
    l = if @name_edit
          "#{@pending_join ? 'åå‰ã‚’å…¥ã‚Œã¦ã‹ã‚‰å…¥ã‚‹' : 'åå‰'}: #{@name_edit}_  (Enter ã§æ±ºã‚ã‚‹ Esc ã§ã‚„ã‚ã‚‹)"
        elsif @name_set
          "åå‰: #{@name} [N]"
        else
          "åå‰: (ã¾ã ç„¡ã„: å“ã«å…¥ã‚‹å‰ã«æ±ºã‚ã‚‹) [N]"
        end
    fnt(12, @k)
    l = fit(l, w - u(12))
    bw = button(B_NAME, [], x, y, l)
    @gfx.draw_rect(x, y, bw, u(20), C_TURN) if @name_edit
  end

  # ------------------------------------------------------------ the result

  # The head of a round that ended without a win: the draw, an abortive
  # draw by name, and who made nagashi mangan.
  def draw_head(res)
    k = res["k"].to_s
    head = if k == "kyuushu_kyuuhai" then t(:mj_kyuushu_end)
           elsif k == "sanchahou" then t(:mj_sanchahou)
           elsif k == "suufon_renda" then "å››é¢¨é€£æ‰“ã§æµå±€"
           elsif k == "suukaikan" then "å››æ§“æ•£äº†ã§æµå±€"
           elsif k == "suucha_riichi" then "å››å®¶ç«‹ç›´ã§æµå±€"
           else t(:mj_draw)
           end
    ng = res["ng"]
    return head unless ng.is_a?(Array) && ng.size > 0
    names = []
    ng.each { |s| names << seat_name(s.to_i) }
    "#{head}  æµã—æº€è²«: #{names.join(' ')}"
  end

  # Pao after the points: "åŒ…: <name> (å¤§ä¸‰å…ƒ)", "" when none.
  def pao_text(w)
    pa = w["pa"]
    return "" unless pa.is_a?(Array) && pa.size > 0
    out = []
    pa.each { |p| out << "#{seat_name(p[0].to_i)} (#{p[1]})" if p.is_a?(Array) }
    "  åŒ…: #{out.join(' ')}"
  end

  # "çµ‚å±€" and why the game ended, when the host says (the view's "fr").
  def over_head
    r = @view["fr"].to_s
    why = if r == "tobi" then "ãƒˆãƒ“"
          elsif r == "all_last_oya_agari" then "ã‚¢ã‚¬ãƒªæ­¢ã‚"
          elsif r == "all_last_oya_tenpai" then "ãƒ†ãƒ³ãƒ‘ã‚¤æ­¢ã‚"
          elsif r == "sudden_death" then "ã‚µãƒ‰ãƒ³ãƒ‡ã‚¹"
          elsif r == "west" then "è¥¿4å±€ã¾ã§"
          elsif r == "rounds" then "å±€æ•°ã®ä¸Šé™"
          elsif r == "normal_end" then "æœ€å¾Œã®å±€ã¾ã§"
          else ""
          end
    why.empty? ? t(:mj_over) : "#{t(:mj_over)} (#{why})"
  end

  # "æ±1å±€ 0æœ¬å ´" of the round a result is about.
  def round_head(res)
    rd = res["rd"]
    return "" unless rd.is_a?(Array) && rd.size > 2
    "#{WIND[rd[0].to_i % 4]}#{rd[1]}#{t(:mj_kyoku)} #{rd[2]}#{t(:mj_honba)}"
  end

  # One yaku with its han: "æ–­ä¹ˆä¹ 1ç¿»", "ãƒ‰ãƒ© 2ç¿»", "å¤§ä¸‰å…ƒ å½¹æº€" (the
  # engine's dora names carry their count, "ãƒ‰ãƒ© 2": the han says it).
  def yaku_label(w, i)
    ys = w["y"]
    yh = w["yh"]
    s = ys[i].to_s
    return s unless yh.is_a?(Array) && i < yh.size
    h = yh[i].to_i
    parts = s.split(" ")
    if parts.size > 1
      last = parts[parts.size - 1]
      digits = last.bytesize > 0
      k = 0
      while k < last.bytesize
        b = last.getbyte(k)
        digits = false if b < 48 || b > 57
        k += 1
      end
      s = parts[0, parts.size - 1].join(" ") if digits
    end
    return "#{s} ãƒ€ãƒ–ãƒ«å½¹æº€" if h <= -2
    h < 0 ? "#{s} å½¹æº€" : "#{s} #{h}ç¿»"
  end

  # The melds of seat s as tile lists (a closed kan with its ends face down).
  def meld_lists(s)
    out = []
    ms = xl_melds(s)
    i = 0
    while i < ms.size
      tl = ms[i][2].dup
      if ms[i][0] == 3
        tl[0] = 37
        tl[tl.size - 1] = 37
      end
      out << tl
      i += 1
    end
    out
  end

  # The points of seat i: [label, before -> after, change].
  def score_line(i, res)
    d = res["d"].is_a?(Array) ? res["d"] : []
    sc = @view["sc"].is_a?(Array) ? @view["sc"] : []
    dv = d[i].to_i
    after = sc[i].to_i
    tp = res["tp"]
    mark = ""
    if tp.is_a?(Array) && res["k"] == "ryuukyoku"
      mark = tp.index(i) ? " #{t(:mj_tenpai)}" : " ãƒŽãƒ¼ãƒ†ãƒ³"
    end
    ["#{wind_of(i)} #{fit(seat_name(i), @xl ? 200 : 100)}#{mark}", "#{after - dv} â†’ #{after}",
     dv == 0 ? "Â±0" : (dv > 0 ? "+#{dv}" : dv.to_s)]
  end

  def delta_color(i, res)
    d = res["d"].is_a?(Array) ? res["d"] : []
    dv = d[i].to_i
    dv > 0 ? C_KEEP : (dv < 0 ? C_AWAY : C_DIM)
  end

  # The result of a round (or the game) over the middle of the 640x360
  # table: the round, each winner (the hand, the yaku with their han, the
  # fu, han and points), or the draw; then every seat's points before and
  # after, with who was tenpai. A double ron has one block per winner, in
  # turn order from the discarder: then the box is wider and higher, the
  # points go on the winner's line, the yaku in five columns and the four
  # seats' points in two.
  def draw_result
    res = @view["res"]
    fin = @view["fin"]
    wins = res.is_a?(Hash) && res["wn"].is_a?(Array) ? res["wn"] : []
    multi = wins.size > 1
    over = fin.is_a?(Array) && @view["st"] == "over"
    shown = rv_shown
    if @big
      bx = @x0 + (multi ? 20 : 60)
      bw = multi ? 600 : 520
      by = @y0 + (multi ? 4 : 6)
      bh = multi ? 352 : 296
      bh += 22 if rv_on? && !multi # the OK line (MJ9)
    else
      bx = @x0 + 20
      bw = @w - 40
      by = @y0 + 22
      bh = @h - 64
    end
    fnt(12, 1)
    @gfx.fill_rect(bx, by, bw, bh, C_BOX)
    @gfx.draw_rect(bx, by, bw, bh, C_TURN)
    x = bx + 8
    y = by + 6
    if res.is_a?(Hash)
      k = res["k"].to_s
      text(x, y, round_head(res), C_DIM)
      y += 16
      if k == "tsumo_agari" || k == "ron_agari"
        i = 0
        before = 0
        while i < wins.size
          @rv_k = shown - before
          before += rv_steps(wins[i])
          y = draw_win(wins[i], k, res["f"], x, y, multi, bw - 16)
          i += 1
        end
      else
        text_spaced(x, y, fit(draw_head(res), bw - 16), C_TURN)
        y += 18
      end
      unless over || shown < rv_total
        cols = multi ? 2 : 1
        cw = (bw - 16) / cols
        i = 0
        while i < 4
          l = score_line(i, res)
          cx = x + (i % cols) * cw
          cy = y + (i / cols) * 15
          text(cx, cy, fit(l[0], cw * 40 / 100 - 4))
          text(cx + cw * 42 / 100, cy, l[1], C_DIM)
          text(cx + cw * 80 / 100, cy, l[2], delta_color(i, res))
          i += 1
        end
      end
    end
    if over
      y = by + bh - 84
      text(x, y, over_head, C_TURN)
      i = 0
      while i < fin.size
        text_spaced(x, y + 16 + i * 13, fit(fin_line(fin[i]), bw - 16))
        i += 1
      end
      text(x, y + 70, back_lobby_text, C_DIM)
    end
    ok_footer(bx, by, bw, bh) if rv_on?
  end

  # One winner's block; returns the y below it. With several winners the
  # points go on the head line and the yaku in five columns.
  def draw_win(w, k, from, x, y, multi, bw)
    pt = w["pt"].to_s
    head = win_head(w, k, from)
    ys = w["y"].is_a?(Array) ? w["y"] : []
    rk = @rv_k || 9999
    pt_on = rk > ys.size
    if multi
      text(x, y, fit(head, bw - tw(pt) - 16), C_TURN) if rk > 0
      text_spaced(x + bw - tw(pt) - 8, y, pt, C_TURN) if pt_on
    elsif rk > 0
      text(x, y, fit(head, bw), C_TURN)
    end
    y += 16
    hc = bytes_of(w["h"])
    hc = [] if rk <= 0
    step = @big ? 23 : 13
    i = 0
    while i < hc.size
      if @big
        small_tile(hc[i], x + i * step, y)
      else
        text(x + i * 13, y, tile_text(hc[i]))
      end
      i += 1
    end
    ag = w["ag"].to_i
    cx = x + hc.size * step + 6
    if rk <= 0
      # not reached yet: nothing drawn
    elsif @big
      small_tile(ag, cx, y)
      @gfx.draw_rect(cx, y, 23, 31, C_LAST)
    else
      text(cx - 2, y, tile_text(ag), C_TURN)
    end
    cx += step
    ms = rk > 0 ? meld_lists(w["w"].to_i) : []
    # The melds after the winning tile, closer when they would not fit.
    n = 0
    ms.each { |m| n += m.size }
    mstep = step
    mstep = (x + bw - cx - ms.size * 8) / n if n > 0 && cx + n * step + ms.size * 8 > x + bw
    i = 0
    while i < ms.size
      cx += 8
      j = 0
      while j < ms[i].size
        if @big
          small_tile(ms[i][j], cx, y)
        else
          text(cx, y, tile_text(ms[i][j]), C_DIM)
        end
        cx += mstep
        j += 1
      end
      cx += step - mstep
      i += 1
    end
    y += @big ? 36 : 15
    cols = multi ? 5 : 3
    cw = bw / cols
    i = 0
    while i < ys.size && i < rk
      text_spaced(x + (i % cols) * cw, y + (i / cols) * 14, fit(yaku_label(w, i), cw - 6))
      i += 1
    end
    y += ((ys.size + cols - 1) / cols) * 14 + 2
    pa = pao_text(w)
    unless multi
      text_spaced(x, y, fit(pt, bw), C_TURN) if pt_on
      if !pa.empty? && tw(pt) + 4 + tw(pa) <= bw
        text_spaced(x + tw(pt) + 4, y, pa, C_AWAY) if pt_on
        pa = ""
      end
      y += 16
    end
    unless pa.empty?
      text_spaced(x, y, fit(pa.strip, bw), C_AWAY) if pt_on
      y += 14
    end
    y + (multi ? 4 : 4)
  end

  # ------------------------------------------------------------ the round's start and the OKs (MJ9)
  #
  # asterism-games README "Result" (games 0.15.0). After the deal the host
  # waits a moment (the view's "in", the ms left): the round's name in big
  # letters over the middle of the table. A result of a table with humans
  # has "ok" ([the seats that gave their OK, the seats still waited for,
  # the ms until it moves on by itself]): the box shows each winner's yaku
  # one a second, then the points (the host's count, the same rule:
  # per winner a step a yaku line and one for the points, the winners one
  # after the other, one step without a win); a press shows the rest at
  # once and the next one is the OK (the next, 12). A host without the
  # keys (0.14.0) gets the screen as before.

  RV_STEP_MS = 1000

  def round_take(v)
    now = Machine.board_millis
    n = v["in"]
    @intro_until = n.is_a?(Integer) && n > 0 && v["st"] == "play" ? now + n : nil
    ok = v["ok"]
    unless v["st"] == "result" && ok.is_a?(Array) && ok.size > 2 && v["res"].is_a?(Hash)
      @rv_key = nil
      return
    end
    @ok_until = now + ok[2].to_i
    return if @rv_key == v["sv"]
    @rv_key = v["sv"]
    # The steps start when the box shows (after a win's shout).
    @rv_at = @shout ? @shout[2] : now
    @rv_all = false
    @rv_sig = nil
  end

  # The result shows by steps (a host with the OKs).
  def rv_on?
    v = @view
    v && v["st"] == "result" && v["ok"].is_a?(Array) && !@rv_key.nil? && @rv_key == v["sv"] ? true : false
  end

  def rv_steps(w)
    ys = w["y"]
    (ys.is_a?(Array) ? ys.size : 0) + 1
  end

  def rv_total
    res = @view ? @view["res"] : nil
    wins = res.is_a?(Hash) && res["wn"].is_a?(Array) ? res["wn"] : []
    return 1 if wins.empty?
    n = 0
    i = 0
    while i < wins.size
      n += rv_steps(wins[i])
      i += 1
    end
    n
  end

  # The steps shown now (all of them without the OKs or after a press).
  def rv_shown
    return 9999 unless rv_on?
    total = rv_total
    return total if @rv_all
    d = Machine.board_millis - @rv_at
    return 0 if d < 0
    n = d / RV_STEP_MS + 1
    n > total ? total : n
  end

  # A press while the steps run: the rest at once (true: the press is used).
  def rv_skip
    return false unless rv_on? && rv_shown < rv_total
    @rv_all = true
    @dirty = true
    true
  end

  def ok_secs
    return 0 unless @ok_until
    ms = @ok_until - Machine.board_millis
    ms > 0 ? (ms + 999) / 1000 : 0
  end

  # The steps, the seconds and the OKs: what the drawn box shows.
  def rv_sig
    return nil unless rv_on?
    [rv_shown, ok_secs, @view["ok"][0], @view["ok"][1]]
  end

  # From on_update: the round's name goes, a step or a second passes.
  def round_tick(now)
    if @intro_until && now >= @intro_until
      @intro_until = nil
      @dirty = true
    end
    sig = rv_sig
    return if sig.nil? || sig == @rv_sig
    @rv_sig = sig
    @dirty = true
  end

  def bit_count(n)
    c = 0
    while n > 0
      c += n & 1
      n >>= 1
    end
    c
  end

  # The bottom line of the result box: "OK ã‚’å¾…ã£ã¦ã„ã¾ã™ (n/m) ã‚ã¨ N ç§’"
  # and the own OK (the button, "å¾…ã£ã¦ã„ã¾ã™" once given, none while the
  # steps run: a press shows the rest).
  def ok_footer(bx, by, bw, bh)
    ok = @view["ok"]
    done = ok[0].to_i
    m = bit_count(done | ok[1].to_i)
    msg = "OK ã‚’å¾…ã£ã¦ã„ã¾ã™ (#{bit_count(done)}/#{m})  ã‚ã¨ #{ok_secs} ç§’"
    h = @xl ? 40 : u(20)
    y = by + bh - h - (@xl ? 10 : 4)
    fnt(12, @xl ? 2 : 1)
    label = nil
    if @seat && rv_shown >= rv_total
      label = offer(A_NEXT) ? "OK[Enter]" : "å¾…ã£ã¦ã„ã¾ã™"
    end
    lw = label ? tw(label) + (@xl ? 24 : 12) : 0
    x = bx + bw - (@xl ? 12 : 8) - lw
    if label && offer(A_NEXT)
      @xl ? xl_button(A_NEXT, [], x, y, lw, label) : button(A_NEXT, [], x, y, label, h)
    elsif label
      @gfx.fill_round_rect(x, y, lw, h, @xl ? 8 : 4, C_SEL)
      text(x + (lw - tw(label)) / 2, y + (h - @fw) / 2, label, C_DIM)
    end
    room = x - bx - (@xl ? 32 : 16)
    text(bx + (@xl ? 16 : 8), y + (h - @fw) / 2, fit(msg, room), C_DIM) if room > 40
  end

  # The round's name over the middle of the table while the host waits
  # after the deal.
  def draw_intro
    return unless @intro_until && @view && @view["st"] == "play"
    r = @view["r"]
    return unless r.is_a?(Array) && r.size > 2
    s = "#{WIND[r[0].to_i % 4]}#{r[1]}#{t(:mj_kyoku)} #{r[2]}#{t(:mj_honba)}"
    size = @xl ? 5 : (@big ? 3 : 2)
    fnt(12, size)
    pad = 6 * size
    w = tw(s) + pad * 2
    h = @fw + pad * 2
    cy = @xl ? xg[:by] + 80 : (@big ? 168 : @h / 2)
    x = @x0 + (@w - w) / 2
    y = @y0 + cy - h / 2
    @gfx.fill_round_rect(x, y, w, h, pad, C_BOX)
    @gfx.draw_round_rect(x, y, w, h, pad, C_TURN)
    text(x + pad, y + pad, s, C_TURN)
    fnt(12, @k)
    [x, y, w, h]
  end

  # ------------------------------------------------------------ the chosen tile and the help marks
  #
  # Here and not in mahjong.app.rb: with these few methods more in the main
  # file, the Linux sim's spawn failed with NoMemoryError right after the
  # compile (comments of the same size did not), so the main file is kept
  # from growing (doc/ruby_asterism/report/mj5.md, chapter 14).

  # The help mark's half width and how far its tip comes down over the
  # tile's top edge (1280x720, 640x360, the small table).
  def mark_r
    @xl ? 7 : (@big ? 4 : 3)
  end

  def mark_overlap
    @xl ? 6 : (@big ? 3 : 2)
  end

  # How far the mark reaches above the tile's top.
  def mark_rise
    mark_r * 2 + 2 - mark_overlap
  end

  # The help mark of a hand tile at (x, y) (its top left, w wide): a
  # downward triangle above the tile's middle, its tip over the top edge.
  def assist_mark(x, y, w, col)
    r = mark_r
    cx = x + w / 2
    tip = y + mark_overlap - 1
    @gfx.fill_triangle(cx - r - 1, tip - r - r - 1, cx + r + 1, tip - r - r - 1, cx, tip, 0x00)
    @gfx.fill_triangle(cx - r, tip - r - r, cx + r, tip - r - r, cx, tip - 2, col)
  end

  # The chosen tile's frame, inside the tile (the 1280x720 hand 4 px, its
  # river 3, the 640x360 tiles and the small ones of both tables 2, the
  # small table 1), its corners cut as the tile's. Also the frame of a tile
  # of the chosen one's kind (MJ8).
  def chosen_frame(x, y, w, h)
    t = w >= 80 ? 4 : (w >= 40 ? (@xl ? 3 : 2) : (@big ? 2 : 1))
    @gfx.fill_rect(x + t, y, w - t - t, t, C_CHOSEN)
    @gfx.fill_rect(x + t, y + h - t, w - t - t, t, C_CHOSEN)
    @gfx.fill_rect(x, y + t, t, h - t - t, C_CHOSEN)
    @gfx.fill_rect(x + w - t, y + t, t, h - t - t, C_CHOSEN)
    return if t < 2
    k = t / 2
    @gfx.fill_rect(x + k, y + k, t, t, C_CHOSEN)
    @gfx.fill_rect(x + w - k - t, y + k, t, t, C_CHOSEN)
    @gfx.fill_rect(x + k, y + h - k - t, t, t, C_CHOSEN)
    @gfx.fill_rect(x + w - k - t, y + h - k - t, t, t, C_CHOSEN)
  end

  # ------------------------------------------------------------ the parts (MJ5)

  # The 640x360 table's parts, [x, y, w, h] from the user area's corner (the
  # overflow checker, tools/mahjong_overflow, holds every drawing to them;
  # the melds and the rivers are laid out in them). The spectators' screen
  # has its own (WATCH, mahjong_watch.rb).
  LAYOUT640 = {
    info: [4, 2, 144, 32], dora: [354, 2, 148, 32], assist: [504, 2, 136, 20], controls: [4, 253, 552, 47], clock: [560, 250, 76, 34], hand: [6, 287, 630, 69],
    label0: [4, 250, 168, 16], label1: [492, 38, 144, 16], label2: [152, 22, 200, 16], label3: [4, 38, 144, 16],
    melds0: [200, 308, 436, 48], melds1: [492, 54, 144, 64], melds2: [152, 38, 336, 32], melds3: [4, 54, 144, 64],
    river0: [176, 170, 288, 96], river1: [492, 120, 144, 128], river2: [176, 72, 288, 96], river3: [4, 120, 144, 128],
    rules: [448, 34, 192, 326]
  }

  def layout640(key)
    LAYOUT640[key] || WATCH[key]
  end
  # "<winner> ãƒ„ãƒ¢" / "<winner> ãƒ­ãƒ³ (<who dealt in> ã‹ã‚‰)".
  def win_head(w, k, from)
    return "#{seat_name(w['w'])} #{t(:mj_tsumo)}" if k == "tsumo_agari"
    "#{seat_name(w['w'])} #{t(:mj_ron)} (#{seat_name(from)} #{t(:mj_from)})"
  end

  # A line of the final ranking: "1ä½ <name> 31200 (+21.2)".
  def fin_line(f)
    pt = f[3].to_i
    sign = pt < 0 ? "-" : "+"
    pt = -pt if pt < 0
    "#{f[1]}#{t(:mj_rank)} #{seat_name(f[0])} #{f[2]} (#{sign}#{pt / 10}.#{pt % 10})"
  end

  # ------------------------------------------------------------ the controls (640x360 and the small table)

  # The buttons the host offers and what the screen has to say. 640x360
  # (MJ8): the buttons right-aligned against the clock (LAYOUT640 :clock),
  # the line left of them; a call's buttons show their tiles (call_label):
  # while a discard is answered the whole row is CALL_BTN_H high and stands
  # on the hand's top (no tile is lifted then), on the own move a kan's
  # button is that high and the others the usual. The small table: the
  # texts from the left, the time left in the line.
  def draw_controls
    y = hand_y - SEL_LIFT - mark_rise - u(20) # clear of the help marks over the lifted tile
    list = @view["a"].is_a?(Array) ? @view["a"] : []
    labels = []
    i = 0
    while i < list.size
      o = list[i]
      tl = bytes_of(o[1])
      label = @big ? call_label(o[0], tl) : button_label(o[0], tl)
      labels << [o[0], tl, label] if label
      i += 1
    end
    labels << [B_LEAVE, [], t(:mj_leave)] if @seat.nil?
    msg = status_line.to_s
    wt = waits_text
    msg = "#{t(:mj_pick)} #{msg}" if @pick && wt.nil?
    msg = "#{wt} #{msg}" if wt
    if @big
      draw_buttons640(labels, y, msg)
      draw_assist if @seat
      draw_clock
      return
    end
    bx = @x0 + 2
    labels.each { |l| bx += button(l[0], l[1], bx, y, l[2]) + 4 }
    msg = "#{time_left_text} #{msg}" if @deadline
    text(bx + 4, y + 4, fit(msg, @x0 + @w - bx - 8), C_TURN) unless msg.strip.empty? || bx + 40 > @x0 + @w
  end

  # The help level's button, at the top right of the 640x360 table.
  def draw_assist
    fnt(12, 1)
    button(B_ASSIST, [], @x0 + @w - tw(assist_label) - 16, @y0 + 2, assist_label)
  end

  # ------------------------------------------------------------ the clock (MJ6)
  #
  # The own time in big figures (asterism-games README "Time"): the move's
  # own seconds and the bank after it ("5+20"), only the bank once the
  # move's own time is up ("+17"). White, yellow from CLOCK_YELLOW_MS of the
  # move's own time (2 s: the default move is only 5 s), red in the bank. The same for the answer to a call (no bank).
  # 640x360: right of the controls, above the drawn tile (LAYOUT640
  # :clock); 1280x720: at the end of the buttons (mahjong_xl.rb).

  CLOCK_YELLOW_MS = 2000

  def clock_parts
    return nil unless @deadline && @seat && mode == :table
    ms = @deadline - Machine.board_millis
    ms = 0 if ms < 0
    move = ms - @bank_ms
    return ["+#{(ms + 999) / 1000}", C_RED] if @bank_ms > 0 && move <= 0
    sec = (move + 999) / 1000
    [@bank_ms > 0 ? "#{sec}+#{@bank_ms / 1000}" : sec.to_s, move <= CLOCK_YELLOW_MS ? C_TURN : C_TEXT]
  end

  # The clock in a dark box at (x, y), w x h: the figures px (scaled by
  # size), at 12 px when they do not fit.
  def clock_box(c, x, y, w, h, px, size)
    @gfx.fill_round_rect(x, y, w, h, 4, C_BOX)
    @gfx.draw_round_rect(x, y, w, h, 4, c[1])
    fnt(px, size)
    fnt(12, size) if tw(c[0]) > w - 8
    text(x + (w - tw(c[0])) / 2, y + (h - @fw) / 2, c[0], c[1])
  end

  def draw_clock
    c = clock_parts
    return unless c
    r = LAYOUT640[:clock]
    clock_box(c, @x0 + r[0], @y0 + r[1], r[2], r[3], 12, 2)
    fnt(12, 1)
  end

  # ------------------------------------------------------------ declarations (MJ6)
  #
  # The view's "cl" (asterism-games README "Views"): the last declaration,
  # [type, the state version, the seat(s)]. A new one is shown for
  # SHOUT_MS in big letters at the seat that made it, by its river (where
  # the player sits on this screen); a win's result waits until it goes.
  # The first view of a table shows none (that one is old news).
  SHOUT_MS = 1000
  # The middle of each seat's river (rl 0-3) from the user area's corner:
  # 640x360, its spectators' screen (mahjong_watch.rb), 1280x720.
  SHOUT_640 = [[320, 218], [564, 184], [320, 120], [76, 184]]
  SHOUT_WATCH = [[320, 262], [452, 198], [320, 134], [188, 198]]
  SHOUT_XL = [[640, 436], [928, 268], [640, 172], [352, 300]]

  def shout_take(v, old)
    cl = v["cl"]
    n = cl.is_a?(Array) && cl.size > 2 ? cl[1] : nil
    return if n.nil? || n == @cl_n
    @cl_n = n
    return if old.nil?
    @shout = [cl[0], cl[2, cl.size - 2], Machine.board_millis + SHOUT_MS]
    @dirty = true
  end

  def shout_tick(now)
    return unless @shout && now >= @shout[2]
    @shout = nil
    @dirty = true
  end

  def shout_label(type)
    return t(:mj_ron) if type == A_RON || type == 13
    return t(:mj_kyuushu) if type == A_KYUUSHU
    return t(:mj_kan) if type == A_ANKAN || type == A_KAKAN || type == A_MINKAN
    return t(:mj_riichi) if type == A_RIICHI
    return t(:mj_tsumo) if type == A_TSUMO
    type == A_PON ? t(:mj_pon) : t(:mj_chi)
  end

  # The shout of each seat that declared (1280x720 draws it from xl_draw).
  def draw_shout
    return unless @shout
    seats = @shout[1]
    l = shout_label(@shout[0])
    out = []
    i = 0
    while i < seats.size
      rl = rel(seats[i].to_i)
      if @xl
        c = SHOUT_XL[rl]
        # The spectators' board is lower (MJ10): the shouts go with it.
        out << draw_shout_box(l, c[0], c[1] + xg[:by] - XL_BY, 16, 3)
      elsif @big
        c = (watching? || @rp ? SHOUT_WATCH : SHOUT_640)[rl]
        out << draw_shout_box(l, c[0], c[1], 16, 2)
      else
        a = river_area(rl)
        out << draw_shout_box(l, a[0] - @x0 + 40, a[1] - @y0 + 14, 12, 1)
      end
      i += 1
    end
    fnt(12, @k)
    out
  end

  # One shout centred on (cx, cy) from the user area's corner, kept on the
  # screen. Returns its rectangle.
  def draw_shout_box(label, cx, cy, px, size)
    fnt(px, size)
    pad = px * size / 3
    w = tw(label) + pad * 2
    h = @fw + pad
    x = @x0 + cx - w / 2
    y = @y0 + cy - h / 2
    x = @x0 + 2 if x < @x0 + 2
    x = @x0 + @w - w - 2 if x + w > @x0 + @w - 2
    win = @shout[0] == A_RON || @shout[0] == A_TSUMO || @shout[0] == 13
    @gfx.fill_round_rect(x, y, w, h, pad / 2 + 2, C_BOX)
    @gfx.draw_round_rect(x, y, w, h, pad / 2 + 2, win ? C_RED : C_TURN)
    text(x + pad, y + pad / 2, label, C_TURN)
    [x, y, w, h]
  end

  # ------------------------------------------------------------ the guide (MJ8)
  #
  # The status line says what the table waits for now: whose turn it is
  # ("å—å®¶ (Claude) ã®ç•ªã§ã™"), or that the others are answering a discard
  # (who may call is not told), and only on the player's own move what to
  # do. A reply of the host to the player's action goes before it until the
  # state moves on (took_view).

  def status_line
    return t(:mj_lost) if @tc.net != :up || @tc.reconnecting?
    return t(:mj_host_left) if @tc.host_gone?
    return t(:mj_host_away) if @host_away
    g = guide
    @note.empty? ? g : "#{@note}  #{g}"
  end

  def guide
    v = @view
    return "" unless v && v["st"] == "play"
    r = v["r"]
    cur = r.is_a?(Array) && r.size > 7 ? r[6].to_i : -1
    turn = cur >= 0 ? "#{wind_of(cur)}å®¶ (#{seat_name(cur)}) ã®ç•ªã§ã™" : ""
    if @seat.nil?
      return "#{t(:mj_watch_game)}  #{turn}" if v["wm"] == 1
      return "#{t(:mj_watching)}  #{turn}"
    end
    if calls_phase?
      return t(:mj_others) if @others
      return "é³´ãã‹ãƒ‘ã‚¹ (Esc) ã‚’é¸ã‚“ã§ãã ã•ã„" unless offer(A_RON)
      return offer(A_PON) || offer(A_CHI) || offer(A_MINKAN) ? "ãƒ­ãƒ³ãƒ»é³´ããƒ»ãƒ‘ã‚¹ (Esc) ã‹ã‚‰é¸ã‚“ã§ãã ã•ã„" : "ãƒ­ãƒ³ã‹ãƒ‘ã‚¹ (Esc) ã‚’é¸ã‚“ã§ãã ã•ã„"
    end
    return turn unless cur == @seat
    offer(A_DAHAI) ? "è‡ªåˆ†ã®ç•ª: åˆ‡ã‚‹ç‰Œã‚’ã‚¯ãƒªãƒƒã‚¯ (å·¦å³ã¨ Enter ã§ã‚‚)" : ""
  end

  # This seat answers a discard now (the call buttons are up).
  def answering_call?
    @seat && @view && @view["st"] == "play" && calls_phase? && !@others ? true : false
  end

  # After take_view: the host's reply goes once the state moves on; no hand
  # tile stays chosen while a discard is answered; the declarations (MJ6).
  def took_view(v, old)
    @note = "" if old && old["sv"] != v["sv"] && v["st"] != "wait"
    @sel = -1 if answering_call?
    shout_take(v, old)
    round_take(v)
  end

  # ------------------------------------------------------------ the call buttons (MJ8)
  #
  # Pon, chi and the kans show their tiles as pictures, the river's 24x32
  # (both tables): [head, tiles, key]. Pon and chi show the two tiles from
  # the hand (the offer's), a closed or added kan its tile, an open kan the
  # discard (the offer has no tiles). Other buttons are texts.

  CALL_BTN_H = 34   # the 640x360 (and small) table's row of call buttons

  def call_label(type, tl)
    tiles = nil
    if type == A_ANKAN || type == A_KAKAN
      tiles = [tl[0]] unless tl.empty?
    elsif type == A_PON || type == A_CHI || type == A_MINKAN
      tiles = tl unless tl.empty?
      ls = @view["ls"]
      if tiles.nil? && ls.is_a?(Array) && ls.size > 1
        c = ls[1].to_i & 0x3F
        tiles = type == A_PON ? [c, c] : [c]
      end
    end
    return button_label(type, tl) unless tiles
    return [t(:mj_pon), tiles, "[P]"] if type == A_PON
    [type == A_CHI ? t(:mj_chi) : t(:mj_kan), tiles, "[#{call_key(type, tl)}]"]
  end

  # The width of a button's contents (a text, or [head, tiles, key]).
  def btn_label_w(l)
    return tw(l) unless l.is_a?(Array)
    gap = @fw / 3
    w = tw(l[0]) + gap + l[1].size * 24
    l[2] ? w + gap + tw(l[2]) : w
  end

  # A button's contents centred in its box.
  def btn_content(l, x, y, w, h)
    ty = y + (h - @fw) / 2
    unless l.is_a?(Array)
      text(x + (w - tw(l)) / 2, ty, l)
      return
    end
    gap = @fw / 3
    cx = x + (w - btn_label_w(l)) / 2
    text(cx, ty, l[0])
    cx += tw(l[0]) + gap
    i = 0
    while i < l[1].size
      small_tile(l[1][i], cx, y + (h - 32) / 2)
      cx += 24
      i += 1
    end
    text(cx + gap, ty, l[2]) if l[2]
  end

  def controls_width(labels, gap)
    total = 0
    labels.each { |l| total += btn_label_w(l[2]) + u(12) + gap }
    total - gap
  end

  # ------------------------------------------------------------ the same tiles (MJ8)
  #
  # While a hand tile is chosen, every river tile, meld tile and dora
  # indicator of its kind (a red five is a five) gets the chosen tile's blue
  # frame; @mk is the kind (draw_screen sets it), nil when none is chosen.

  def tile_kind(c)
    c < 30 && c % 10 == 9 ? c - 5 : c
  end

  def mark_kind
    return nil unless @seat && @sel >= 0 && !@rp && mode == :table
    c = hand_at(@sel)
    c ? tile_kind(c) : nil
  end

  def same?(c)
    @mk ? tile_kind(c) == @mk : false
  end

  def same_mark(c, x, y, w, h)
    chosen_frame(x, y, w, h) if @mk && tile_kind(c) == @mk
  end

  # ------------------------------------------------------------ the title (MJ8)
  #
  # "ãƒ’ãƒ‡é›€" when the app opens, while the network comes up (on_update goes
  # on): at least TITLE_MIN_MS, then until the list of tables is ready, at
  # most TITLE_MS (a key or a click skips it at once). Its drawing is
  # in mahjong_title.rb, read when the app opens and taken out of the class
  # again when the title goes (the VM of a game does not hold it).

  TITLE_MS = 2000
  TITLE_MIN_MS = 1000

  def title_draw
    unless @title_in
      @title_in = true
      require "#{APP_DIR}/mahjong_title"
    end
    draw_title
  end

  # Any key or click: the title goes at the next update (and the event is
  # not the list's).
  def title_skip(t)
    return false unless @title_until
    @title_until = 1 if t == :key_down || t == :mouse_up
    true
  end

  def title_tick(now)
    return unless @title_until
    shown_min = now >= @title_until - TITLE_MS + TITLE_MIN_MS
    return unless now >= @title_until || (shown_min && list_ready?)
    @title_until = nil
    @title_drawn = nil
    title_unload
    @dirty = true
    draw_screen if @unsupported
  end

  # ------------------------------------------------------------ shared with the 1280x720 table
  #
  # Used by every screen (mahjong_xl.rb is read only at 1280x720).

  XL_STACK = [[0, -8], [-8, 0], [0, 8], [8, 0]] # an added kan's tile over the sideways one (rl 0-3)

  # The 1280x720 table's file and sheets, when the screen is that big.
  def load_xl_sheets
    return unless @xl
    unless @xl_in
      @xl_in = true
      require "#{APP_DIR}/mahjong_xl"
    end
    xl_load_sheets
  end

  # The small tiles turned for the four seats ([r0, r90, r180, r270]): the
  # 1280x720 table's opponents and the 640x360 spectators (mahjong_watch.rb);
  # side_only: only r270, the sideways tile of the 640x360 melds (MJ8). Each
  # sheet is tried once.
  def load_turned_sheets(side_only = false)
    return if @turned_all
    @turned ||= [@river_sheet, nil, nil, nil]
    unless @turned_side
      @turned_side = true
      @turned[3] = load_sheet("tiles_river_r270.bmp", 320, 96, XL_DIR)
    end
    return if side_only
    @turned_all = true
    @turned[1] = load_sheet("tiles_river_r90.bmp", 320, 96, XL_DIR)
    @turned[2] = load_sheet("tiles_river_r180.bmp", 240, 128, XL_DIR)
  end

  # The base turn of a seat's tiles (rl: 0 self, 1 right, 2 across, 3 left):
  # the top of the picture points away from its player.
  def xl_rot(rl)
    [0, 3, 2, 1][rl]
  end

  # Where each tile of a row goes along it: lens are the tiles' lengths,
  # room the length there is; past the room the tiles close up (each still
  # shows its start, the last one whole). Returns the offsets.
  def close_up(lens, room)
    total = 0
    lens.each { |l| total += l }
    out = []
    a = 0
    if total <= room || lens.size < 2
      lens.each do |l|
        out << a
        a += l
      end
      return out
    end
    last = lens[lens.size - 1]
    i = 0
    while i < lens.size
      out << a * (room - last) / (total - last)
      a += lens[i]
      i += 1
    end
    out
  end

  # The river of a seat as [[code, sideways, mark], ...] (called tiles are
  # not in it; the tile after a called riichi tile stays upright).
  def xl_river_list(s)
    b = bytes_of(@view["kw"][s])
    ls = @view["ls"]
    out = []
    i = 0
    while i < b.size
      c = b[i]
      if c & 0x80 == 0
        last = i == b.size - 1 && ls.is_a?(Array) && ls[0] == s
        out << [c & 0x3F, c & 0x40 != 0, last ? 1 : 0]
      end
      i += 1
    end
    out
  end

  # The melds of a seat: [[kind, from, [tiles]], ...].
  def xl_melds(s)
    fu = @view["fu"]
    out = []
    return out unless fu.is_a?(Array)
    b = bytes_of(fu[s])
    i = 0
    while i + 2 < b.size
      n = b[i + 2]
      out << [b[i], b[i + 1], b[i + 3, n]]
      i += 3 + n
    end
    out
  end

  # Which of a meld's tiles lies sideways: the one taken from the player on
  # the left goes at the left, from across second, from the right at the end.
  def xl_sideways_index(kind, from, n)
    return -1 if kind == 3 || from == 0
    m = kind == 5 ? 3 : n
    return 0 if from == 3
    return 1 if from == 2
    m - 1
  end

  # A spectator's hand of seat s: [codes, drawn] ("sh", "sd"), or nil (a
  # host without them, or a seated player's screen).
  def spec_hand(s)
    return nil if @seat
    sh = @view["sh"]
    return nil unless sh.is_a?(Array) && sh[s]
    sd = @view["sd"]
    d = sd.is_a?(Array) ? sd[s].to_i : -1
    [bytes_of(sh[s]), d]
  end

  # The 640x360 table's own drawing (mahjong_640.rb), read when the screen
  # is that size (load_hand_sheet): the 1280x720 table's VM never holds it.
  def m640_load
    return if @m640_in
    @m640_in = true
    require "#{APP_DIR}/mahjong_640"
  end

  # The line under the end of a game: a watch game (GS15) goes back to the
  # lobby by itself.
  def back_lobby_text
    @view && @view["wm"] == 1 ? t(:mj_watch_over) : t(:mj_back_lobby)
  end

  # ------------------------------------------------------------ the spectators' screen

  def watching?
    @big && !@xl && @seat.nil? && mode == :table
  end

  # The 640x360 spectators' screen is read the first time it is wanted
  # (watching, a record): a seated player's VM never holds it.
  def watch_load
    return if @watch_in || !@big || @xl
    @watch_in = true
    require "#{APP_DIR}/mahjong_watch"
  end
end
# Mahjong table: the recent games of a table and their records (MJ6,
# doc/ruby_asterism/report/mj6.md). Part of MahjongApp, but read only when
# the player opens them (rp_open in mahjong.app.rb requires this file), so
# a game never has it in its VM.
#
# The game host keeps the games each table played to the end (asterism-games
# README "Game records") and gives them out: records(from) the list, newest
# first, in pages; record(id) a game's head (who sat where, the final ranks,
# a line per round); record(id, round, part) a round: the deal, the dora
# indicators, every draw, discard and call, the result (a long round in
# parts). Tiles are look's names ("5m", "0p" a red five, "1z" east).
#
# The list shows a line per game (when, the game, the four by rank with
# their points; this player's name in yellow). A game opens on its first
# round: the table as a spectator sees it, the four hands face up, built
# from the record up to the move chosen and drawn by the table's own
# spectator drawing (the 640x360 one of mahjong_watch.rb, the 1280x720 one
# of mahjong_xl.rb) on a view made for it. One round is held at a time.
#
# Keys: the list: up / down choose, Enter opens, Esc back. A record: right
# (or Enter, a click on the table) the next move, left the one before, down
# the next round's start, up this round's start (at the start: the round
# before), Esc back to the list. A declaration shows its shout as in a game.
#
# The base methods it changes (draw_screen, run_key, run_click, run_button,
# run_move, status_line) are kept under rp_base_* and called when no
# record is open.

class MahjongApp < FmrbApp
  B_RP_ROW = 120
  B_RP_BACK = 121
  B_RP_STATS = 124
  RP_KINDS = ["draw", "discard", "riichi", "chi", "pon", "open_kan", "closed_kan", "added_kan", "dora", "tsumo",
              "ron", "nine_kinds"]
  # The tiles in a hand's order (the red five after the four).
  RP_ORDER = [0, 1, 2, 3, 4, 9, 5, 6, 7, 8, 10, 11, 12, 13, 14, 19, 15, 16, 17, 18,
              20, 21, 22, 23, 24, 29, 25, 26, 27, 28, 30, 31, 32, 33, 34, 35, 36]

  alias rp_base_draw_screen draw_screen
  alias rp_base_run_key run_key
  alias rp_base_run_click run_click
  alias rp_base_run_button run_button
  alias rp_base_run_move run_move
  alias rp_base_status_line status_line
  alias rp_base_on_update on_update

  # ------------------------------------------------------------ open, close, the calls

  def rp_start(p)
    rp_strings
    @rp = p
    @rp_state = :list
    @rp_list = []
    @rp_sel = 0
    @rp_top = 0
    @rp_note = t(:mj_rp_loading)
    @rp_head = nil
    @rp_data = nil
    @rp_parts = nil
    @rp_v = 0
    @rp_f = nil
    @shout = nil
    @dirty = true
    rp_call(:page, 0)
    Log.info("mahjong: records of #{p}")
  end

  def rp_close
    if @rp_state == :view
      @rp_state = :list
      @rp_data = nil
      @rp_head = nil
      @shout = nil
    else
      @rp = nil
      @rp_list = nil
    end
    @rp_f = nil
    @xl_items = nil
    @dirty = true
  end

  # Asks the host: :page (records(from)), :head (record(id)), :round
  # (record(id, round, part)).
  def rp_call(kind, a, b = 0, c = 0)
    return if @rp_f
    px = ::Asterism[@rp, timeout: CALL_TIMEOUT]
    @rp_kind = kind
    @rp_f = if kind == :page then px.async.records(a)
            elsif kind == :head then px.async.record(a)
            else px.async.record(a, b, c)
            end
  rescue ::Asterism::Error => e
    @rp_f = nil
    @rp_note = e.message.to_s
    @dirty = true
  end

  def rp_poll
    # The game starts while this player sits at the table: back to it.
    rp_close while @rp && @tc.token && @seat && @view && @view["st"] != "wait"
    f = @rp_f
    return unless f && f.done?
    @rp_f = nil
    begin
      r = f.value
      if r.is_a?(Hash) && r["error"]
        @rp_note = r["error"].to_s
      elsif @rp_kind == :page
        rp_take_page(r)
      elsif @rp_kind == :head
        rp_take_head(r)
      else
        rp_take_part(r)
      end
    rescue ::Asterism::Error => e
      @rp_note = "#{t(:mj_host_away)} (#{e.class})"
    end
    @dirty = true
  end

  def rp_take_page(r)
    list = r.is_a?(Hash) && r["records"].is_a?(Array) ? r["records"] : []
    @rp_list += list
    if r["next"].is_a?(Integer) && @rp_list.size < 40
      rp_call(:page, r["next"])
    else
      @rp_note = @rp_list.empty? ? t(:mj_rp_none) : ""
    end
  end

  def rp_take_head(r)
    @rp_head = r
    @rp_state = :view
    @xl_items = nil
    rp_load(0, false)
  end

  # Loads round i (its first move, or its end when at_end).
  def rp_load(i, at_end)
    rs = @rp_head["rounds"]
    return unless rs.is_a?(Array) && i >= 0 && i < rs.size
    @rp_at_end = at_end
    @rp_parts = []
    @rp_note = t(:mj_rp_loading)
    rp_call(:round, @rp_head["id"], i, 0)
  end

  def rp_take_part(r)
    @rp_parts << r
    n = r["parts"].to_i
    return rp_call(:round, @rp_head["id"], r["round"], @rp_parts.size) if @rp_parts.size < n
    rp_take_round(@rp_parts)
    @rp_parts = nil
  end

  # The round's parts as the screen keeps it: tile codes, the moves as
  # [seat, kind (RP_KINDS), tile or tiles, from].
  def rp_take_round(parts)
    r = parts[0]
    moves = []
    parts.each do |pt|
      ms = pt["moves"].is_a?(Array) ? pt["moves"] : []
      i = 0
      while i < ms.size
        moves << rp_move(ms[i])
        i += 1
      end
    end
    hands = []
    hs = r["hands"].is_a?(Array) ? r["hands"] : []
    4.times { |s| hands << rp_codes(hs[s]) }
    @rp_data = { "n" => r["round"].to_i, "wind" => ["east", "south", "west", "north"].index(r["wind"].to_s) || 0,
                 "number" => r["number"].to_i, "honba" => r["honba"].to_i, "sticks" => r["riichi_sticks"].to_i,
                 "dealer" => r["dealer"].to_i, "scores" => r["scores"], "dora" => rp_codes(r["dora_indicators"]),
                 "hands" => hands, "moves" => moves, "result" => r["result"], "end" => r["end_scores"] }
    @rp_note = ""
    @rp_step = @rp_at_end ? rp_last : 0
    @shout = nil
  end

  def rp_move(m)
    k = RP_KINDS.index(m[1].to_s) || 0
    a = m[2]
    a = a.is_a?(Array) ? rp_codes(a) : rp_code(a)
    out = [m[0].to_i, k, a]
    out << rp_codes(m[3]) << m[4].to_i if k >= 3 && k <= 5
    out << m[3].to_i if k == 10
    out << true if (k == 1 || k == 2) && m[3] == true
    out
  end

  def rp_code(name)
    s = name.to_s
    return -1 if s.bytesize < 2
    n = s.getbyte(0) - 48
    suit = "mpsz".index(s[1])
    return -1 unless suit
    return 29 + n if suit == 3
    suit * 10 + (n == 0 ? 9 : n - 1)
  end

  def rp_codes(list)
    out = []
    return out unless list.is_a?(Array)
    i = 0
    while i < list.size
      out << rp_code(list[i])
      i += 1
    end
    out
  end

  # ------------------------------------------------------------ steps

  # The last step of the round: every move, then its result, then (the
  # last round) the end of the game.
  def rp_last
    d = @rp_data
    n = d["moves"].size + (d["result"] ? 1 : 0)
    n += 1 if d["n"] == @rp_head["rounds"].size - 1 && @rp_head["final"]
    n
  end

  def rp_go(step)
    d = @rp_data
    return unless d
    if step < 0
      rp_load(d["n"] - 1, true) if d["n"] > 0
      return
    end
    if step > rp_last
      rp_load(d["n"] + 1, false) if d["n"] + 1 < @rp_head["rounds"].size
      return
    end
    fwd = @rp_step.is_a?(Integer) && step == @rp_step + 1
    @rp_step = step
    @shout = nil
    m = step > 0 && step <= d["moves"].size ? d["moves"][step - 1] : nil
    # MJ11: a record steps by the keys, so only its discards click.
    snd_play(:discard_other) if fwd && m && (m[1] == 1 || m[1] == 2) && @audio
    if m && ((m[1] >= 2 && m[1] <= 7) || m[1] >= 9)
      ty = [0, 0, A_RIICHI, A_CHI, A_PON, A_MINKAN, A_ANKAN, A_KAKAN, 0, A_TSUMO, A_RON, A_KYUUSHU][m[1]]
      @shout = [ty, [m[0]], Machine.board_millis + SHOUT_MS]
    end
    @dirty = true
  end

  def rp_key(k)
    sc = k[0]
    ch = k[1]
    if sc == FmrbConst::KEY_ESC || ch == 27
      rp_close
    elsif @rp_state == :list && (ch == 115 || ch == 83)
      st_open
    elsif @rp_state == :list
      n = @rp_list.size
      return if n == 0
      if sc == FmrbConst::KEY_UP
        @rp_sel = (@rp_sel - 1) % n
      elsif sc == FmrbConst::KEY_DOWN
        @rp_sel = (@rp_sel + 1) % n
      elsif enter?(k)
        rp_call(:head, @rp_list[@rp_sel]["id"])
      end
      @dirty = true
    elsif @rp_data && @rp_f.nil?
      if sc == FmrbConst::KEY_RIGHT || enter?(k) || ch == 32
        rp_go(@rp_step + 1)
      elsif sc == FmrbConst::KEY_LEFT
        rp_go(@rp_step - 1)
      elsif sc == FmrbConst::KEY_DOWN
        rp_load(@rp_data["n"] + 1, false) if @rp_data["n"] + 1 < @rp_head["rounds"].size
      elsif sc == FmrbConst::KEY_UP
        @rp_step > 0 ? rp_go(0) : rp_load(@rp_data["n"] - 1, false)
      end
    end
  end

  # ------------------------------------------------------------ the view made from the record

  # The table at the step as a spectator's view (the host's short keys).
  def rp_build
    d = @rp_data
    counts = []
    s = 0
    while s < 4
      counts << rp_count(d["hands"][s])
      s += 1
    end
    rivers = [[], [], [], []]
    melds = [[], [], [], []]
    drawn = [-1, -1, -1, -1]
    dora = d["dora"].dup
    ri = 0
    sticks = d["sticks"]
    cur = d["dealer"]
    wall = 70
    ls = nil
    moves = d["moves"]
    n = @rp_step < moves.size ? @rp_step : moves.size
    k = 0
    while k < n
      m = moves[k]
      s = m[0]
      kind = m[1]
      if kind == 0
        rp_take_drawn(counts, drawn, s)
        counts[s][m[2]] += 1
        drawn[s] = m[2]
        cur = s
        wall -= 1
        ls = nil
      elsif kind == 1 || kind == 2
        rp_take_drawn(counts, drawn, s)
        counts[s][m[2]] -= 1
        rivers[s] << (m[2] | (kind == 2 ? 0x40 : 0))
        if kind == 2
          ri |= 1 << s
          sticks += 1
        end
        ls = [s, m[2]]
        cur = s
      elsif kind >= 3 && kind <= 5
        rp_take_drawn(counts, drawn, s)
        rp_uncount(counts[s], m[3])
        fr = m[4]
        rv = rivers[fr]
        rv[rv.size - 1] = rv[rv.size - 1] | 0x80 unless rv.empty?
        rel_from = (fr - s) % 4
        tl = m[3]
        # The called tile where it lies sideways (from the left first,
        # from across second, from the right last).
        at = rel_from == 3 ? 0 : (rel_from == 2 ? 1 : tl.size)
        tl = tl[0, at] + [m[2]] + tl[at, tl.size - at]
        melds[s] << [kind == 3 ? 1 : (kind == 4 ? 2 : 4), rel_from, tl]
        cur = s
        ls = nil
      elsif kind == 6
        rp_take_drawn(counts, drawn, s)
        rp_uncount(counts[s], m[2])
        melds[s] << [3, 0, m[2]]
        ls = nil
      elsif kind == 7
        rp_take_drawn(counts, drawn, s)
        counts[s][m[2]] -= 1
        b = m[2] == 9 || m[2] == 19 || m[2] == 29 ? m[2] - 5 : m[2]
        j = 0
        while j < melds[s].size
          me = melds[s][j]
          f = me[2][0]
          f = f - 5 if f == 9 || f == 19 || f == 29
          if me[0] == 2 && f == b
            me[0] = 5
            me[2] = me[2] + [m[2]]
          end
          j += 1
        end
        ls = nil
      elsif kind == 8
        dora << m[2]
      end
      k += 1
    end
    end_step = @rp_step > moves.size
    v = { "v" => (@rp_v += 1), "sv" => @rp_v, "t" => "", "st" => "play", "me" => -1, "a" => [], "aw" => 0,
          "nm" => @rp_head["names"], "sk" => [1, 1, 1, 1], "hu" => 15, "ow" => -1, "mb" => [],
          "sc" => d["scores"], "ri" => ri, "dora" => rp_bytes(dora),
          "r" => [d["wind"], d["number"], d["honba"], sticks, d["dealer"], wall, cur, 1],
          "kw" => [], "fu" => [], "hc" => [], "sh" => [], "sd" => drawn, "ls" => ls }
    s = 0
    while s < 4
      v["kw"] << rp_bytes(rivers[s])
      fu = []
      j = 0
      while j < melds[s].size
        me = melds[s][j]
        fu << me[0] << me[1] << me[2].size
        fu += me[2]
        j += 1
      end
      v["fu"] << rp_bytes(fu)
      left = counts[s].dup
      left[drawn[s]] -= 1 if drawn[s] >= 0
      hand = rp_sorted(left)
      v["sh"] << rp_bytes(hand)
      v["hc"] << hand.size + (drawn[s] >= 0 ? 1 : 0)
      s += 1
    end
    if end_step
      v["st"] = "result"
      v["sc"] = d["end"] if d["end"].is_a?(Array)
      v["res"] = rp_result(d) if d["result"]
      if @rp_step > moves.size + (d["result"] ? 1 : 0)
        v["st"] = "over"
        v["fin"] = @rp_head["final"]
        v["fr"] = @rp_head["reason"]
        # The end alone (the last round's result was the step before; three
        # winners and the ranks would not fit one box).
        v.delete("res")
      end
    end
    v
  end

  # Tile counts (38 kinds) of a list of codes, and back to codes in a
  # hand's order.
  def rp_count(list)
    c = Array.new(38, 0)
    i = 0
    while i < list.size
      c[list[i]] += 1 if list[i] >= 0
      i += 1
    end
    c
  end

  def rp_uncount(c, list)
    i = 0
    while i < list.size
      c[list[i]] -= 1 if list[i] >= 0
      i += 1
    end
  end

  def rp_sorted(c)
    out = []
    i = 0
    while i < RP_ORDER.size
      k = c[RP_ORDER[i]]
      while k > 0
        out << RP_ORDER[i]
        k -= 1
      end
      i += 1
    end
    out
  end

  # The drawn tile goes into the hand when anything else happens.
  def rp_take_drawn(counts, drawn, s)
    drawn[s] = -1
  end

  def rp_bytes(list)
    b = ("\x00" * list.size).b
    i = 0
    while i < list.size
      b.setbyte(i, list[i] & 0xFF)
      i += 1
    end
    b
  end

  # The record's result as the view's "res".
  def rp_result(d)
    r = d["result"]
    res = { "k" => r["kind"].to_s, "d" => r["changes"], "rd" => [d["wind"], d["number"], d["honba"]] }
    res["f"] = r["from"] unless r["from"].nil?
    res["tp"] = r["tenpai"] if r["tenpai"]
    res["ng"] = r["nagashi"] if r["nagashi"]
    res["rs"] = r["ron_seats"] if r["ron_seats"]
    if r["wins"].is_a?(Array)
      res["wn"] = []
      r["wins"].each do |w|
        sorted = rp_sorted(rp_count(rp_codes(w["hand"])))
        x = { "w" => w["seat"], "y" => w["yaku"], "pt" => w["points"], "h" => rp_bytes(sorted), "ag" => rp_code(w["tile"]) }
        x["yh"] = w["yaku_han"] if w["yaku_han"]
        x["pa"] = w["pao"] if w["pao"]
        res["wn"] << x
      end
    end
    res
  end

  # "12/80 å— name æ‰“5m": the step and what the move was.
  def rp_line
    return @rp_note.to_s unless @rp_data
    return @rp_note.to_s unless @rp_note.to_s.empty?
    d = @rp_data
    moves = d["moves"]
    s = "#{@rp_step}/#{moves.size}"
    return "#{s} #{t(:mj_rp_deal)}" if @rp_step == 0
    return "#{s} #{t(:mj_over)}" if @rp_step > moves.size + (d["result"] ? 1 : 0)
    return "#{s} #{d['result'] ? t(:mj_rp_result) : t(:mj_draw)}" if @rp_step > moves.size
    m = moves[@rp_step - 1]
    return "#{s} #{t(:mj_dora)} #{tile_text(m[2])}" if m[1] == 8
    who = "#{wind_of(m[0])} #{fit(seat_name(m[0]), u(80))}"
    what = case m[1]
           when 0 then "ãƒ„ãƒ¢ #{tile_text(m[2])}"
           when 1 then "æ‰“ #{tile_text(m[2])}#{m[3] ? ' (ãƒ„ãƒ¢åˆ‡ã‚Š)' : ''}"
           when 2 then "#{t(:mj_riichi)} æ‰“ #{tile_text(m[2])}"
           when 3 then "#{t(:mj_chi)} #{tile_text(m[2])}"
           when 4 then "#{t(:mj_pon)} #{tile_text(m[2])}"
           when 5, 6, 7 then "#{t(:mj_kan)}"
           when 9 then "#{t(:mj_tsumo)} #{tile_text(m[2])}"
           when 10 then "#{t(:mj_ron)} #{tile_text(m[2])}"
           else t(:mj_kyuushu)
           end
    "#{s} #{who} #{what}"
  end

  # ------------------------------------------------------------ drawing

  def rp_draw
    t0 = Machine.board_millis
    if @rp_state == :view && @rp_data
      rp_draw_view
    else
      @xl_items = nil
      @hits.clear
      clear_user_area(C_FELT)
      fnt(12, @k)
      rp_draw_list
    end
    @gfx.present
    perf_note(:draw, Machine.board_millis - t0)
  end

  # The record at its step, drawn as the spectators' table on a view made
  # for it (the live view and seat are put back after).
  def rp_draw_view
    live = @view
    seat = @seat
    note = @note
    leave = @str[:mj_leave]
    back = @str[:mj_back_lobby]
    @view = rp_build
    @seat = nil
    @str[:mj_leave] = t(:mj_rp_back)
    @str[:mj_back_lobby] = ""
    begin
      if @xl
        xl_draw
      else
        @xl_items = nil
        @hits.clear
        clear_user_area(C_FELT)
        fnt(12, @k)
        if @big
          @note = rp_line
          draw_watch
        else
          draw_info
          draw_seats
          draw_rivers
          draw_melds
          text(@x0 + 2, @y0 + @h - 14, fit(rp_line, @w - 4), C_TURN)
        end
        draw_shout
        draw_result if (@view["res"] || @view["fin"]) && !@shout
      end
    ensure
      @view = live
      @seat = seat
      @note = note
      @str[:mj_leave] = leave
      @str[:mj_back_lobby] = back
    end
  end

  # The list of the recent games.
  def rp_draw_list
    x = @x0 + u(8)
    y = @y0 + u(8)
    parts = @rp.to_s.split("/")
    text(x, y, fit("#{t(:mj_rp_title)}  #{parts[0]}/#{parts[2]}", @w - u(200)))
    bl = t(:mj_rp_back)
    bw = tw(bl) + u(12)
    button(B_RP_BACK, [], @x0 + @w - bw - u(8), y - u(3), bl)
    sl = t(:mj_rp_stats)
    button(B_RP_STATS, [], @x0 + @w - bw - tw(sl) - u(26), y - u(3), sl)
    text(x, y + u(18), fit(t(:mj_rp_keys), @w - u(16)), C_DIM)
    y += u(40)
    unless @rp_note.to_s.empty?
      text(x, y, fit(@rp_note.to_s, @w - u(16)), C_TURN)
      y += u(18)
    end
    rows = (@y0 + @h - y - u(4)) / u(18)
    rows = 1 if rows < 1
    n = @rp_list.size
    @rp_top = @rp_sel - rows + 1 if @rp_sel >= @rp_top + rows
    @rp_top = @rp_sel if @rp_sel < @rp_top
    seg = (@w - u(16) - u(@big ? 112 : 70)) / 4
    i = @rp_top
    while i < n && i < @rp_top + rows
      e = @rp_list[i]
      chosen = i == @rp_sel
      @gfx.fill_rect(x - u(2), y - u(2), @w - u(12), u(17), C_SEL) if chosen
      @hits.add(B_RP_ROW, x - u(2), y - u(2), @w - u(12), u(17), [i])
      at = e["at"].to_s
      at = at.byteslice(5, at.bytesize - 5).to_s if at.bytesize > 5
      head = @big ? "#{at} #{e['game'] == 'tonpuu' ? 'æ±é¢¨' : 'åŠè˜'}" : at
      # A watch game (GS15, asterism-games 0.20.0 "watch"): marked è¦³ after
      # the length (640x360 and up), its time in cyan on the small screen.
      head = "#{head}è¦³" if @big && e["watch"]
      text(x, y, head, chosen ? C_TURN : (e["watch"] ? C_KEEP : C_TEXT))
      cx = x + u(@big ? 112 : 70)
      nm = e["names"].is_a?(Array) ? e["names"] : []
      rk = e["ranks"].is_a?(Array) ? e["ranks"] : []
      sc = e["scores"].is_a?(Array) ? e["scores"] : []
      r = 1
      while r <= 4
        s = rk.index(r)
        if s
          pts = sc[s].to_s
          name = fit(nm[s].to_s, seg - tw("#{r} ") - tw(pts) - u(20))
          text(cx, y, "#{r} #{name}", nm[s].to_s == @name ? C_TURN : C_TEXT)
          text(cx + seg - tw(pts) - u(6), y, pts, C_DIM)
        end
        cx += seg
        r += 1
      end
      y += u(18)
      i += 1
    end
  end

  # ------------------------------------------------------------ the base methods, with a record open

  def draw_screen
    @rp ? rp_draw : rp_base_draw_screen
  end

  def run_key(k)
    @rp ? rp_key(k) : rp_base_run_key(k)
  end

  def run_move(m)
    rp_base_run_move(m) unless @rp
  end

  def run_click(c)
    return rp_base_run_click(c) unless @rp
    b = @hits.at(c[0], c[1])
    return run_button(b[0], b[5]) if b
    rp_go(@rp_step + 1) if @rp_state == :view && @rp_data && @rp_f.nil?
  end

  def run_button(type, tiles)
    return rp_base_run_button(type, tiles) unless @rp
    if type == B_RP_ROW
      @rp_sel = tiles[0]
      rp_call(:head, @rp_list[@rp_sel]["id"]) if @rp_list[@rp_sel]
    elsif type == B_RP_STATS
      st_open
    elsif type == B_RP_BACK || type == B_LEAVE
      rp_close
    end
    @dirty = true
  end

  # The players' stats (MJ7): a file of its own, read only when opened.
  def st_open
    require "#{APP_DIR}/mahjong_stats"
    st_start
  end

  def status_line
    @rp ? "#{rp_line}  #{t(:mj_rp_view_keys)}" : rp_base_status_line
  end

  def on_update
    rp_poll if @rp
    rp_base_on_update
  end

  def rp_strings
    @str[:mj_rp_title] = "ç›´è¿‘ã®çµæžœ"
    @str[:mj_rp_back] = "é–‰ã˜ã‚‹[Esc]"
    @str[:mj_rp_loading] = "èª­ã¿è¾¼ã¿ä¸­"
    @str[:mj_rp_none] = "ã¾ã çµ‚å±€ã—ãŸå¯¾å±€ãŒç„¡ã„"
    @str[:mj_rp_deal] = "é…ç‰Œ"
    @str[:mj_rp_result] = "çµæžœ"
    @str[:mj_rp_keys] = "â†‘â†“ é¸ã¶  Enter ç‰Œè­œ  S æˆç¸¾  ç‰Œè­œ: â†’ æ¬¡ â† å‰ â†“ æ¬¡ã®å±€ â†‘ å±€ã®é ­"
    @str[:mj_rp_stats] = "æˆç¸¾[S]"
    @str[:mj_rp_view_keys] = "(â†’ â† â†“ â†‘ Esc)"
  end
end
# The table's sound (MJ11, doc/ruby_asterism/report/mj11.md): effects,
# short jingles in place of the spoken calls, the end-of-game fanfares and
# a BGM hook. Read by on_create (after the class body, since it wraps some
# of its methods); a Retro screen never reads it.
#
# - Effects and jingles are note_on / note_off on the APU's SUB instance
#   (two pulses, the triangle, the noise). A sound is started only when
#   something happens (a view that differs, a step of the result's count);
#   its later notes are deadlines in wall-clock ms that snd_tick runs at the
#   end of on_update, after the drawing (so a long repaint does not stretch
#   the first note). Nothing pending: snd_tick returns at once.
# - Overlap: a sound claims the channels it uses unless a sound of a higher
#   priority still holds one (that voice is then left out). The newest of
#   equal priority wins; its generation number keeps the older sound's
#   pending notes off the channel.
# - The BGM hook: an NSF (FmrbAudio#play) or an FMSQ (load_fmsq_file +
#   play_slot on MAIN) per scene, :lobby (the list and the lobby), :play
#   (the game and its results), :tense (optional: a riichi on the table or
#   TENSE_LEFT tiles left; without a tune it is :play). The end of a game
#   is silent (the fanfare plays alone). No tune: no BGM. FmrbMidi's
#   MmlPlayer is not used: it plays on SUB, with the effects.
# - The declarations' voices (C4, doc/commentary/report/c4.md): a WAV per
#   declaration, played with FmrbAudio#play_wav in place of its jingle (the
#   jingle plays when no voice starts: the switch off, no file, a higher
#   voice still on, or Retro's play_wav false). Each of VOICE_NAMES is looked
#   for in VOICE_DIRS in order: the user's /home/voice/mahjong/ (a Tab5
#   takes it without a reflash), the user's own voice the device image
#   carries from flash_local/ (tools/mahjong_voice.rb, VOICEVOX), then the
#   bundled Open JTalk voice (tools/mahjong_voice_default.rb). The credit of
#   each directory used is shown in the lobby. Declarations close together
#   (a pon and a ron) keep the higher of VOICE_PRI for VOICE_HOLD_MS.
# - Tunes (and a voice of one's own per jingle) come from BGM below, and
#   /home/mahjong.toml over them:
#     bgm_lobby = "/home/music/lobby.fmsq"   bgm_play_track = 2 (an NSF's track)
#     voice_riichi = "/home/voice/riichi.wav"   (voice_kyuushu, voice_ryuukyoku too)
# - The player's switches are in /home/mahjong.toml (save_assist writes
#   them): "bgm" is the BGM's level (MJ12) 0 off, 1 low (the default),
#   2 mid, 3 high -- an older file's true reads as low and false as off --
#   "se" the effects (the jingles are effects) on or off, on by default,
#   and "voice" the declarations' voices on or off, on by default.
#   The level is FmrbAudio#main_volume (the MAIN instance only, so the
#   effects on SUB keep theirs); the kernel puts it back to 100 when the
#   app ends.

class MahjongApp < FmrbApp
  B_BGM = 130
  B_SE = 131
  B_VOICE = 132
  SND_CH = 4              # pulse1, pulse2, triangle, noise (FmrbAudio::CH_*)
  TENSE_LEFT = 10         # :tense from this many tiles left (or a riichi)
  BGM_SLOT = { lobby: 12, play: 13, tense: 14 }.freeze # FMSQ slots (machine-wide)
  # The BGM's levels (MJ12): off, low, mid, high as MAIN volume percents,
  # and their names on the button. Tentative values (2026-10-19).
  BGM_LEVELS = [0, 30, 55, 100].freeze
  BGM_NAMES = ["åˆ‡", "å°", "ä¸­", "å¤§"].freeze
  BGM_DEFAULT = 1
  # scene => [path, NSF track] or nil (no tune: silent). The defaults are
  # shiru8bit's tunes shipped next to lost_in_hyperspace.nsf (CC BY 3.0,
  # ASSETS.md and that directory's CREDITS.md); /home/mahjong.toml's
  # bgm_lobby / bgm_play / bgm_tense lines replace them (chosen 2026-10-19).
  BGM = { lobby: ["/usr/share/sounds/nsf/after_the_rain.nsf", 0],
          play: ["/usr/share/sounds/nsf/spring_thing.nsf", 0],
          tense: ["/usr/share/sounds/nsf/encounter.nsf", 0] }.freeze
  # The declarations with a voice (NAME.wav), and where they are looked for:
  # [directory, its credit] (nil: the first line of its CREDITS.txt when that
  # names VOICEVOX, else VOICE_CREDIT -- the voice users make, chosen
  # 2026-10-21).
  VOICE_NAMES = [:riichi, :pon, :chi, :kan, :tsumo, :ron].freeze
  VOICE_DIRS = [["/home/voice/mahjong", nil], ["/usr/share/sounds/voice/mahjong", nil],
                ["/usr/share/sounds/voice/mahjong/default", "Open JTalk (Mei, CC BY 3.0)"]].freeze
  VOICE_CREDIT = "VOICEVOX:ãšã‚“ã ã‚‚ã‚“"
  VOICE_PRI = { riichi: 1, kyuushu: 1, chi: 2, pon: 3, kan: 4, tsumo: 5, ron: 6, ryuukyoku: 6 }.freeze
  VOICE_HOLD_MS = 1000
  SND_KEYS = ["bgm_lobby", "bgm_play", "bgm_tense", "voice_riichi", "voice_pon", "voice_chi", "voice_kan",
              "voice_ron", "voice_tsumo", "voice_kyuushu", "voice_ryuukyoku"].freeze

  # The effects' gain (C4b, 2026-10-22: the effects felt a little loud next
  # to the voices): every note_on volume of SFX is scaled by
  # SE_GAIN_NUM / SE_GAIN_DEN, rounded, with 0 kept at 0 and anything above
  # 0 kept at 1 or more (no note goes silent). 3/4 is about -2.5 dB (the
  # APU's 0-15 is linear in amplitude). The BGM (MAIN) is not touched.
  SE_GAIN_NUM = 3
  SE_GAIN_DEN = 4

  # name => [priority, voice, ...]; a voice is [channel, duty, then per note
  # freq (Hz; the noise: its period 0-15), ms, volume 0-15]; freq -1 rests.
  # The triangle has no volume (0). Priorities: 1 the frequent clicks, 2 the
  # turn and the count, 3 the jingles, 4 the fanfares.
  SFX = {
    discard: [1, [3, 0, 3, 20, 12, 3, 25, 6, 5, 30, 3]],
    discard_other: [1, [3, 0, 5, 20, 8, 6, 30, 4]],
    draw: [1, [1, 1, 1319, 30, 5, 1760, 40, 4]],
    turn: [2, [0, 2, 1047, 70, 8, 1568, 120, 7]],
    round: [3, [0, 2, 523, 90, 10, 659, 90, 10, 784, 90, 10, 1047, 240, 9], [2, 0, 131, 270, 0, 262, 240, 0]],
    yaku: [2, [0, 1, 1568, 40, 9, 2093, 70, 7]],
    points: [3, [0, 2, 784, 60, 11, 1047, 60, 11, 1319, 60, 11, 1568, 260, 10], [1, 1, 523, 180, 7, 784, 260, 6],
             [2, 0, 131, 180, 0, 196, 260, 0]],
    riichi: [3, [0, 2, 988, 70, 12, 1319, 70, 12, 1976, 200, 11], [1, 1, 494, 140, 7, 659, 200, 7]],
    pon: [3, [0, 1, 1568, 60, 12, -1, 30, 0, 1568, 90, 11], [3, 0, 4, 30, 8]],
    chi: [3, [0, 1, 1319, 60, 11, 1047, 100, 10]],
    kan: [3, [0, 2, 784, 80, 12, 1047, 80, 12, 1568, 180, 11], [2, 0, 98, 340, 0]],
    ron: [3, [3, 0, 2, 60, 12, 4, 60, 6], [0, 2, 1047, 80, 13, 1319, 80, 13, 1568, 80, 13, 2093, 320, 12],
          [1, 2, 523, 240, 9, 784, 320, 8], [2, 0, 131, 240, 0, 262, 320, 0]],
    tsumo: [3, [0, 2, 1568, 70, 12, 2093, 70, 12, 1568, 70, 12, 2637, 280, 11], [1, 1, 784, 210, 8, 1047, 280, 7],
            [2, 0, 196, 210, 0, 262, 280, 0]],
    kyuushu: [3, [0, 2, 1175, 100, 10, 988, 100, 10, 784, 240, 9], [2, 0, 98, 440, 0]],
    ryuukyoku: [3, [0, 2, 784, 150, 9, 698, 150, 9, 659, 150, 9, 523, 360, 8], [2, 0, 131, 450, 0, 98, 360, 0]],
    fanfare1: [4, [0, 2, 523, 110, 12, 659, 110, 12, 784, 110, 12, 1047, 220, 12, 784, 110, 11, 1047, 500, 12],
               [1, 1, 330, 110, 8, 392, 110, 8, 523, 110, 8, 659, 220, 8, 523, 110, 8, 659, 500, 8],
               [2, 0, 131, 330, 0, 175, 220, 0, 196, 110, 0, 131, 500, 0]],
    fanfare2: [4, [0, 2, 784, 100, 11, 880, 100, 11, 988, 100, 11, 1047, 450, 11], [1, 1, 523, 300, 7, 659, 450, 7],
               [2, 0, 196, 300, 0, 131, 450, 0]],
    fanfare3: [4, [0, 2, 659, 140, 10, 587, 140, 10, 659, 140, 10, 784, 420, 10], [2, 0, 131, 420, 0, 196, 420, 0]],
    fanfare4: [4, [0, 2, 659, 180, 9, 523, 180, 9, 440, 180, 9, 415, 500, 8], [2, 0, 110, 540, 0, 104, 500, 0]]
  }.freeze

  # ------------------------------------------------------------ start, stop, the switches

  def snd_start
    @snd_req = []
    @snd_q = []
    @snd_gen = [0, 0, 0, 0]
    @snd_busy = [0, 0, 0, 0]
    @snd_pri = [0, 0, 0, 0]
    @snd_scene = :lobby
    @snd_tune = nil         # the tune playing now ([path, track]) or nil
    @snd_loaded = {}        # FMSQ slot => the path loaded into it
    @snd_conf = {}
    @snd_bgm = BGM_DEFAULT
    @snd_se = true
    @snd_vo_on = true
    @snd_vo = [0, 0]        # the voice playing: [its VOICE_PRI, until (ms)]
    snd_load_conf
    found = snd_find_voices(VOICE_DIRS)
    @snd_voices = found[0]
    @snd_credit = found[1]
    VOICE_PRI.each do |n, _|
      w = @snd_conf["voice_#{n}"]
      @snd_voices[n] = w if w && !w.empty?
    end
    @audio = nil
    @audio = FmrbAudio.new(self)
    snd_bgm_volume
    snd_bgm_to(:lobby)
  rescue => e
    Log.info("mahjong: no sound (#{e.message})")
    @audio = nil
  end

  # The sound's settings out of /home/mahjong.toml (app_settings;
  # load_assist reads the rest).
  def snd_load_conf
    conf = app_settings
    v = conf["bgm"]
    @snd_bgm = snd_bgm_level(v) unless v.nil?
    v = conf["se"]
    @snd_se = v != false && v != 0 unless v.nil?
    v = conf["voice"]
    @snd_vo_on = v != false && v != 0 unless v.nil?
    conf.each do |k, x|
      if x.is_a?(String)
        @snd_conf[k] = x if SND_KEYS.index(k)
      elsif x.is_a?(Integer) && k.size > 6 && k[k.size - 6, 6] == "_track"
        @snd_conf[k] = x
      end
    end
  end

  # What save_assist writes for the sound: the switches and the tunes and
  # voices the player named there.
  def snd_settings(v)
    v["bgm"] = @snd_bgm
    v["se"] = @snd_se
    v["voice"] = @snd_vo_on != false
    @snd_conf.each { |k, x| v[k] = x }
    v
  end

  # A saved "bgm" as a level: 0-3, or an older file's true / false.
  def snd_bgm_level(v)
    return 0 if v == false
    return BGM_DEFAULT if v == true
    v.is_a?(Integer) && v >= 0 && v < BGM_LEVELS.size ? v : BGM_DEFAULT
  end

  # The button and B: off -> low -> mid -> high -> off.
  def snd_toggle_bgm
    @snd_bgm = (@snd_bgm + 1) % BGM_LEVELS.size
    if @snd_bgm > 0
      snd_bgm_volume
      snd_bgm_to(@snd_scene)
    else
      snd_bgm_stop
    end
    save_assist
    @dirty = true
    Log.info("mahjong: bgm #{BGM_LEVELS[@snd_bgm]}%")
  end

  # The level as the MAIN volume (off leaves it: nothing plays on MAIN).
  def snd_bgm_volume
    return unless @audio && @snd_bgm > 0
    @audio.main_volume = BGM_LEVELS[@snd_bgm]
  rescue => e
    Log.info("mahjong: bgm volume: #{e.message}")
  end

  def snd_toggle_se
    @snd_se = !@snd_se
    snd_quiet unless @snd_se
    save_assist
    @dirty = true
    Log.info("mahjong: se #{@snd_se}")
  end

  def snd_toggle_voice
    @snd_vo_on = !@snd_vo_on
    unless @snd_vo_on
      @audio.stop_wav if @audio
      @snd_vo = [0, 0]
    end
    save_assist
    @dirty = true
    Log.info("mahjong: voice #{@snd_vo_on}")
  rescue => e
    Log.info("mahjong: voice: #{e.message}")
  end

  # Every effect stops (the pending notes, the four channels, a WAV).
  def snd_quiet
    return unless @audio
    @snd_req = []
    @snd_q = []
    ch = 0
    while ch < SND_CH
      @snd_gen[ch] += 1
      @snd_busy[ch] = 0
      @audio.note_off(ch)
      ch += 1
    end
    @audio.stop_wav
  rescue => e
    Log.info("mahjong: sound stop: #{e.message}")
  end

  # The app closes: nothing may go on sounding after it.
  def snd_stop
    return unless @audio
    snd_bgm_stop
    snd_quiet
    @audio = nil
  end

  # ------------------------------------------------------------ the buttons (the list and the lobby)

  # The switches' labels; the voice's only while there is one.
  def snd_labels
    l = ["BGM #{BGM_NAMES[@snd_bgm || BGM_DEFAULT]}[B]", "åŠ¹æžœéŸ³ #{@snd_se == false ? 'åˆ‡' : 'å…¥'}[E]"]
    l << "å£° #{@snd_vo_on == false ? 'åˆ‡' : 'å…¥'}[V]" if @snd_voices && !@snd_voices.empty?
    l
  end

  # The switches from x; returns the x after them.
  def snd_buttons(x, y)
    l = snd_labels
    x += button(B_BGM, [], x, y, l[0]) + u(6)
    x += button(B_SE, [], x, y, l[1]) + u(6)
    x += button(B_VOICE, [], x, y, l[2]) + u(6) if l.size > 2
    x
  end

  def snd_buttons_w
    w = 0
    snd_labels.each { |s| w += tw(s) + u(18) }
    w
  end

  # The voices' credit (the VOICEVOX terms, the voice's licence) right of
  # the lobby's switches at (x, y), while a voice file is used.
  def snd_credit(x, y)
    return unless @snd_credit && @snd_vo_on != false
    text(x + u(2), y + u(4), fit("å£°: #{@snd_credit}", @x0 + @w - x - u(10)), C_DIM)
  end

  # B, E or V (with voices) in the list and the lobby (not while a name is typed).
  def snd_key(k)
    return false if @name_edit
    ch = k[1]
    ch += 32 if ch >= 65 && ch <= 90
    if ch == 98
      snd_toggle_bgm
    elsif ch == 101
      snd_toggle_se
    elsif ch == 118 && @snd_voices && !@snd_voices.empty?
      snd_toggle_voice
    else
      return false
    end
    true
  end

  # ------------------------------------------------------------ effects

  # Starts a sound (at the next snd_tick, plus delay ms).
  def snd_play(name, delay = 0)
    return unless @audio && @snd_se
    @snd_req << [name, delay]
    Log.info("mahjong: sfx #{name}")
  rescue => e
    Log.info("mahjong: sfx #{name}: #{e.message}")
  end

  # From on_update, after the drawing: starts what was asked for, plays the
  # notes that are due; returns the wait until the next (at most `wait`).
  def snd_tick(wait)
    return wait if @audio.nil? || (@snd_req.empty? && @snd_q.empty?)
    now = Machine.board_millis
    snd_begin(@snd_req.shift, now) until @snd_req.empty?
    nxt = nil
    i = 0
    while i < @snd_q.size
      e = @snd_q[i]
      if e[0] <= now
        if @snd_gen[e[1]] == e[5]
          e[2] >= 0 ? @audio.note_on(e[1], e[2], snd_se_vol(e[3]), e[4], 0) : @audio.note_off(e[1])
        end
        @snd_q.delete_at(i)
      else
        nxt = e[0] if nxt.nil? || e[0] < nxt
        i += 1
      end
    end
    return wait if nxt.nil?
    d = nxt - now
    d = 5 if d < 5
    d < wait ? d : wait
  end

  # A note's volume (0-15) with the effects' gain: 0 stays 0, above 0 is
  # at least 1.
  def snd_se_vol(v)
    return 0 if v <= 0
    g = (v * SE_GAIN_NUM * 2 + SE_GAIN_DEN) / (SE_GAIN_DEN * 2)
    g < 1 ? 1 : g
  end

  # Lays a sound's notes out as deadlines from now + its delay.
  def snd_begin(req, now)
    d = SFX[req[0]]
    return unless d
    pri = d[0]
    k = 1
    while k < d.size
      v = d[k]
      ch = v[0]
      if pri >= @snd_pri[ch] || now >= @snd_busy[ch]
        g = @snd_gen[ch] + 1
        @snd_gen[ch] = g
        t = now + req[1]
        j = 2
        while j + 2 < v.size
          @snd_q << [t, ch, v[j], v[j + 2], v[1], g]
          t += v[j + 1]
          j += 3
        end
        @snd_q << [t, ch, -1, 0, 0, g]
        @snd_busy[ch] = t
        @snd_pri[ch] = pri
      end
      k += 1
    end
  end

  # ------------------------------------------------------------ the events

  def snd_river_n(v)
    kw = v["kw"]
    return 0 unless kw.is_a?(Array)
    n = 0
    i = 0
    while i < kw.size
      n += kw[i].to_s.bytesize
      i += 1
    end
    n
  end

  # This seat's move (a draw or a discard to make), not during the round's name.
  def snd_my_turn?(v)
    r = v["r"]
    return false unless @seat && v["st"] == "play" && v["in"].nil? && r.is_a?(Array) && r.size > 7
    r[6] == @seat && r[7].to_i <= 1
  end

  # What a new view says happened (old: the view before; shout and intro:
  # @shout and @intro_until before take_view).
  def snd_view(v, old, shout, intro)
    return if @rp || @audio.nil?
    snd_scene_of(v)
    return if old.nil?
    st = v["st"]
    snd_play(:round) if @intro_until && intro.nil?
    if @shout && !@shout.equal?(shout)
      j = snd_jingle(@shout[0])
      snd_play(j) unless snd_voice(j)
    end
    if st == "play" && old["st"] == "play"
      if snd_river_n(v) > snd_river_n(old)
        ls = v["ls"]
        snd_play(@seat && ls.is_a?(Array) && ls[0] == @seat ? :discard : :discard_other)
      end
      d = v["dt"]
      r = v["r"]
      orr = old["r"]
      if @seat && v["in"].nil? && d.is_a?(Integer) && d >= 0 && r.is_a?(Array) && orr.is_a?(Array)
        od = old["dt"]
        snd_play(:draw) if !od.is_a?(Integer) || od < 0 || r[5] != orr[5]
      end
    end
    snd_play(:turn, 70) if snd_my_turn?(v) && !snd_my_turn?(old)
    if st == "result" && old["st"] != "result"
      res = v["res"]
      k = res.is_a?(Hash) ? res["k"].to_s : ""
      snd_play(:ryuukyoku) if k == "ryuukyoku" || k == "suufon_renda" || k == "suukaikan" || k == "suucha_riichi"
    end
    snd_fanfare(v) if st == "over" && old["st"] != "over"
  end

  def snd_jingle(type)
    return :ron if type == A_RON
    return :ryuukyoku if type == 13
    return :tsumo if type == A_TSUMO
    return :riichi if type == A_RIICHI
    return :kyuushu if type == A_KYUUSHU
    return :pon if type == A_PON
    type == A_CHI ? :chi : :kan
  end

  # ------------------------------------------------------------ the voices (C4)

  # [{name => path}, the credits joined or nil]: each of VOICE_NAMES from
  # the first of dirs that has it.
  def snd_find_voices(dirs)
    found = {}
    used = []
    VOICE_NAMES.each do |n|
      i = 0
      while i < dirs.size
        p = "#{dirs[i][0]}/#{n}.wav"
        if File.exist?(p)
          found[n] = p
          used << i unless used.index(i)
          break
        end
        i += 1
      end
    end
    credits = []
    used.sort.each do |i|
      c = dirs[i][1] || snd_credit_file(dirs[i][0]) || VOICE_CREDIT
      credits << c unless credits.index(c)
    end
    [found, credits.empty? ? nil : credits.join(" / ")]
  end

  # The first line of dir/CREDITS.txt when it is a VOICEVOX credit
  # (tools/mahjong_voice.rb writes "VOICEVOX:<character>").
  def snd_credit_file(dir)
    l = nil
    File.open("#{dir}/CREDITS.txt", "r") { |f| l = f.read.to_s.split("\n")[0].to_s.strip }
    l && l.size > 9 && l[0, 9] == "VOICEVOX:" ? l : nil
  rescue
    nil
  end

  # Whether a voice of priority pri may start now over the one in cur
  # ([priority, until]): a higher or equal one replaces it, a lower one
  # waits until it is over.
  def snd_voice_ok?(pri, cur, now)
    now >= cur[1] || pri >= cur[0]
  end

  # The declaration's voice, if there is one and the switch is on; true
  # when it started (the jingle is then left out).
  def snd_voice(name)
    return false unless @audio && @snd_vo_on && @snd_voices
    path = @snd_voices[name]
    return false unless path
    now = Machine.board_millis
    pri = VOICE_PRI[name] || 1
    return false unless snd_voice_ok?(pri, @snd_vo, now)
    ok = @audio.play_wav(path)
    Log.info("mahjong: voice #{name} #{path} #{ok}")
    return false unless ok
    @snd_vo = [pri, now + VOICE_HOLD_MS]
    true
  rescue => e
    Log.info("mahjong: voice #{name}: #{e.message}")
    false
  end

  # The fanfare of this seat's rank (a spectator: the winner's); after a
  # win's shout.
  def snd_fanfare(v)
    rank = 1
    fin = v["fin"]
    if @seat && fin.is_a?(Array)
      fin.each { |f| rank = f[1].to_i if f.is_a?(Array) && f[0] == @seat }
    end
    rank = 1 if rank < 1 || rank > 4
    wait = @shout ? @shout[2] - Machine.board_millis : 0
    snd_play([:fanfare1, :fanfare2, :fanfare3, :fanfare4][rank - 1], wait > 0 ? wait : 0)
  end

  # A step of the result's count (MJ9): a yaku line, or a winner's points.
  def snd_count(before)
    sig = @rv_sig
    return if sig.nil? || sig[0] < 1 || (before && before[0] == sig[0])
    wins = @view["res"]["wn"]
    return unless wins.is_a?(Array) && wins.size > 0
    n = 0
    i = 0
    while i < wins.size
      n += rv_steps(wins[i])
      return snd_play(:points) if n == sig[0]
      i += 1
    end
    snd_play(:yaku)
  end

  # ------------------------------------------------------------ the BGM

  def snd_scene_of(v)
    st = v["st"]
    s = if st == "wait" then :lobby
        elsif st == "over" then :none
        else
          r = v["r"]
          (v["ri"].is_a?(Integer) && v["ri"] != 0) || (st == "play" && r.is_a?(Array) && r.size > 5 && r[5].to_i <= TENSE_LEFT) ? :tense : :play
        end
    snd_bgm_to(s) if s != @snd_scene
  end

  # The scene's tune: [path, track] or nil.
  def snd_tune_of(scene)
    return nil if scene == :none
    p = @snd_conf["bgm_#{scene}"]
    tr = @snd_conf["bgm_#{scene}_track"]
    return [p, tr.is_a?(Integer) ? tr : 0] if p && !p.empty?
    BGM[scene]
  end

  def snd_bgm_to(scene)
    @snd_scene = scene
    return unless @audio && @snd_bgm > 0
    key = scene == :tense && snd_tune_of(:tense).nil? ? :play : scene
    tune = snd_tune_of(key)
    return if tune == @snd_tune
    return snd_bgm_stop if tune.nil?
    path = tune[0]
    dot = path.rindex(".")
    ext = dot ? path[dot + 1, path.size].to_s.downcase : ""
    cache = "#{CACHE_DIR}/bgm_#{key}.#{ext}"
    @gfx.sync_file(path, dest: cache)
    if ext == "nsf"
      @audio.play(cache, track: tune[1])
    else
      slot = BGM_SLOT[key]
      unless @snd_loaded[slot] == path
        @audio.load_fmsq_file(slot, cache)
        @snd_loaded[slot] = path
      end
      @audio.play_slot(slot, instance: FmrbAudio::MAIN)
    end
    @snd_tune = tune
    Log.info("mahjong: bgm #{key} #{path}")
  rescue => e
    Log.info("mahjong: bgm #{scene}: #{e.message}")
  end

  def snd_bgm_stop
    return unless @audio && @snd_tune
    @snd_tune = nil
    @audio.stop
  rescue => e
    Log.info("mahjong: bgm stop: #{e.message}")
  end

  # ------------------------------------------------------------ the base methods, with sound

  alias snd_base_take_view take_view
  alias snd_base_round_tick round_tick
  alias snd_base_leave_table leave_table
  alias snd_base_on_update on_update
  alias snd_base_lobby_key lobby_key
  alias snd_base_list_key list_key
  alias snd_base_run_button run_button
  alias snd_base_stop stop
  alias snd_base_on_destroy on_destroy

  def take_view(v)
    old = @view
    shout = @shout
    intro = @intro_until
    snd_base_take_view(v)
    snd_view(v, old, shout, intro)
  end

  def round_tick(now)
    before = @rv_sig
    snd_base_round_tick(now)
    snd_count(before) if @audio && !@rv_sig.equal?(before)
  end

  def leave_table
    snd_base_leave_table
    snd_bgm_to(:lobby) if @audio
  end

  def on_update
    snd_tick(snd_base_on_update)
  end

  def lobby_key(k)
    snd_base_lobby_key(k) unless snd_key(k)
  end

  def list_key(k)
    snd_base_list_key(k) unless snd_key(k)
  end

  def run_button(type, tiles)
    if type == B_BGM
      snd_toggle_bgm
    elsif type == B_SE
      snd_toggle_se
    elsif type == B_VOICE
      snd_toggle_voice
    else
      snd_base_run_button(type, tiles)
    end
  end

  # Every intended end (the close button, Ctrl+Q, the kernel's stop) comes
  # here while the app can still send; on_destroy is the last chance.
  def stop
    snd_stop
    snd_base_stop
  end

  def on_destroy
    snd_stop
    snd_base_on_destroy
  end
end
# Mahjong table: the players' stats (MJ7, doc/ruby_asterism/report/mj7.md).
# Part of MahjongApp, opened from the recent games (mahjong_replay.rb, S or
# the button) and read only then (st_open requires this file).
#
# The game host counts every game kept in its records (asterism-games
# README "Stats"): stats(days, game, scope, from) gives a row per person
# (by the name at the table) and per kind (CPU, Claude, Jev): games, ranks,
# rounds, wins, deal-ins, riichi, the average score and the rank points.
# The screen asks for every page, then draws one table: the averages and
# rates are worked out here from the counts (integers only).
#
# Keys: up / down scroll, P the period (all, 30 days, 7 days), T the scope
# (every table and room, or this table: in a room the room's), Esc back to
# the recent games.

class MahjongApp < FmrbApp
  B_ST_PERIOD = 122
  B_ST_SCOPE = 123
  B_ST_BACK = 125
  ST_DAYS = [0, 30, 7]
  ST_MAX_ROWS = 120

  alias st_base_rp_draw rp_draw
  alias st_base_rp_key rp_key
  alias st_base_rp_poll rp_poll
  alias st_base_run_button run_button
  alias st_base_status_line status_line

  def st_start
    st_strings
    @st = true
    @st_days = 0
    @st_scope = 0
    @st_top = 0
    @st_rows = []
    @st_games = 0
    @st_f = nil
    @st_note = t(:mj_rp_loading)
    @dirty = true
    st_call(0)
    Log.info("mahjong: stats of #{@rp}")
  end

  def st_close
    @st = false
    @st_rows = nil
    @st_f = nil
    @dirty = true
  end

  def st_reload
    @st_rows = []
    @st_games = 0
    @st_top = 0
    @st_f = nil
    @st_note = t(:mj_rp_loading)
    @dirty = true
    st_call(0)
  end

  def st_call(from)
    return if @st_f
    px = ::Asterism[@rp, timeout: CALL_TIMEOUT]
    @st_f = px.async.stats(ST_DAYS[@st_days], "", @st_scope == 0 ? "all" : "table", from)
  rescue ::Asterism::Error => e
    @st_f = nil
    @st_note = e.message.to_s
    @dirty = true
  end

  def rp_poll
    return st_base_rp_poll unless @st
    # The game starts while this player sits at the table: back to it.
    if @tc.token && @seat && @view && @view["st"] != "wait"
      st_close
      return st_base_rp_poll
    end
    f = @st_f
    return unless f && f.done?
    @st_f = nil
    begin
      r = f.value
      if r.is_a?(Hash) && r["rows"].is_a?(Array)
        @st_rows += r["rows"]
        @st_games = r["games"].to_i
        if r["next"].is_a?(Integer) && @st_rows.size < ST_MAX_ROWS
          st_call(r["next"])
        else
          @st_note = @st_rows.empty? ? t(:mj_rp_none) : ""
        end
      else
        @st_note = r.is_a?(Hash) && r["error"] ? r["error"].to_s : t(:mj_st_old_host)
      end
    rescue ::Asterism::Error => e
      @st_note = "#{t(:mj_host_away)} (#{e.class})"
    end
    @dirty = true
  end

  def rp_key(k)
    return st_base_rp_key(k) unless @st
    sc = k[0]
    ch = k[1]
    if sc == FmrbConst::KEY_ESC || ch == 27
      st_close
    elsif sc == FmrbConst::KEY_UP
      @st_top -= 1 if @st_top > 0
    elsif sc == FmrbConst::KEY_DOWN
      @st_top += 1 if @st_top + 1 < @st_rows.size
    elsif ch == 112 || ch == 80
      st_period
    elsif ch == 116 || ch == 84
      st_scope
    end
    @dirty = true
  end

  def st_period
    @st_days = (@st_days + 1) % ST_DAYS.size
    st_reload
  end

  def st_scope
    @st_scope = 1 - @st_scope
    st_reload
  end

  def run_button(type, tiles)
    return st_base_run_button(type, tiles) unless @rp && @st
    if type == B_ST_PERIOD
      st_period
    elsif type == B_ST_SCOPE
      st_scope
    elsif type == B_ST_BACK || type == B_LEAVE
      st_close
    end
    @dirty = true
  end

  def status_line
    @st ? t(:mj_st_keys) : st_base_status_line
  end

  # ------------------------------------------------------------ drawing

  def rp_draw
    return st_base_rp_draw unless @st
    t0 = Machine.board_millis
    @xl_items = nil
    @hits.clear
    clear_user_area(C_FELT)
    fnt(12, @k)
    st_draw
    @gfx.present
    perf_note(:draw, Machine.board_millis - t0)
  end

  # The columns that fit: [label, width] after the name (the 426x240
  # table drops the last three).
  def st_columns
    cols = [[t(:mj_st_games), 40], [t(:mj_st_rank), 56], [t(:mj_st_top), 52], [t(:mj_st_win), 52],
            [t(:mj_st_dealin), 52], [t(:mj_st_riichi), 56], [t(:mj_st_score), 60], [t(:mj_st_points), 60]]
    cols = cols[0, 5] unless @big
    cols
  end

  def st_draw
    x = @x0 + u(8)
    y = @y0 + u(8)
    parts = @rp.to_s.split("/")
    bl = t(:mj_rp_back)
    bw = tw(bl) + u(12)
    bx = @x0 + @w - bw - u(8)
    button(B_ST_BACK, [], bx, y - u(3), bl)
    sl = @st_scope == 0 ? t(:mj_st_all) : t(:mj_st_table)
    sw = tw(sl) + u(12)
    bx -= sw + u(6)
    button(B_ST_SCOPE, [], bx, y - u(3), sl)
    pl = [t(:mj_st_days0), t(:mj_st_days30), t(:mj_st_days7)][@st_days]
    pw = tw(pl) + u(12)
    bx -= pw + u(6)
    button(B_ST_PERIOD, [], bx, y - u(3), pl)
    text(x, y, fit("#{t(:mj_st_title)}  #{parts[0]}/#{parts[2]}", bx - x - u(6)))
    y += u(20)
    text(x, y, fit("#{@st_games}#{t(:mj_st_games_n)}  #{t(:mj_st_hint)}", @w - u(16)), C_DIM)
    y += u(20)
    unless @st_note.to_s.empty?
      text(x, y, fit(@st_note.to_s, @w - u(16)), C_TURN)
      y += u(18)
    end
    cols = st_columns
    fixed = 0
    i = 0
    while i < cols.size
      fixed += u(cols[i][1])
      i += 1
    end
    nw = @w - u(16) - fixed
    # The header.
    text(x, y, t(:mj_st_name), C_DIM)
    cx = x + nw
    i = 0
    while i < cols.size
      cw = u(cols[i][1])
      text(cx + cw - tw(cols[i][0]) - u(4), y, cols[i][0], C_DIM)
      cx += cw
      i += 1
    end
    y += u(16)
    @gfx.fill_rect(x, y - u(2), @w - u(16), 1, C_DIM)
    rows = (@y0 + @h - y - u(4)) / u(17)
    rows = 1 if rows < 1
    @st_top = 0 if @st_top >= @st_rows.size
    i = @st_top
    while i < @st_rows.size && i < @st_top + rows
      st_draw_row(@st_rows[i], x, y, nw, cols)
      y += u(17)
      i += 1
    end
  end

  def st_draw_row(r, x, y, nw, cols)
    human = r["kind"].to_s == "human"
    name = r["name"].to_s
    color = !human ? C_DIM : (name == @name ? C_TURN : C_TEXT)
    text(x, y, fit(name, nw - u(6)), color)
    vals = st_values(r)
    cx = x + nw
    i = 0
    while i < cols.size
      cw = u(cols[i][1])
      v = vals[i]
      text(cx + cw - tw(v) - u(4), y, v, color)
      cx += cw
      i += 1
    end
  end

  # The row's numbers as text, in st_columns' order.
  def st_values(r)
    g = r["games"].to_i
    rk = r["ranks"].is_a?(Array) ? r["ranks"] : []
    sum = 0
    i = 0
    while i < rk.size
      sum += rk[i].to_i * (i + 1)
      i += 1
    end
    rounds = r["rounds"].to_i
    pt = r["points"]
    pq = pt.is_a?(Float) ? (pt * 10).round : pt.to_i * 10
    [g.to_s, st_fixed(g > 0 ? (sum * 100 + g / 2) / g : 0, 100), st_pct(rk[0].to_i, g), st_pct(r["wins"].to_i, rounds),
     st_pct(r["dealins"].to_i, rounds), st_pct(r["riichi"].to_i, rounds), r["avg_score"].to_i.to_s, st_fixed(pq, 10)]
  end

  # n / d as "23.1%" ("-" without d).
  def st_pct(n, d)
    return "-" if d <= 0
    st_fixed((n * 1000 + d / 2) / d, 10) + "%"
  end

  # An integer of 1/scale as a decimal ("2.41", "-5.5").
  def st_fixed(q, scale)
    sign = q < 0 ? "-" : ""
    a = q < 0 ? -q : q
    f = (a % scale).to_s
    f = "0#{f}" if scale == 100 && a % scale < 10
    "#{sign}#{a / scale}.#{f}"
  end

  def st_strings
    @str[:mj_st_title] = "æˆç¸¾"
    @str[:mj_st_old_host] = "ã“ã®ãƒ›ã‚¹ãƒˆã¯æˆç¸¾ã‚’å‡ºã•ãªã„ (0.14.0 ã‚ˆã‚Šå‰)"
    @str[:mj_st_all] = "å…¨ä½“[T]"
    @str[:mj_st_table] = "ã“ã®å“[T]"
    @str[:mj_st_days0] = "å…¨æœŸé–“[P]"
    @str[:mj_st_days30] = "30æ—¥[P]"
    @str[:mj_st_days7] = "7æ—¥[P]"
    @str[:mj_st_games_n] = " å¯¾å±€"
    @str[:mj_st_hint] = "äººã¯è¡¨ç¤ºåã”ã¨ã€CPUãƒ»AI ã¯ç¨®é¡žã”ã¨"
    @str[:mj_st_name] = "åå‰"
    @str[:mj_st_games] = "å¯¾å±€"
    @str[:mj_st_rank] = "å¹³å‡é †ä½"
    @str[:mj_st_top] = "1ä½çŽ‡"
    @str[:mj_st_win] = "å’Œäº†çŽ‡"
    @str[:mj_st_dealin] = "æ”¾éŠƒçŽ‡"
    @str[:mj_st_riichi] = "ãƒªãƒ¼ãƒçŽ‡"
    @str[:mj_st_score] = "å¹³å‡ç‚¹"
