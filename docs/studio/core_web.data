# Exception Test - Triggers an uncaught runtime exception after 3 seconds

class ExceptionApp < FmrbApp
  def on_create
    @tick = 0
    clear_user_area
    @gfx.draw_text(4, 4, "Exception in 3s...", theme_fg)
    draw_window_frame
    @gfx.present
  end

  def method1
    method2
  end

  def method2
    # This will raise an uncaught exception
      nil.no_such_method
  end

  def on_update
    @tick += 1
    if @tick >= 30
      method1
    end
    100
  end
end
