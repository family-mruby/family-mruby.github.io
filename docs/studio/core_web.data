10 REM SAMPLE BASIC PROGRAM FOR FMRUBY
20 REM FAMILY BASIC NOTATION: NO LET, NEXT TAKES NO VARIABLE, PAUSE IN FRAMES
30 PRINT "HELLO FROM BASIC!"
40 PRINT "FMRUBY BASIC INTERPRETER"
50 PRINT
51 PAUSE 30
60 REM TEST VARIABLES AND ARITHMETIC
70 A=10
80 B=20
90 C=A+B
100 PRINT "A = ";A
110 PRINT "B = ";B
120 PRINT "C = A + B = ";C
130 PRINT
140 REM TEST FOR LOOP
150 PRINT "COUNTING FROM 1 TO 5:"
160 FOR I=1 TO 5
161 PAUSE 10
170 PRINT "  ";I
180 NEXT
190 PRINT
200 REM TEST FOR LOOP WITH STEP
210 PRINT "COUNTING DOWN FROM 10 TO 0 BY 2:"
220 FOR I=10 TO 0 STEP -2
230 PRINT "  ";I
240 NEXT
250 PRINT
260 REM TEST IF STATEMENT
270 X=15
280 PRINT "X = ";X
290 IF X>10 THEN PRINT "X IS GREATER THAN 10"
300 IF X<10 THEN PRINT "X IS LESS THAN 10"
310 IF X=15 THEN PRINT "X EQUALS 15"
320 PRINT
330 REM TEST GOSUB/RETURN
331 PAUSE 20
340 PRINT "CALLING SUBROUTINE..."
350 GOSUB 500
351 PAUSE 20
360 PRINT "RETURNED FROM SUBROUTINE"
370 PRINT
380 REM TEST ARITHMETIC IN EXPRESSIONS
390 PRINT "TESTING ARITHMETIC:"
400 PRINT "  5 * 3 = ";5*3
410 PRINT "  20 / 4 = ";20/4
420 PRINT "  (2 + 3) * 4 = ";(2+3)*4
430 PRINT
440 PRINT "PROGRAM COMPLETED!"
441 PAUSE 180
450 END
500 REM SUBROUTINE
510 PRINT "  INSIDE SUBROUTINE"
520 Y=100
530 PRINT "  Y = ";Y
540 RETURN
# script name must be "app_handle_name.app.bas"
app_handle_name = "sample_basic_app"
app_screen_name = "BASIC app demo"
app_screen_name_ja = "BASIC„Éá„É¢"
# A .bas app defaults to fullscreen: the Family BASIC screen is a fixed
# 28x24 character plane (224x192 px). Set "window" here to run it inside a
# desktop window instead.
#default_window_mode = "window" # or "fullwindow" or "window" or "background"

# if fullscreen/fullwindow, they will be ignored
default_window_width = 200
default_window_height = 150

# if fullscreen/fullwindow, they will be ignored
default_window_pos_x = 10
default_window_pos_y = 15
10 REM STAR SHOOTER: KEYBOARD ONLY. ARROWS FLY THE SHIP, Z SHOOTS
20 REM ONE MINUTE ROUND. THE SPRITE PLANE IN ONE PROGRAM: DEF MOVE IN
25 REM 8 DIRECTIONS, MOVE, POSITION, XPOS/YPOS, CRASH BOTH WAYS,
30 REM ERA, CAN, PALET, PLAY, BEEP
40 REM THE KEYBOARD IS THE PAD (FMRB_BASIC.CPP): ARROWS = STICK, Z = A
50 CLS:SPRITE ON
60 REM NIGHT SKY, WHITE AND RED SPRITES OUTLINED IN BLACK
70 PALET 0,15,22,42,48
80 PALET S 0,15,48,22,42
90 PALET S 1,15,48,42,32
100 REM DIRECTION CODE OF A (DX,DY) STEP, LOOKED UP BY (DY+1)*3+DX+1
110 DIM DC(8)
120 FOR I=0 TO 8:READ A:DC(I)=A:NEXT
130 DATA 8,1,2,7,0,3,6,5,4
140 REM THE SHIP IS KEPT INSIDE THIS BOX, WHICH IS THE VISIBLE SCREEN
150 XL=16:XR=224:YT=48:YB=200
160 REM TITLE. THE FIRE KEY STARTS THE GAME, SO IT IS TRIED FIRST
170 LOCATE 9,7:PRINT "„Éõ„Ç∑„É≤ „Ç¶„ÉÜ"
180 LOCATE 5,12:PRINT "„É§„Ç∏„É´„Ç∑  „Ç¶„Ç¥„ÇØ"
190 LOCATE 5,14:PRINT "Z        „Ç¶„ÉÑ"
200 LOCATE 8,19:PRINT "Z „É≤ „Ç™„Çª"
210 PAUSE 1
220 IF (STRIG(0) AND 8)=0 THEN 210
230 CLS
240 SC=0:HP=3:TC=0
250 REM THE SHIP, THE ENEMY CROSSING THE TOP, AND THE LASER
260 DEF MOVE(0)=SPRITE(9,0,1,4,0,0)
270 POSITION 0,120,190:MOVE 0
280 DEF MOVE(1)=SPRITE(8,3,2,112,0,1)
290 POSITION 1,16,40:MOVE 1
300 DEF MOVE(2)=SPRITE(14,1,1,88,0,2)
310 PLAY "T3O4C3E3G3O5C5"
320 REM MAIN LOOP
330 GOSUB 700
340 IF (STRIG(0) AND 8)<>0 THEN GOSUB 600
350 IF MOVE(1)=0 THEN POSITION 1,16,40:MOVE 1
360 IF MOVE(2)=0 THEN ERA 2
370 C=CRASH(1)
380 IF C=2 THEN GOSUB 630
390 IF C=0 THEN GOSUB 660
400 TC=TC+1
410 LOCATE 0,0:PRINT "SCORE";SC;" HP";HP;
420 PAUSE 1
430 IF TC>3600 THEN 800
440 IF HP>0 THEN 330
450 GOTO 800
600 REM FIRE, UNLESS THE LASER IS STILL FLYING
610 IF MOVE(2)=-1 THEN RETURN
620 POSITION 2,XPOS(0),YPOS(0)-8:MOVE 2:BEEP
625 RETURN
630 REM ENEMY DOWN. CAN CLEARS BOTH, SO BOTH ARE DEFINED AGAIN
640 SC=SC+10:BEEP
645 CAN 1,2
650 DEF MOVE(1)=SPRITE(8,3,2,112,0,1)
652 POSITION 1,16,40:MOVE 1
654 DEF MOVE(2)=SPRITE(14,1,1,88,0,2)
656 RETURN
660 REM THE ENEMY RAMMED THE SHIP: ERA KEEPS THE DEFINITION
670 HP=HP-1:BEEP
680 ERA 1
690 POSITION 1,16,40:MOVE 1
695 RETURN
700 REM FLY THE SHIP, KEEPING IT INSIDE THE BOX. THE MOVE ENGINE DRIVES
701 REM THE ENEMY AND THE LASER, BUT NOT THE SHIP: POSITION AND DEF MOVE
702 REM BOTH RESET THE STEP COUNTER, SO A MOTION RE-ISSUED EVERY FRAME
703 REM NEVER REACHES ITS STEP PERIOD AND WOULD STAND STILL. THE SHIP IS
704 REM THEREFORE STEPPED BY HAND, AND DEF MOVE ONLY TURNS IT
710 S=STICK(0):DX=0:DY=0
720 IF (S AND 1)=1 THEN DX=1
730 IF (S AND 2)=2 THEN DX=-1
740 IF (S AND 4)=4 THEN DY=1
750 IF (S AND 8)=8 THEN DY=-1
760 X=XPOS(0)+DX*4:Y=YPOS(0)+DY*4
770 IF X<XL THEN X=XL
775 IF X>XR THEN X=XR
780 IF Y<YT THEN Y=YT
785 IF Y>YB THEN Y=YB
790 POSITION 0,X,Y
793 DR=DC((DY+1)*3+DX+1)
796 IF DR<>0 THEN DEF MOVE(0)=SPRITE(9,DR,1,4,0,0)
797 RETURN
800 REM TIME UP OR OUT OF HP
810 ERA 0,1,2:SPRITE OFF
820 CLS
830 IF HP>0 THEN LOCATE 8,10:PRINT "„Çø„Ç§„É†„Ç¢„ÉÉ„Éó!"
840 IF HP<=0 THEN LOCATE 8,10:PRINT "„Ç≤„Ç≠„ÉÑ„Ç§ „Çµ„É¨„Çø"
850 LOCATE 8,13:PRINT "SCORE";SC
860 IF SC>=100 THEN LOCATE 9,16:PRINT "„Çπ„Ç¥„Ç§!"
865 PAUSE 300
870 END
# Generated by "rake basic:samples" from components/basic/test/samples.
# Edit the sample there, not this copy.
app_handle_name = "sample_11_shoot"
app_screen_name = "Shoot"
app_screen_name_ja = "„Ç∑„É•„Éº„Éà"
10 REM MAZE WALK: A PERFECT MAZE, DUG BY A RECURSIVE BACKTRACKER
20 REM EVERY CELL IS REACHED EXACTLY ONCE, SO THE GOAL IS ALWAYS REACHABLE
30 REM AND EVERY PASSAGE IS ONE CHARACTER WIDE
40 REM THE TEXT SCREEN IS BOTH THE MAP AND THE MEMORY: SCR$ READS BACK
50 REM WHAT WAS PRINTED, SO ONLY THE BACKTRACK STACK NEEDS AN ARRAY
60 REM KEYBOARD ONLY: THE ARROW KEYS ARE READ THROUGH STICK(0), AND THE
70 REM NAME ENTRY AT THE GOAL IS INKEY$, WHICH IS ALSO THE KANA INPUT DEMO
80 REM SHOWS LOCATE, COLOR, SCR$, RND, DIM, DATA/READ, PAUSE, KANA, BEEP
90 CLS
100 REM 13 X 10 CELLS BECOME A 27 X 21 CHARACTER MAZE AT (0,3)
110 W=13:H=10:OX=0:OY=3
120 DIM SK(130),CD(3),VX(3),VY(3)
130 FOR I=0 TO 3:READ VX(I):NEXT
140 DATA 1,-1,0,0
150 FOR I=0 TO 3:READ VY(I):NEXT
160 DATA 0,0,1,-1
161 REM TITLE. RND IS SEEDED THE SAME ON EVERY RUN, SO THE MAZE WOULD
162 REM ALWAYS COME OUT IDENTICAL. BURNING RND WHILE WAITING FOR THE
163 REM START KEY MAKES THE PLAYER'S OWN TIMING THE SEED
164 LOCATE 11,8:PRINT "„É°„Ç§„É≠"
165 LOCATE 6,12:PRINT "„É§„Ç∏„É´„Ç∑„Éá G „Éû„Éá"
166 LOCATE 9,16:PRINT "Z „É≤ „Ç™„Çª"
167 Q=RND(100):PAUSE 1
168 IF (STRIG(0) AND 8)=0 THEN 167
169 A$=INKEY$:IF A$<>"" THEN 169
170 CLS:LOCATE 1,0:PRINT "„É§„Ç∏„É´„Ç∑„Éá G „Éû„Éá „Ç¢„É´„Ç±"
180 LOCATE 1,1:PRINT "„É°„Ç§„É≠ „É≤ „Éõ„ÉÉ„ÉÜ„Ç§„Éû„Çπ"
190 REM SOLID ROCK FIRST: ONE PRINT PER ROW, 27 CHARACTERS EACH
200 R$=""
210 FOR I=1 TO 27:R$=R$+"#":NEXT
220 FOR Y=0 TO 2*H
230 LOCATE OX,OY+Y:PRINT R$;
240 NEXT
245 REM DIGGING IS THOUSANDS OF STATEMENTS. THE DEFAULT PACE (60 PER
246 REM FRAME, WHICH IS WHAT KEEPS THE GAME AT THE ORIGINAL SPEED)
247 REM WOULD MAKE IT CRAWL, SO RAISE IT WHILE DIGGING AND PUT IT BACK
248 _SPEED 600
250 GOSUB 1000
255 _SPEED 60
260 LOCATE 1,1:PRINT "                      ";
270 REM THE GOAL SITS IN THE LAST CELL, THE PLAYER IN THE FIRST
280 GX=OX+1+(W-1)*2:GY=OY+1+(H-1)*2
290 COLOR GX,GY,2
300 LOCATE GX,GY:PRINT "G";
310 PX=OX+1:PY=OY+1:ST=0
320 LOCATE PX,PY:PRINT "P";
400 REM MAIN LOOP. STICK(0) REPORTS A KEY THAT IS STILL HELD DOWN, SO
401 REM READING IT EVERY FEW FRAMES WALKS SEVERAL CELLS PER TAP. THIS
402 REM REPEATS LIKE A KEYBOARD INSTEAD: A NEWLY SEEN DIRECTION MOVES AT
403 REM ONCE, AND HOLDING WAITS RD FRAMES FOR THE FIRST REPEAT AND RI
404 REM FRAMES FOR THE ONES AFTER IT. A TAP IS THEREFORE EXACTLY ONE CELL
405 RD=20:RI=7:LS=0:RP=0:F=0
410 PAUSE 1
412 S=STICK(0)
414 IF S=0 THEN LS=0:GOTO 410
416 IF S<>LS THEN LS=S:RP=RD:F=1:GOTO 420
417 RP=RP-1
418 IF RP>0 THEN 410
419 RP=RI:F=0
420 DX=0:DY=0
430 IF (S AND 1)<>0 THEN DX=1
440 IF (S AND 2)<>0 THEN DX=-1
450 IF (S AND 4)<>0 THEN DY=1
460 IF (S AND 8)<>0 THEN DY=-1
470 REM NO DIAGONALS: A ONE WIDE PASSAGE HAS NO ROOM TO CUT A CORNER
480 IF DX<>0 THEN DY=0
490 IF DX=0 AND DY=0 THEN 410
500 NX=PX+DX:NY=PY+DY
510 B$=SCR$(NX,NY)
520 IF B$="#" THEN 590
530 LOCATE PX,PY:PRINT " ";
540 PX=NX:PY=NY:LOCATE PX,PY:PRINT "P";
550 ST=ST+1
560 IF B$="G" THEN 600
570 GOTO 410
590 REM WALL. ONLY THE FIRST PRESS BEEPS, NOT EVERY REPEAT
595 IF F=1 THEN BEEP
598 GOTO 410
600 REM GOAL. THE NAME IS TYPED ONE INKEY$ AT A TIME, SO THE KANA MODE
610 REM (TAB, THEN TWO ROMAJI KEYS PER KANA) CAN BE TRIED HERE
620 CLS
630 LOCATE 10,4:PRINT "„ÇØ„É™„Ç¢!"
640 LOCATE 9,6:PRINT "STEPS";ST
650 LOCATE 2,10:PRINT "„Éä„Éû„Ç® „É≤ „Ç§„É¨„ÉÜ"
660 LOCATE 2,12:PRINT "TAB „Ç´„Éä  ENTER „Ç™„ÉØ„É™"
670 N$=""
680 LOCATE 2,15:PRINT N$;"_ ";
690 PAUSE 1
700 A$=INKEY$
710 IF A$="" THEN 690
715 REM ENTER ARRIVES AS LF (FMRB_KEYMAP.C MAPS IT TO 10), NOT CR
720 IF A$=CHR$(10) OR A$=CHR$(13) THEN 760
730 IF A$<" " THEN 690
740 IF LEN(N$)<12 THEN N$=N$+A$
750 GOTO 680
760 LOCATE 2,15:PRINT N$;"  ";
770 IF LEN(N$)=0 THEN 790
780 LOCATE 2,18:PRINT N$;" „Çµ„É≥ „Ç™„É°„Éá„Éà„Ç¶"
790 PAUSE 300
800 END
1000 REM RECURSIVE BACKTRACKER, THE STACK HELD IN SK() AS CELL NUMBERS.
1010 REM A CELL COUNTS AS VISITED ONCE ITS CHARACTER IS A SPACE, WHICH
1020 REM IS WHAT SCR$ REPORTS, SO NO SEPARATE VISITED MAP IS NEEDED
1030 LOCATE OX+1,OY+1:PRINT " ";
1040 SK(0)=0:SP=1
1050 IF SP=0 THEN RETURN
1060 T=SK(SP-1):CX=T MOD W:CY=T/W
1070 N=0
1080 FOR D=0 TO 3
1090 NX=CX+VX(D):NY=CY+VY(D)
1100 IF NX<0 OR NX>=W THEN 1140
1110 IF NY<0 OR NY>=H THEN 1140
1120 IF SCR$(OX+1+NX*2,OY+1+NY*2)=" " THEN 1140
1130 CD(N)=D:N=N+1
1140 NEXT
1150 IF N=0 THEN SP=SP-1:GOTO 1050
1160 D=CD(RND(N))
1170 NX=CX+VX(D):NY=CY+VY(D)
1180 REM KNOCK OUT THE WALL BETWEEN THE TWO CELLS, THEN THE CELL ITSELF
1190 LOCATE OX+1+CX*2+VX(D),OY+1+CY*2+VY(D):PRINT " ";
1200 LOCATE OX+1+NX*2,OY+1+NY*2:PRINT " ";
1210 SK(SP)=NY*W+NX:SP=SP+1
1220 GOTO 1050
# Generated by "rake basic:samples" from components/basic/test/samples.
# Edit the sample there, not this copy.
app_handle_name = "sample_12_maze"
app_screen_name = "Maze"
app_screen_name_ja = "„É°„Ç§„É≠"
10 REM MUSIC AND CIRCLES: A KEYBOARD DRIVEN TOUR OF SOUND AND GRAPHICS
20 REM 1-4 PLAYS ONE PHRASE, Z PLAYS ALL FOUR, 0 ENDS THE DEMO
30 REM SHOWS PLAY (3 CHANNELS, T/M/Y/V/O/R), ASYNC PLAYBACK, CLICK, BEEP,
40 REM AND THE FMRUBY EXTENSIONS CIRCLE / PRESENT ON THE TEXT PLANE
50 REM PHRASES ARE UNDER 31 CHARS, WHICH IS THE STRING LIMIT
60 CLICK ON
70 GOSUB 500
100 REM MENU LOOP. NON BLOCKING INKEY$ WITH A PAUSE, SO THE SCREEN
105 REM KEEPS BEING PRESENTED WHILE THE DEMO WAITS FOR A KEY
106 PAUSE 1
107 A$=INKEY$
110 IF A$="" THEN 106
120 IF A$="0" THEN 900
130 IF A$="Z" THEN GOSUB 300:GOTO 106
140 P=VAL(A$)
150 IF P<1 THEN 106
160 IF P>4 THEN 106
170 GOSUB 200
180 GOTO 106
200 REM PLAY PHRASE P, THEN BLOOM CIRCLES WHILE IT IS STILL SOUNDING
210 RESTORE
220 FOR I=1 TO P:READ A$:NEXT
230 PLAY A$
240 GOSUB 600
250 RETURN
300 REM ALL FOUR PHRASES BACK TO BACK
310 RESTORE
320 FOR P=1 TO 4
330 READ A$:PLAY A$
340 GOSUB 600
350 NEXT
360 BEEP
370 RETURN
400 DATA "T4M1Y2V12O3C5E5G5:C5E5G5:O1C9"
410 DATA "T4O4C5O3B5A5:E5D5C5:O1G9"
420 DATA "T4F5A5O4C5:O3A5B5O4C5:O1F9"
430 DATA "T4M0V15O4C7R3C3:E7R3E3:O1C9"
500 REM MENU. CLS ALSO WIPES THE CIRCLES, WHICH SHARE THE TEXT PLANE
510 CLS
520 LOCATE 8,3:PRINT "„Ç™„É≥„Ç¨„ÇØ „Éá„É¢"
530 LOCATE 4,7:PRINT "1-4  „Ç≠„Éß„ÇØ „É≤ „Ç®„É©„Éñ"
540 LOCATE 4,9:PRINT "Z    „Çº„É≥„Éñ „Ç≠„ÇØ"
550 LOCATE 4,11:PRINT "0    „Ç™„ÉØ„É™"
560 RETURN
600 REM CIRCLES BLOOM UNDER THE MENU WHILE THE PHRASE PLAYS. PLAY IS
610 REM ASYNCHRONOUS, SO THE DRAWING AND THE SOUND RUN TOGETHER
620 FOR K=1 TO 14
630 X=RND(200)+12:Y=RND(50)+120:R=RND(12)+4:C=RND(200)+40
640 IF K MOD 2=0 THEN CIRCLE X,Y,R,C,1
650 IF K MOD 2=1 THEN CIRCLE X,Y,R,C
660 PRESENT
670 PAUSE 6
680 NEXT
690 GOSUB 500
695 PRESENT
699 RETURN
900 CLS
910 LOCATE 10,11:PRINT "„Ç™„ÉØ„É™"
915 PAUSE 120
920 END
