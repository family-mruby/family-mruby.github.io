# Mahjong table: the title "ãƒ’ãƒ‡é›€" (MJ8, doc/ruby_asterism/report/mj8.md).
# Part of MahjongApp, read when the app opens (title_draw in
# mahjong_panels.rb); title_unload takes these methods out of the class
# again when the title goes, so a game's VM does not hold them.

class MahjongApp < FmrbApp
  TITLE_TILES = [30, 31, 32, 33, 34, 35, 36] # the winds and the dragons

  # Drawn once (again only when the screen's size changes).
  def draw_title
    return if @title_drawn == @w
    @title_drawn = @w
    @hits.clear
    clear_user_area(C_FELT)
    big = @big ? 4 : 3 # the text scale stops at 4
    tw_ = @xl ? 84 : (@big ? 42 : 24)
    th = @xl ? 112 : (@big ? 56 : 32)
    fnt(16, big)
    title = "ãƒ’ãƒ‡é›€"
    gap = u(@big ? 16 : 8)
    top = @y0 + (@h - (@fw + gap + th + gap + u(12))) / 2
    text(@x0 + (@w - tw(title)) / 2, top, title)
    y = top + @fw + gap
    x = @x0 + (@w - TITLE_TILES.size * tw_) / 2
    i = 0
    while i < TITLE_TILES.size
      c = TITLE_TILES[i]
      if @xl
        xl_draw_item(xl_hand_item(c, x + i * tw_, y, 0))
      elsif @big
        big_tile(c, x + i * tw_, y)
      else
        small_tile(c, x + i * tw_, y)
      end
      i += 1
    end
    fnt(12, @k)
    sub = "Hide Jong"
    text(@x0 + (@w - tw(sub)) / 2, y + th + gap, sub)
    @gfx.present
  end

  def list_ready?
    return false unless @tc
    i = 0
    while i < @tc.table_list.size
      st = @tc.tables[@tc.table_list[i]]
      return true if st && st["st"]
      i += 1
    end
    false
  end

  def title_unload
    self.class.remove_method(:draw_title)
    self.class.remove_method(:list_ready?)
    self.class.remove_method(:title_unload)
  rescue => e
    Log.info("mahjong: title: #{e.message}")
  end
end
# Mahjong table: the 640x360 spectators' screen (MJ5, doc/ruby_asterism/
# report/mj5.md). Part of MahjongApp, read when the screen is first shown
# (watch_load in mahjong_panels.rb; MJ8: a seated player's VM never holds
# it).
#
# A spectator sees the four hands (the view's "sh" and "sd"; a host without
# them gives the backs), each the same size and turned to its player along
# the screen's edge: the hand, then the melds. The middle is the 1280x720
# table at half its size: a board with the round and the dora, the four
# rivers around it in the small tiles, and above it a line of the four
# seats (wind, name, points, riichi; the seat to act framed). The side
# rows that do not fit the screen's height go on in a second column.
# Everything is drawn at each drawing (the 640x360 table's way).

class MahjongApp < FmrbApp
  # The parts of this screen, [x, y, w, h] (the overflow checker holds the
  # drawing to them).
  WATCH = {
    w_row0: [40, 326, 560, 32], w_row2: [40, 2, 560, 32], w_row3: [2, 2, 32, 356], w_row3b: [36, 38, 32, 284],
    w_row1: [606, 2, 32, 356], w_row1b: [572, 38, 32, 284],
    w_strip: [72, 38, 496, 30], w_board: [236, 166, 168, 64],
    w_river0: [236, 230, 332, 96], w_river2: [160, 70, 244, 96], w_river3: [100, 126, 136, 198],
    w_river1: [404, 70, 136, 200], w_leave: [68, 72, 90, 20], w_note: [72, 104, 160, 14]
  }
  W_BX = 236
  W_BY = 166
  W_BW = 168
  W_BH = 64
  # The room of a river's last row (rl 0-3).
  W_LAST_ROW = [332, 200, 244, 198]

  # A small tile turned rot quarter turns at (x, y).
  def turned_tile(rot, c, x, y)
    w = rot % 2 == 1 ? 32 : 24
    h = rot % 2 == 1 ? 24 : 32
    img = @turned ? @turned[rot] : nil
    return draw_text_tile(c, x, y, w, h) unless img
    @gfx.draw_tile(img.id, (c % 10) * w, (c / 10) * h, w, h, dst_x: x, dst_y: y)
  end

  def draw_watch
    load_turned_sheets
    v = @view
    s = 0
    while s < 4
      rl = rel(s)
      draw_watch_river(rl, xl_river_list(s))
      draw_spec_hand(rl, s)
      s += 1
    end
    draw_watch_board
    draw_score_strip
    # Leaving, and what the screen has to say (the network, a reply).
    fnt(12, 1)
    button(B_LEAVE, [], @x0 + WATCH[:w_leave][0], @y0 + WATCH[:w_leave][1], t(:mj_leave))
    note = net_line || @note
    text(@x0 + WATCH[:w_note][0], @y0 + WATCH[:w_note][1], fit(note.to_s, WATCH[:w_note][2]), C_TURN) unless note.to_s.empty?
  end

  # A river in the small tiles, six to a row from the board's edge, the last
  # row closing up past its room; the riichi tile sideways.
  def draw_watch_river(rl, list)
    side = rl == 1 || rl == 3
    rows = side ? 4 : 3
    base = xl_rot(rl)
    turned = (base + 3) % 4
    r = 0
    while r < rows
      from = r * 6
      to = r == rows - 1 ? list.size : from + 6
      to = list.size if to > list.size
      break if from >= to
      lens = []
      i = from
      while i < to
        lens << (list[i][1] ? 32 : 24)
        i += 1
      end
      offs = close_up(lens, r == rows - 1 ? W_LAST_ROW[rl] : 999)
      i = from
      while i < to
        e = list[i]
        len = e[1] ? 32 : 24
        off = e[1] ? 4 : 0
        a = offs[i - from]
        if rl == 0
          x = W_BX + a
          y = W_BY + W_BH + r * 32 + off
        elsif rl == 2
          x = W_BX + W_BW - a - len
          y = W_BY - (r + 1) * 32 + off
        elsif rl == 3
          x = W_BX - 8 - (r + 1) * 32 + off
          y = W_BY + W_BH / 2 - 72 + a
        else
          x = W_BX + W_BW + 8 + r * 32 + off
          y = W_BY + W_BH / 2 + 72 - a - len
        end
        turned_tile(e[1] ? turned : base, e[0], @x0 + x, @y0 + y)
        if e[2] == 1
          wide = side != e[1] # a side seat's upright tile and a sideways one of the others lie wide
          @gfx.draw_rect(@x0 + x, @y0 + y, wide ? 32 : 24, wide ? 24 : 32, C_LAST)
        end
        i += 1
      end
      r += 1
    end
  end

  # A seat's row along the edge: [code, sideways, offset, stacked] of its
  # hand (the drawn tile apart) and its melds (the first call at the far
  # end; stacked: an added kan's tile).
  def watch_row(s)
    out = []
    a = 0
    sp = spec_hand(s)
    if sp
      tl = sp[0]
      tl += [sp[1]] if sp[1] >= 0
      i = 0
      while i < tl.size
        a += 8 if sp[1] >= 0 && i == tl.size - 1
        out << [tl[i], false, a]
        a += 24
        i += 1
      end
    else
      hc = @view["hc"].is_a?(Array) ? @view["hc"][s].to_i : 13
      i = 0
      while i < hc
        a += 8 if i == hc - 1 && hc % 3 == 2
        out << [37, false, a]
        a += 24
        i += 1
      end
    end
    a += 12
    ms = xl_melds(s)
    k = ms.size - 1
    while k >= 0
      kind = ms[k][0]
      tl = ms[k][2]
      n = kind == 5 ? 3 : tl.size
      si = xl_sideways_index(kind, ms[k][1], tl.size)
      j = 0
      while j < n
        c = tl[j]
        c = 37 if kind == 3 && (j == 0 || j == n - 1)
        sw = j == si
        out << [c, sw, a]
        # An added kan's tile lies on the sideways one (MJ8; 8 px towards
        # the table, the row being 32 deep).
        out << [tl[3], true, a, true] if sw && kind == 5
        a += sw ? 32 : 24
        j += 1
      end
      a += 4
      k -= 1
    end
    out
  end

  # Draws a seat's row: one line along the top or the bottom edge, a column
  # along a side edge (and a second column inside it for what does not fit).
  def draw_spec_hand(rl, s)
    list = watch_row(s)
    return if list.empty?
    base = xl_rot(rl)
    turned = (base + 3) % 4
    side = rl == 1 || rl == 3
    cols = [list]
    if side
      room = WATCH[:w_row1][3]
      i = 0
      i += 1 while i < list.size && list[i][2] + (list[i][1] ? 32 : 24) <= room
      if i < list.size
        cut = list[i][2]
        rest = []
        list[i..].each { |e| rest << [e[0], e[1], e[2] - cut, e[3]] }
        cols = [list[0, i], rest]
      end
    end
    ci = 0
    while ci < cols.size
      col = cols[ci]
      pr = WATCH[ci == 0 ? [:w_row0, :w_row1, :w_row2, :w_row3][rl] : (rl == 1 ? :w_row1b : :w_row3b)]
      len_room = side ? pr[3] : pr[2]
      lens = []
      col.each { |e| lens << (e[1] ? 32 : 24) }
      # The offsets as laid out, closed up past the room.
      offs = []
      last = col[col.size - 1]
      total = last[2] + (last[1] ? 32 : 24)
      col.each do |e|
        offs << (total <= len_room ? e[2] : e[2] * (len_room - lens[lens.size - 1]) / (total - lens[lens.size - 1]))
      end
      j = 0
      while j < col.size
        e = col[j]
        a = offs[j]
        len = e[1] ? 32 : 24
        t = e[1] ? 24 : 32
        if rl == 0
          x = pr[0] + a
          y = pr[1] + 32 - t
        elsif rl == 2
          x = pr[0] + pr[2] - a - len
          y = pr[1]
        elsif rl == 3
          x = pr[0]
          y = pr[1] + a
        else
          x = pr[0] + 32 - t
          y = pr[1] + pr[3] - a - len
        end
        if e[3]
          d = XL_STACK[rl]
          x += d[0]
          y += d[1]
        end
        turned_tile(e[1] ? turned : base, e[0], @x0 + x, @y0 + y)
        j += 1
      end
      ci += 1
    end
  end

  # The board: the round, the honba, the sticks, what is left, the dora.
  def draw_watch_board
    v = @view
    bx = @x0 + W_BX
    by = @y0 + W_BY
    @gfx.fill_rect(bx, by, W_BW, W_BH, 0x24)
    @gfx.draw_rect(bx, by, W_BW, W_BH, C_DIM)
    r = v["r"]
    return unless r.is_a?(Array)
    fnt(12, 1)
    s = "#{WIND[r[0].to_i % 4]}#{r[1]}#{t(:mj_kyoku)} #{r[2]}#{t(:mj_honba)} #{t(:mj_sticks)}#{r[3]}"
    s = "#{s} #{t(:mj_left)}#{r[5]}" if r.size > 5
    s = fit(s, W_BW - 8)
    text_spaced(bx + (W_BW - tw(s)) / 2, by + 6, s)
    d = bytes_of(v["dora"])
    w = tw(t(:mj_dora)) + 4 + d.size * 24
    dx = bx + (W_BW - w) / 2
    text(dx, by + 38, t(:mj_dora), C_TEXT)
    dx += tw(t(:mj_dora)) + 4
    i = 0
    while i < d.size
      small_tile(d[i], dx + i * 24, by + 26)
      i += 1
    end
  end

  # The four seats on a line above the board (the 640x360 spectators):
  # wind and name, then the points and riichi; the seat to act framed.
  def draw_score_strip
    v = @view
    nm = v["nm"].is_a?(Array) ? v["nm"] : []
    sc = v["sc"].is_a?(Array) ? v["sc"] : []
    ri = v["ri"].to_i
    r = v["r"]
    cur = r.is_a?(Array) && r.size > 6 && v["st"] == "play" ? r[6].to_i : -1
    fnt(12, 1)
    pr = WATCH[:w_strip]
    cw = pr[2] / 4
    s = 0
    while s < 4
      x = @x0 + pr[0] + s * cw
      y = @y0 + pr[1]
      turn = s == cur
      @gfx.fill_rect(x, y, cw - 4, pr[3], turn ? C_SEL : C_BOX)
      @gfx.draw_rect(x, y, cw - 4, pr[3], C_TURN) if turn
      col = away?(s) ? C_AWAY : (turn ? C_TURN : C_TEXT)
      head = "#{wind_of(s)} "
      text(x + 4, y + 2, "#{head}#{fit(nm[s].to_s, cw - 12 - tw(head))}", col)
      tail = sc[s].to_s
      tail = "#{tail} #{t(:mj_riichi)}" if (ri >> s) & 1 == 1
      text(x + 4, y + 16, tail, col)
      s += 1
    end
  end
end
# Mahjong table: the conventional 1280x720 table of the browser build
# (MJ-L, doc/ruby_asterism/report/mj_layout.md; the worst cases fitted in
# MJ5, mj5.md). Part of MahjongApp, read only when the screen is 1280x720
# (load_xl_sheets in mahjong_panels.rb; MJ8: a 640x360 table's VM never
# holds it). The helpers the other screens share with it (the rivers, the
# melds, the turned sheets) are in mahjong_panels.rb.

class MahjongApp < FmrbApp
  # ------------------------------------------------------------ the 1280x720 table (MJ-L)
  #
  # Sizes (the sheets in large/): hand 84x112 (twice the 640x360 hand),
  # river and own melds 48x64 (twice the 640x360 river), turned by quarter
  # turns for the other seats, the opponents' melds 24x32 (the river sheet
  # itself and its turns), the backs of the opponents' hands 32x20 / 20x32.
  # The board is 288x160 in the middle (6 river tiles wide); every river
  # starts at the board's edge (the side ones 16 px off it, room for a
  # sideways tile in the row next to them) and runs from its player's left
  # to right, six to a row: three rows above and below, four beside it. The
  # last row takes the rest; past the room of its panel (xl_panel) its
  # tiles close up. A spectator sees the four hands face up, all in the
  # small tiles, each row turned to its player (no big hand at the bottom).
  #
  # Drawing: every tile, back and highlight is an item [x, y, w, h, image,
  # src_x, src_y, mark, tile]. A drawing builds the items of each part
  # (rivers, opponents' rows, own hand, own melds) and compares them with
  # what was drawn: an item that changed is cleared (its old rectangle) and
  # drawn again; an unchanged item that a clear touched is drawn again too.
  # The texts (the board, the status line, the buttons) have a signature
  # each and are redrawn when it changes. A changed screen (another mode, a
  # result shown or gone) draws everything.

  XL_BX = 496
  XL_BY = 236
  XL_BW = 288
  XL_BH = 160
  XL_HAND_X = 48
  XL_HAND_Y = 608                  # the hand's bottom on the screen's (room above it for the marks)
  XL_RIGHT = 1272
  XL_BTN_RIGHT = 1228                # the buttons' right edge (the right player's row is past it)
  XL_BTN_ROWS = [548, 504, 460, 416] # the buttons' rows, the first at the bottom
  XL_STATUS = [52, 530, 434, 56]   # the status lines (right of the left player's row, above the hand)
  XL_WAITS = [56, 480, 430, 48]    # the riichi help (above the status lines)
  XL_LIFT = 10                     # the chosen hand tile is this much higher
  XL_SIDE = 16                     # the side rivers stand this far off the board
  C_BOARD = 0x24
  C_BTN_WIN = 0xA0
  C_BTN_PASS = 0x6D

  # The parts of the screen (the overflow checker, tools/mahjong_overflow,
  # holds every drawing to them): [x, y, w, h].
  XL_PANELS = {
    board: [496, 236, 288, 160], status: XL_STATUS, waits: XL_WAITS, assist: [12, 8, 248, 40],
    buttons: [496, 416, 732, 172],
    r0: [496, 396, 732, 192], r1: [800, 12, 256, 448], r2: [260, 44, 524, 192], r3: [224, 172, 256, 304],
    o0: [380, 600, 848, 32], o1: [1236, 12, 32, 584], o2: [260, 10, 640, 32], o3: [12, 52, 32, 660],
    h: [48, 588, 1188, 132], m: [400, 608, 872, 112]
  }

  # The geometry of the screen: a seated player's (and a spectator's of a
  # host that does not show the hands), and the spectators' with the four
  # hands face up (MJ10). by: the board's top; last: the room of each
  # river's last row (XL_LAST_ROW); rows: where each seat's row starts
  # (xl_spec_place); status, btn_rows, btn_right: the status line and the
  # buttons; panels: XL_PANELS.
  XL_LAST_ROW = [732, 448, 524, 304]
  XL_SEAT = {
    by: XL_BY, last: XL_LAST_ROW, status: XL_STATUS, btn_rows: XL_BTN_ROWS, btn_right: XL_BTN_RIGHT, panels: XL_PANELS
  }
  # The spectators (MJ10, option "river48"): the hands in the river's
  # tiles (48x64, turned to their players), one line each, the melds in the
  # small tiles at the far end; the board and the rivers 44 px lower than
  # a seated player's (the top row above them), the side rows from top to
  # bottom of the screen.
  XL_SPEC = {
    by: 280, last: [704, 448, 524, 304], status: [80, 540, 400, 56], btn_rows: [592, 548, 504, 460], btn_right: 1196,
    # The rows: start [x, y] on the screen's edge, the hand tile (along,
    # across), the gap before the drawn tile, the melds big or small, the
    # room of a line and the lines (2: the second towards the table).
    rows: [[296, 712], [1272, 704], [984, 8], [8, 16]], tile: [48, 64], drawn_gap: 12, big_melds: false,
    room: 688, lines: 1,
    panels: {
      board: [496, 280, 288, 160], status: [80, 540, 400, 56], waits: XL_WAITS, assist: [12, 8, 248, 40],
      buttons: [496, 460, 700, 172],
      r0: [496, 440, 704, 192], r1: [800, 56, 256, 448], r2: [260, 88, 524, 192], r3: [224, 216, 256, 304],
      o0: [296, 648, 688, 64], o1: [1208, 16, 64, 688], o2: [296, 8, 688, 64], o3: [8, 16, 64, 688]
    }
  }

  # The geometry in use (set by xl_draw).
  def xg
    @xg || XL_SEAT
  end

  # The spectators' screen with the hands face up.
  def xl_spec?
    @seat.nil? && !spec_hand(0).nil?
  end

  def xl_panel(key)
    xg[:panels][key]
  end

  # The sheets (load_xl_sheets in mahjong_panels.rb reads this file first).
  def xl_load_sheets
    return if @xl_sheets || !@xl
    @xl_sheets = true
    @xl_hand = [load_sheet("tiles_hand2_a.bmp", 840, 224, XL_DIR), load_sheet("tiles_hand2_b.bmp", 840, 224, XL_DIR)]
    @xl_r2 = [load_sheet("tiles_river2_r0.bmp", 480, 256, XL_DIR), load_sheet("tiles_river2_r90.bmp", 640, 192, XL_DIR),
              load_sheet("tiles_river2_r180.bmp", 480, 256, XL_DIR), load_sheet("tiles_river2_r270.bmp", 640, 192, XL_DIR)]
    load_turned_sheets
    @xl_r1 = @turned
    @xl_side = load_sheet("tiles_side.bmp", 72, 32, XL_DIR)
  end

  def img_id(img)
    img ? img.id : -1
  end

  # Items. mark: 0 none, 1 the last discard (a frame), 2 not to be chosen
  # (a bar, while picking the riichi tile), 3 a discard that leaves the hand
  # tenpai (the help: a yellow triangle above the tile), 4 one that keeps the
  # least shanten (the help at level 3: a cyan triangle). The tenth element
  # is true for the chosen hand tile and, in the rivers, the melds and the
  # dora, for a tile of the chosen one's kind (MJ8): a blue frame.
  def xl_hand_item(c, x, y, mark, chosen = false)
    k = c < 20 ? c : c - 20
    [x, y, 84, 112, img_id(@xl_hand[c < 20 ? 0 : 1]), (k % 10) * 84, (k / 10) * 112, mark, c, chosen]
  end

  # The rectangle an item covers on the screen: its tile, and the help mark
  # above it.
  def xl_extent(it)
    return it if it[7] < 3
    r = mark_rise
    [it[0], it[1] - r, it[2], it[3] + r]
  end

  # A river-size tile (big: 48x64, else 24x32) turned rot quarter turns;
  # same: framed as a tile of the chosen hand tile's kind.
  def xl_tile_item(big, rot, c, x, y, mark, same = false)
    w = big ? 48 : 24
    h = big ? 64 : 32
    if rot % 2 == 1
      t = w
      w = h
      h = t
    end
    img = big ? @xl_r2[rot] : @xl_r1[rot]
    [x, y, w, h, img_id(img), (c % 10) * w, (c / 10) * h, mark, c, same]
  end

  # The back of an opponent's concealed tile, for the seat rl (1, 2, 3).
  def xl_side_item(rl, x, y)
    return [x, y, 32, 20, img_id(@xl_side), 0, 0, 0, 37] if rl == 2
    [x, y, 20, 32, img_id(@xl_side), rl == 3 ? 32 : 52, 0, 0, 37]
  end

  def xl_draw_item(it)
    if it[4] >= 0
      @gfx.draw_tile(it[4], it[5], it[6], it[2], it[3], dst_x: it[0], dst_y: it[1])
    else
      draw_text_tile(it[8], it[0], it[1], it[2], it[3])
    end
    chosen_frame(it[0], it[1], it[2], it[3]) if it[9]
    if it[7] == 1
      @gfx.draw_rect(it[0], it[1], it[2], it[3], C_LAST)
      @gfx.draw_rect(it[0] + 1, it[1] + 1, it[2] - 2, it[3] - 2, C_LAST)
    elsif it[7] == 2
      @gfx.fill_rect(it[0] + 4, it[1] + it[3] - 14, it[2] - 8, 5, C_DIM)
    elsif it[7] >= 3
      assist_mark(it[0], it[1], it[2], it[7] == 4 ? C_KEEP : C_TURN)
    end
    @xl_n_items += 1
    @xl_n_px += it[2] * it[3]
  end

  # A river: [[code, sideways, mark], ...] laid out for the seat rl. The
  # bottom river's row ends go to @xl_r0_ends and the rows of the right one
  # to @xl_r1_rows (the buttons keep clear of them).
  def xl_river_items(rl, list)
    out = []
    side = rl == 1 || rl == 3
    rows = side ? 4 : 3
    base = xl_rot(rl)
    turned = (base + 3) % 4
    by = xg[:by]
    ends = [0, 0, 0, 0]
    r = 0
    while r < rows
      from = r * 6
      to = r == rows - 1 ? list.size : from + 6
      to = list.size if to > list.size
      break if from >= to
      lens = []
      i = from
      while i < to
        lens << (list[i][1] ? 64 : 48)
        i += 1
      end
      offs = close_up(lens, r == rows - 1 ? xg[:last][rl] : 999)
      i = from
      while i < to
        e = list[i]
        sw = e[1]
        len = sw ? 64 : 48       # along the row
        off = sw ? 8 : 0         # a sideways tile is 48 deep in a 64 deep row
        a = offs[i - from]
        if rl == 0
          x = XL_BX + a
          y = by + XL_BH + r * 64 + off
        elsif rl == 2
          x = XL_BX + XL_BW - a - len
          y = by - (r + 1) * 64 + off
        elsif rl == 3
          x = XL_BX - XL_SIDE - (r + 1) * 64 + off
          y = by + XL_BH / 2 - 144 + a
        else
          x = XL_BX + XL_BW + XL_SIDE + r * 64 + off
          y = by + XL_BH / 2 + 144 - a - len
        end
        out << xl_tile_item(true, sw ? turned : base, e[0], x, y, e[2], same?(e[0]))
        ends[r] = XL_BX + a + len if rl == 0
        i += 1
      end
      r += 1
    end
    @xl_r0_ends = ends if rl == 0
    @xl_r1_rows = r if rl == 1
    out
  end

  # The own melds, from the right edge leftwards (the first call rightmost).
  def xl_own_meld_items(seat)
    out = []
    ms = xl_melds(seat)
    cx = XL_RIGHT
    k = 0
    while k < ms.size
      kind = ms[k][0]
      tl = ms[k][2]
      n = kind == 5 ? 3 : tl.size
      si = xl_sideways_index(kind, ms[k][1], tl.size)
      w = 0
      j = 0
      while j < n
        w += j == si ? 64 : 48
        j += 1
      end
      x = cx - w
      j = 0
      while j < n
        c = tl[j]
        c = 37 if kind == 3 && (j == 0 || j == n - 1)
        if j == si
          out << xl_tile_item(true, 3, c, x, XL_HAND_Y + 112 - 48, 0, same?(c))
          out << xl_tile_item(true, 3, tl[3], x, XL_HAND_Y + 112 - 96, 0, same?(tl[3])) if kind == 5
          x += 64
        else
          out << xl_tile_item(true, 0, c, x, XL_HAND_Y + 112 - 64, 0, same?(c))
          x += 48
        end
        j += 1
      end
      cx -= w + 8
      k += 1
    end
    out
  end

  # Where an item goes on a row: a along the row from its start (ox, oy),
  # len along it, t across it, against the screen's edge.
  def xl_place(rl, ox, oy, a, len, t)
    if rl == 2
      [ox - a - len, oy, len, t]
    elsif rl == 3
      [ox, oy + a, t, len]
    else
      [ox - t, oy - a - len, t, len]
    end
  end

  XL_ROW_START = [[380, 600], [1268, 596], [900, 10], [12, 52]]

  # A row of seat s at rl: the hand (backs; the drawn tile apart), then its
  # melds in small tiles, the first call at the far end. A spectator who
  # sees the hands has xl_spec_items instead.
  def xl_opp_items(s, rl)
    out = []
    o = XL_ROW_START[rl]
    base = xl_rot(rl)
    turned = (base + 3) % 4
    a = 0
    hc = @view["hc"].is_a?(Array) ? @view["hc"][s].to_i : 13
    i = 0
    while i < hc
      a += 8 if i == hc - 1 && hc % 3 == 2
      p = xl_place(rl, o[0], o[1], a, 32, 20)
      out << xl_side_item(rl, p[0], p[1])
      a += 32
      i += 1
    end
    a += 14
    ms = xl_melds(s)
    k = ms.size - 1
    while k >= 0
      kind = ms[k][0]
      tl = ms[k][2]
      n = kind == 5 ? 3 : tl.size
      si = xl_sideways_index(kind, ms[k][1], tl.size)
      j = 0
      while j < n
        c = tl[j]
        c = 37 if kind == 3 && (j == 0 || j == n - 1)
        sw = j == si
        p = sw ? xl_place(rl, o[0], o[1], a, 32, 24) : xl_place(rl, o[0], o[1], a, 24, 32)
        out << xl_tile_item(false, sw ? turned : base, c, p[0], p[1], 0, same?(c))
        # An added kan's tile on the sideways one, 8 px towards the table
        # (the row is 32 deep: MJ8).
        if sw && kind == 5
          d = XL_STACK[rl]
          out << xl_tile_item(false, turned, tl[3], p[0] + d[0], p[1] + d[1], 0, same?(tl[3]))
        end
        a += sw ? 32 : 24
        j += 1
      end
      a += 6
      k -= 1
    end
    out
  end

  # A spectator's row of seat s at rl (MJ10): the hand face up in the hand
  # tiles of the geometry (the drawn tile apart), then the melds, the first
  # call at the far end. Built as units [gap, length, pieces], each piece
  # [along, len, across (from the outer edge), depth, rot, code, same,
  # hand]; xl_spec_lay puts them on the screen.
  def xl_spec_items(s, rl)
    g = xg
    hl = g[:tile][0]
    hd = g[:tile][1]
    base = xl_rot(rl)
    turned = (base + 3) % 4
    units = []
    sp = spec_hand(s)
    hand = sp[0]
    i = 0
    while i < hand.size
      units << [0, hl, [[0, hl, 0, hd, base, hand[i], false, true]]]
      i += 1
    end
    units << [g[:drawn_gap], hl, [[0, hl, 0, hd, base, sp[1], false, true]]] if sp[1] >= 0
    big = g[:big_melds]
    ul = big ? 48 : 24
    ud = big ? 64 : 32
    stack = big ? 16 : 8
    ms = xl_melds(s)
    k = ms.size - 1
    gap = 14
    while k >= 0
      kind = ms[k][0]
      tl = ms[k][2]
      n = kind == 5 ? 3 : tl.size
      si = xl_sideways_index(kind, ms[k][1], tl.size)
      pieces = []
      a = 0
      j = 0
      while j < n
        c = tl[j]
        c = 37 if kind == 3 && (j == 0 || j == n - 1)
        if j == si
          pieces << [a, ud, 0, ul, turned, c, same?(c), false]
          # An added kan's tile on the sideways one, towards the table.
          pieces << [a, ud, stack, ul, turned, tl[3], same?(tl[3]), false] if kind == 5
          a += ud
        else
          pieces << [a, ul, 0, ud, base, c, same?(c), false]
          a += ul
        end
        j += 1
      end
      units << [gap, a, pieces]
      gap = big ? 12 : 6
      k -= 1
    end
    xl_spec_lay(rl, units)
  end

  # The units of a spectator's row on the screen: one line, or (lines 2)
  # a second line towards the table from the unit that starts past the
  # middle of the row or would not fit the line (a meld is never split).
  # A line longer than the room closes up (close_up).
  def xl_spec_lay(rl, units)
    g = xg
    o = g[:rows][rl]
    depth = g[:tile][1] + 4
    total = 0
    i = 0
    while i < units.size
      total += units[i][0] + units[i][1]
      i += 1
    end
    # The first unit of the second line (units.size: none).
    cut = units.size
    a = 0
    i = 0
    while g[:lines] > 1 && i < units.size
      start = a + units[i][0]
      if i > 0 && (start * 2 >= total || start + units[i][1] > g[:room])
        cut = i
        break
      end
      a = start + units[i][1]
      i += 1
    end
    out = []
    big = g[:big_melds]
    line = 0
    from = 0
    while from < units.size
      to = line == 0 ? cut : units.size
      lens = []
      i = from
      while i < to
        lens << (i == from ? 0 : units[i][0]) + units[i][1]
        i += 1
      end
      offs = close_up(lens, g[:room])
      i = from
      while i < to
        u = units[i]
        start = offs[i - from] + (i == from ? 0 : u[0])
        ps = u[2]
        j = 0
        while j < ps.size
          pc = ps[j]
          r = xl_spec_place(rl, o, start + pc[0], pc[1], line * depth + pc[2], pc[3])
          out << (pc[7] ? xl_spec_tile(pc[4], pc[5], r[0], r[1]) : xl_tile_item(big, pc[4], pc[5], r[0], r[1], 0, pc[6]))
          j += 1
        end
        i += 1
      end
      from = to
      line += 1
    end
    out
  end

  # A spectator's hand tile (the river's 48x64 here).
  def xl_spec_tile(rot, c, x, y)
    xl_tile_item(true, rot, c, x, y, 0)
  end

  # Where a piece of a spectator's row goes: along the row from its start
  # o (on the screen's edge, at the player's left), across from that edge.
  def xl_spec_place(rl, o, al, len, across, d)
    if rl == 0
      [o[0] + al, o[1] - across - d, len, d]
    elsif rl == 2
      [o[0] - al - len, o[1] + across, len, d]
    elsif rl == 3
      [o[0] + across, o[1] + al, d, len]
    else
      [o[0] - across - d, o[1] - al - len, d, len]
    end
  end

  def xl_hand_items
    out = []
    h = hand_codes
    n = h.size + (drawn >= 0 ? 1 : 0)
    pick = @pick
    i = 0
    while i < n
      c = hand_at(i)
      x = XL_HAND_X + i * 84
      x += 12 if i >= h.size
      y = XL_HAND_Y - (i == @sel ? XL_LIFT : 0)
      hm = help_mark(c)
      mark = hm == :tenpai ? 3 : (hm == :keep ? 4 : (pick && !can_discard?(c) ? 2 : 0))
      out << xl_hand_item(c, x, y, mark, i == @sel)
      i += 1
    end
    out
  end

  def xl_hand_index_at(x, y)
    return nil if y < XL_HAND_Y - XL_LIFT || y >= XL_HAND_Y + 112
    n = hand_codes.size + (drawn >= 0 ? 1 : 0)
    i = 0
    while i < n
      hx = XL_HAND_X + i * 84
      hx += 12 if i >= hand_codes.size
      return i if x >= hx && x < hx + 84
      i += 1
    end
    nil
  end

  def overlap?(a, b)
    a[0] < b[0] + b[2] && b[0] < a[0] + a[2] && a[1] < b[1] + b[3] && b[1] < a[1] + a[3]
  end

  # Everything of the table that is made of items, by part.
  def xl_parts
    parts = {}
    s = 0
    while s < 4
      rl = rel(s)
      parts["r#{rl}"] = xl_river_items(rl, xl_river_list(s))
      if @xl_spec
        parts["o#{rl}"] = xl_spec_items(s, rl)
      elsif rl != 0
        parts["o#{rl}"] = xl_opp_items(s, rl)
      end
      s += 1
    end
    if @xl_spec
      return parts
    elsif @seat
      parts["m"] = xl_own_meld_items(@seat)
      parts["h"] = xl_hand_items
    else
      # Watching a host without the hands: seat 0's hand face down.
      parts["m"] = xl_own_meld_items(0)
      hc = @view["hc"].is_a?(Array) ? @view["hc"][0].to_i : 0
      hs = []
      i = 0
      while i < hc
        hs << xl_hand_item(37, XL_HAND_X + i * 84 + (i == hc - 1 && hc % 3 == 2 ? 12 : 0), XL_HAND_Y, 0)
        i += 1
      end
      parts["h"] = hs
    end
    parts
  end

  def xl_draw
    @xl_n_items = 0
    @xl_n_px = 0
    spec = xl_spec?
    @xl_spec = spec
    @xg = spec ? XL_SPEC : XL_SEAT
    # A win's result waits while its shout shows (MJ6).
    res = @shout ? nil : (@view["res"] || @view["fin"])
    # The result's steps, seconds and OKs (MJ9) draw it again; so does
    # the round's name going.
    screen = res ? "result #{@view['sv']} #{@view['st']} #{rv_sig}" : (@intro_until ? "intro" : (spec ? "spec" : "table"))
    full = @xl_items.nil? || @xl_screen != screen
    # A result stays as drawn (its box covers the table) until it goes.
    return if res && !full
    @xl_screen = screen
    if full
      clear_user_area(C_FELT)
      @xl_n_px += @w * @h
      @xl_items = {}
      @xl_sig = {}
      @xl_btn_rects = []
      @xl_shouts = nil
    end
    parts = xl_parts
    clears = []
    draws = []
    parts.each do |key, items|
      old = @xl_items[key] || []
      n = items.size > old.size ? items.size : old.size
      i = 0
      while i < n
        a = old[i]
        b = items[i]
        if a != b
          clears << xl_extent(a) if a
          draws << b if b
        end
        i += 1
      end
    end
    # A part the new screen does not have (the own hand and melds when a
    # seated table turns into watching, the bottom row the other way) goes
    # as a whole.
    @xl_items.each do |key, old|
      next if parts[key]
      i = 0
      while i < old.size
        clears << xl_extent(old[i])
        i += 1
      end
    end
    # The texts: the board, the status lines, the buttons.
    board = xl_board_sig
    status = xl_status_sig
    btns = xl_button_sig
    help = xl_waits_sig
    redraw_board = full || board != @xl_sig[:board]
    redraw_status = full || status != @xl_sig[:status]
    redraw_btns = full || btns != @xl_sig[:btns]
    redraw_help = full || help != @xl_sig[:help]
    if redraw_btns
      i = 0
      while i < @xl_btn_rects.size
        clears << @xl_btn_rects[i]
        i += 1
      end
    end
    clears << xg[:status] if redraw_status && !full
    clears << XL_WAITS if redraw_help && !full && @xl_sig[:help]
    # A shout that went (or changed) leaves what was under it to redraw.
    shout = @shout ? [@shout[0], @shout[1]] : nil
    shout_new = full || shout != @xl_sig[:shout]
    if shout_new && @xl_shouts
      @xl_shouts.each do |r|
        clears << r
        redraw_board = true if overlap?(r, [@x0 + XL_BX, @y0 + xg[:by], XL_BW, XL_BH])
        redraw_status = true if overlap?(r, xg[:status])
      end
      @xl_shouts = nil
    end
    i = 0
    while i < clears.size
      c = clears[i]
      @gfx.fill_rect(c[0], c[1], c[2], c[3], C_FELT)
      @xl_n_px += c[2] * c[3]
      i += 1
    end
    # Unchanged items a clear touched are drawn again.
    unless full || clears.empty?
      parts.each do |key, items|
        old = @xl_items[key] || []
        i = 0
        while i < items.size
          it = items[i]
          if old[i] == it
            j = 0
            while j < clears.size
              if overlap?(xl_extent(it), clears[j])
                draws << it
                break
              end
              j += 1
            end
          end
          i += 1
        end
      end
      j = 0
      while j < clears.size && !redraw_help
        redraw_help = true if help && overlap?(XL_WAITS, clears[j])
        j += 1
      end
      j = 0
      while j < clears.size && !redraw_btns
        k = 0
        while k < @xl_btn_rects.size
          redraw_btns = true if overlap?(@xl_btn_rects[k], clears[j])
          k += 1
        end
        j += 1
      end
    end
    i = 0
    while i < draws.size
      xl_draw_item(draws[i])
      i += 1
    end
    @xl_items = parts
    if redraw_board
      xl_draw_board
      @xl_sig[:board] = board
    end
    if redraw_status
      xl_draw_status
      @xl_sig[:status] = status
    end
    if redraw_help
      xl_draw_waits(help) if help && !res
      @xl_sig[:help] = res ? nil : help
    end
    if res
      xl_draw_result if full
      @xl_btn_rects = []
      @xl_sig[:btns] = btns
      return
    end
    if redraw_btns
      @hits.clear
      @xl_btn_rects = []
      xl_draw_assist
      xl_draw_buttons
      @xl_sig[:btns] = btns
    elsif clock_parts != @xl_sig[:clock]
      xl_draw_clock
    end
    # The shout over everything, again whenever something was drawn.
    if @shout && (shout_new || !draws.empty? || redraw_board || redraw_btns || redraw_status)
      @xl_shouts = draw_shout
    end
    @xl_sig[:shout] = shout
    draw_intro if @intro_until && (full || !draws.empty? || redraw_board || redraw_status)
  end

  def xl_board_sig
    v = @view
    [v["r"], v["sc"], v["nm"], v["ri"], v["aw"], v["dora"], v["st"], @seat, v["sk"], @mk]
  end

  def xl_status_sig
    [status_line.to_s, @pick]
  end

  # The help: nil (nothing shown), [:hint] (the marks are on, no tenpai
  # discard chosen), [:keep] (level 3, no tile with its acceptance chosen),
  # the chosen tile and its waits, or [:uk, tile, shanten, acceptance].
  def xl_waits_sig
    return nil if @seat.nil?
    unless @waits.empty?
      w = sel_waits
      return [:hint] unless w
      return [hand_at(@sel), w]
    end
    return nil if @uk.empty?
    u = sel_uk
    return [:keep, @uk_min] unless u
    [:uk, hand_at(@sel), u[0], u[1]]
  end

  # The riichi help over XL_WAITS: the waits of the chosen discard (each
  # with what is left of it unseen) and their sum, or a line that says what
  # the marks mean.
  def xl_draw_waits(sig)
    x = @x0 + XL_WAITS[0]
    y = @y0 + XL_WAITS[1]
    fnt(16, 1)
    if sig[0] == :hint || sig[0] == :keep
      keep = sig[0] == :keep
      tenpai_mark(x + 4, y + 12, 24, 8, keep ? C_KEEP : C_TURN)
      text(x + 32, y + 16, keep ? "#{t(:mj_keep)} (#{sig[1]}#{t(:mj_shanten)})" : t(:mj_help), C_DIM)
      return
    end
    @gfx.fill_round_rect(x, y, XL_WAITS[2], XL_WAITS[3], 6, C_BOX)
    @gfx.draw_round_rect(x, y, XL_WAITS[2], XL_WAITS[3], 6, C_TURN)
    @xl_n_px += XL_WAITS[2] * XL_WAITS[3]
    if sig[0] == :uk
      if sig[2] == 0
        text(x + 10, y + 16, t(:mj_no_wait), C_RED)
        return
      end
      xl_tiles_counts(x, y, "#{sig[2]}#{t(:mj_shanten)}", sig[2] == @uk_min ? C_TURN : C_DIM, sig[3],
                      "#{sig[3].size}#{t(:mj_kinds)} ")
      return
    end
    xl_tiles_counts(x, y, t(:mj_waits), C_TURN, sig[1], "")
  end

  # Tiles with what is left of each, then the sum, from x + lx in the help
  # box; the counts go when they do not fit, then the tiles close up, and
  # past what fits at 24 px the sum goes up and the tiles' names go below it.
  def xl_tiles_counts(x, y, head, hcol, w, pre)
    lx = tw(head) + 22
    sum = 0
    i = 0
    while i < w.size
      sum += w[i][1]
      i += 1
    end
    tail = "#{pre}#{t(:mj_total)}#{sum}#{t(:mj_mai)}"
    room = XL_WAITS[2] - lx - tw(tail) - 16
    counts = w.size * 42 <= room
    step = counts ? 42 : (w.size * 28 <= room ? 28 : 24)
    if w.size * step > room
      # Too many for the tiles: the sum on the first line, the names below.
      text_spaced(x + 10, y + 6, head, hcol)
      text_spaced(x + lx, y + 6, tail, sum == 0 ? C_RED : C_TURN)
      fnt(12, 1)
      cx = x + 10
      i = 0
      while i < w.size && cx + 18 <= x + XL_WAITS[2] - 6
        text(cx, y + 30, tile_text(w[i][0]), C_TEXT)
        cx += 18
        i += 1
      end
      return
    end
    n = w.size
    text_spaced(x + 10, y + 16, head, hcol)
    cx = x + lx
    i = 0
    while i < n
      xl_draw_item(xl_tile_item(false, 0, w[i][0], cx, y + 8, 0))
      text(cx + 26, y + 16, w[i][1].to_s, w[i][1] == 0 ? C_RED : C_TEXT) if counts
      cx += step
      i += 1
    end
    text_spaced(cx + 6, y + 16, tail, sum == 0 ? C_RED : C_TURN)
  end

  def xl_button_sig
    [@view["a"], @seat.nil?, @assist, xl_btn_lefts, clock_parts ? true : false]
  end

  # The centre board: the round, the honba and the sticks, what is left of
  # the wall, the dora indicators, and each seat's wind, name and points on
  # the side that faces it. Rows (from the top): the seat across, the round
  # with the side seats' names and points beside it, the dora, the honba
  # line, the own seat.
  def xl_draw_board
    v = @view
    bx = @x0 + XL_BX
    by = @y0 + xg[:by]
    @gfx.fill_rect(bx, by, XL_BW, XL_BH, C_BOARD)
    @gfx.draw_rect(bx, by, XL_BW, XL_BH, C_DIM)
    @xl_n_px += XL_BW * XL_BH
    r = v["r"]
    return unless r.is_a?(Array)
    fnt(16, 2)
    head = "#{WIND[r[0].to_i % 4]}#{r[1]}#{t(:mj_kyoku)}"
    text(bx + (XL_BW - tw(head)) / 2, by + 24, head)
    fnt(16, 1)
    line = "#{r[2]}#{t(:mj_honba)}  #{t(:mj_sticks)}#{r[3]}"
    line = "#{line}  #{t(:mj_left)}#{r[5]}" if r.size > 5
    text(bx + (XL_BW - tw(line)) / 2, by + 110, line, C_TEXT)
    d = bytes_of(v["dora"])
    dl = tw(t(:mj_dora)) + 6 + d.size * 24
    dx = bx + (XL_BW - dl) / 2
    text(dx, by + 80, t(:mj_dora), C_TEXT)
    dx += tw(t(:mj_dora)) + 6
    i = 0
    while i < d.size
      xl_draw_item(xl_tile_item(false, 0, d[i], dx + i * 24, by + 72, 0, same?(d[i])))
      i += 1
    end
    nm = v["nm"].is_a?(Array) ? v["nm"] : []
    sc = v["sc"].is_a?(Array) ? v["sc"] : []
    ri = v["ri"].to_i
    cur = r.size > 6 ? r[6].to_i : -1
    s = 0
    while s < 4
      rl = rel(s)
      col = away?(s) ? C_AWAY : (s == cur && v["st"] == "play" ? C_TURN : C_TEXT)
      name = s == @seat ? t(:mj_you) : nm[s].to_s
      head = "#{wind_of(s)} "
      pts = sc[s].to_s
      stick = (ri >> s) & 1 == 1
      turn = s == cur && v["st"] == "play"
      if rl == 0 || rl == 2
        label = "#{head}#{fit(name, 100)}  #{pts}"
        lw = tw(label) + (stick ? 54 : 0)
        lx = bx + (XL_BW - lw) / 2
        ly = rl == 0 ? by + XL_BH - 24 : by + 4
        text(lx, ly, label, col)
        @gfx.fill_rect(lx, ly + 17, tw(label), 2, C_TURN) if turn
        xl_stick(lx + tw(label) + 6, ly + 5) if stick
      else
        label = "#{head}#{fit(name, 84 - tw(head))}"
        lw = tw(label) > tw(pts) ? tw(label) : tw(pts)
        lx = rl == 3 ? bx + 6 : bx + XL_BW - 6 - lw
        text(lx, by + 24, label, col)
        text(lx, by + 42, pts, col)
        @gfx.fill_rect(lx, by + 59, tw(pts), 2, C_TURN) if turn
        xl_stick(lx, by + 63) if stick
      end
      s += 1
    end
  end

  # A riichi stick (48x6, white with a red dot).
  def xl_stick(x, y)
    @gfx.fill_rect(x, y, 48, 6, C_TEXT)
    @gfx.fill_rect(x + 21, y + 1, 6, 4, C_RED)
  end

  # The status line: what the screen waits for (the time left is the
  # clock's, MJ6).
  def xl_draw_status
    st = xg[:status]
    x = @x0 + st[0]
    y = @y0 + st[1]
    fnt(16, 1)
    msg = status_line.to_s
    msg = "#{t(:mj_pick)} #{msg}" if @pick
    text(x + 4, y + 4, fit(msg, st[2] - 8), C_TURN) unless msg.strip.empty?
    @xl_n_px += st[2] * st[3]
  end

  # How far left each row of buttons may reach (XL_BTN_ROWS): clear of the
  # rows of the bottom river beside it, and the top row of the right river.
  def xl_btn_lefts
    e = @xl_r0_ends || [0, 0, 0, 0]
    r1 = @xl_r1_rows || 0
    out = [e[2], e[1] > e[2] ? e[1] : e[2], e[1], e[0]]
    out[3] = XL_BX + XL_BW + XL_SIDE + r1 * 64 if r1 > 0 && XL_BX + XL_BW + XL_SIDE + r1 * 64 > out[3]
    i = 0
    while i < out.size
      out[i] = out[i] + 8 < XL_BX ? XL_BX : out[i] + 8
      i += 1
    end
    out
  end

  # The help level, at the top left (nothing of the table reaches it).
  def xl_draw_assist
    return unless @seat
    fnt(12, 2)
    l = assist_label
    xl_button(B_ASSIST, [], 12, 8, tw(l) + 20, l)
  end

  # The buttons, right-aligned above the right end of the hand, the last at
  # the bottom right; a row that is full goes on in the row above (each row
  # clear of the bottom river beside it), and when four rows at the large
  # font are not enough, the font goes down.
  def xl_draw_buttons
    list = @view["a"].is_a?(Array) ? @view["a"] : []
    labels = []
    i = 0
    while i < list.size
      o = list[i]
      tl = bytes_of(o[1])
      l = call_label(o[0], tl)
      labels << [o[0], tl, l] if l
      i += 1
    end
    labels << [B_LEAVE, [], t(:mj_leave)] if @seat.nil?
    # The clock (MJ6) is the last, at the bottom right, by the drawn tile.
    labels << [B_CLOCK, [], nil] if clock_parts
    @xl_clock = nil
    lefts = xl_btn_lefts
    place = nil
    [[12, 2, 24], [16, 1, 16], [12, 1, 12]].each do |px, size, pad|
      next if place
      fnt(px, size)
      place = xl_pack_buttons(labels, lefts, pad)
    end
    # Still too many (every call at once): the buttons without their keys
    # ("[C]") at the small font, before giving up the river's room.
    unless place
      labels = labels.map { |l| [l[0], l[1], key_less(l[2])] }
      place = xl_pack_buttons(labels, lefts, 12)
    end
    place ||= xl_pack_buttons(labels, [XL_BX] * 4, 12)
    i = 0
    while i < place.size
      p = place[i]
      if labels[i][0] == B_CLOCK
        @xl_clock = [p[0], p[1], p[2], 40]
        @xl_btn_rects << @xl_clock
      else
        xl_button(labels[i][0], labels[i][1], p[0], p[1], p[2], labels[i][2])
      end
      i += 1
    end
    xl_draw_clock
  end

  # A label without its key hint at the end ("ãƒãƒ³[P]" -> "ãƒãƒ³"; a call's
  # [head, tiles, key] without the key). nil stays nil (the clock).
  def key_less(l)
    return [l[0], l[1], nil] if l.is_a?(Array)
    return l unless l.is_a?(String) && l.bytesize > 0 && l.getbyte(l.bytesize - 1) == 93 # "]"
    i = l.bytesize - 1
    while i > 0 && l.getbyte(i) != 91 # "["
      i -= 1
    end
    i > 0 ? l.byteslice(0, i) : l
  end

  XL_CLOCK_W = 120
  B_CLOCK = -1 # the clock's place among the buttons (not a button)

  # The clock in its place among the buttons (@xl_clock).
  def xl_draw_clock
    c = clock_parts
    r = @xl_clock
    @xl_sig[:clock] = c
    return unless c && r
    @gfx.fill_rect(r[0], r[1], r[2], r[3], C_FELT)
    clock_box(c, r[0], r[1], r[2], r[3], 16, 2)
    @xl_n_px += r[2] * r[3]
  end

  # [x, y, w] of each label in its row (nil: they do not fit).
  def xl_pack_buttons(labels, lefts, pad)
    out = []
    row = 0
    x = xg[:btn_right]
    i = labels.size - 1
    while i >= 0
      w = labels[i][2] ? btn_label_w(labels[i][2]) + pad : XL_CLOCK_W
      while x - w < lefts[row]
        row += 1
        x = xg[:btn_right]
        return nil if row >= xg[:btn_rows].size
      end
      x -= w
      out.unshift([x, xg[:btn_rows][row], w])
      x -= 8
      i -= 1
    end
    out
  end

  # Win buttons red, passing grey, the rest the usual colour (as in the sample).
  def xl_button(type, tiles, x, y, w, label)
    @hits.add(type, x, y, w, 40, tiles)
    @xl_btn_rects << [x, y, w, 40]
    col = type == A_RON || type == A_TSUMO ? C_BTN_WIN : (type == A_SKIP || type == B_LEAVE || type == B_ASSIST ? C_BTN_PASS : C_BTN)
    @gfx.fill_round_rect(x, y, w, 40, 8, col)
    btn_content(label, x, y, w, 40)
    @xl_n_px += w * 40
  end

  # A round's result (or the end of the game) in a box over the middle. One
  # block per winner; with three winners the tiles are the small ones. When
  # the blocks would not fit the screen, the yaku go in four columns of the
  # smaller font (xl_compact).
  def xl_draw_result
    res = @view["res"]
    fin = @view["fin"]
    wins = res.is_a?(Hash) && res["wn"].is_a?(Array) ? res["wn"] : []
    big = wins.size <= 2
    over = fin.is_a?(Array) && @view["st"] == "over"
    shown = rv_shown
    fnt(12, 2)
    @xl_compact = false
    hgt = xl_result_height(res, wins, fin, big, over)
    if hgt > @h - 8
      @xl_compact = true
      hgt = xl_result_height(res, wins, fin, big, over)
    end
    bw = 800
    bx = @x0 + (@w - bw) / 2
    by = @y0 + (@h - hgt) / 2
    by = @y0 + 4 if by < 4
    @gfx.fill_rect(bx, by, bw, hgt, C_BOX)
    @gfx.draw_rect(bx, by, bw, hgt, C_TURN)
    @xl_n_px += bw * hgt
    x = bx + 16
    y = by + 12
    if res.is_a?(Hash)
      k = res["k"].to_s
      text(x, y, round_head(res), C_DIM)
      y += 30
      if k == "tsumo_agari" || k == "ron_agari"
        i = 0
        before = 0
        while i < wins.size
          @rv_k = shown - before
          before += rv_steps(wins[i])
          y = xl_draw_win(wins[i], k, res["f"], x, y, big)
          i += 1
        end
      else
        text_spaced(x, y, fit(draw_head(res), bw - 32), C_TURN)
        y += 34
      end
      unless over
        # Every seat: wind, name (and tenpai at a draw), before -> after, the change.
        lh = @xl_compact ? 26 : 30
        i = shown < rv_total ? 4 : 0 # the points after the count (MJ9)
        while i < 4
          l = score_line(i, res)
          cy = y + i * lh
          text(x, cy, l[0])
          text(x + 400, cy, l[1], C_DIM)
          text(x + 640, cy, l[2], delta_color(i, res))
          i += 1
        end
        y += lh * 4 + 10
      end
    end
    if over
      text(x, y, over_head, C_TURN)
      y += 34
      i = 0
      while i < fin.size
        f = fin[i]
        text(x, y, fit(fin_line(f), bw - 32))
        y += 30
        i += 1
      end
      text(x, y, back_lobby_text, C_DIM)
    end
    # The buttons (next) at the bottom right of the box; with the OKs the
    # OK line (MJ9).
    @hits.clear
    @xl_btn_rects = []
    return ok_footer(bx, by, bw, hgt) if rv_on?
    list = @view["a"].is_a?(Array) ? @view["a"] : []
    bxr = bx + bw - 12
    i = list.size - 1
    while i >= 0
      l = button_label(list[i][0], bytes_of(list[i][1]))
      if l
        w = tw(l) + 24
        bxr -= w
        xl_button(list[i][0], bytes_of(list[i][1]), bxr, by + hgt - 50, w, l)
        bxr -= 8
      end
      i -= 1
    end
  end

  def xl_result_height(res, wins, fin, big, over)
    hgt = 24
    wins.each { |w| hgt += xl_win_height(w, big) }
    hgt += 30 if res.is_a?(Hash) # the round
    hgt += 34 if res.is_a?(Hash) && wins.empty?
    hgt += (@xl_compact ? 26 : 30) * 4 + 10 if res.is_a?(Hash) && !over
    hgt += 40 + fin.size * 30 + 34 if over
    hgt + 56
  end

  # The yaku: [columns, line height] (compact: four columns, 16 px font).
  def xl_yaku_grid
    @xl_compact ? [4, 20] : [3, 28]
  end

  def xl_win_height(w, big)
    ys = w["y"].is_a?(Array) ? w["y"].size : 0
    cols, lh = xl_yaku_grid
    c = @xl_compact
    (c ? 28 : 34) + (big ? 64 : 32) + (c ? 6 : 10) + ((ys + cols - 1) / cols) * lh + xl_pt_lines(w) * (c ? 26 : 30) + (c ? 2 : 6)
  end

  # The points line, and pao on a line of its own when both do not fit.
  def xl_pt_lines(w)
    pa = pao_text(w)
    return 1 if pa.empty?
    tw(w["pt"].to_s) + 8 + tw(pa) <= 768 ? 1 : 2
  end

  def xl_draw_win(w, k, from, x, y, big)
    ys = w["y"].is_a?(Array) ? w["y"] : []
    rk = @rv_k || 9999 # the steps of this winner shown (MJ9)
    text(x, y, fit(win_head(w, k, from), 768), C_TURN) if rk > 0
    y += @xl_compact ? 28 : 34
    hc = bytes_of(w["h"])
    tw_ = big ? 48 : 24
    i = 0
    while i < hc.size && rk > 0
      xl_draw_item(xl_tile_item(big, 0, hc[i], x + i * tw_, y, 0))
      i += 1
    end
    xl_draw_item(xl_tile_item(big, 0, w["ag"].to_i, x + hc.size * tw_ + 12, y, 1)) if rk > 0
    # The melds after the winning tile, smaller when they would not fit.
    ms = rk > 0 ? meld_lists(w["w"].to_i) : []
    n = 0
    ms.each { |m| n += m.size }
    cx = x + (hc.size + 1) * tw_ + 12
    big_m = big && cx + n * 48 + ms.size * 12 <= x + 768
    mw = big_m ? 48 : 24
    my = big_m || !big ? y : y + 32
    ms.each do |m|
      cx += 12
      m.each do |c|
        xl_draw_item(xl_tile_item(big_m, 0, c, cx, my, 0))
        cx += mw
      end
    end
    y += (big ? 64 : 32) + (@xl_compact ? 6 : 10)
    cols, lh = xl_yaku_grid
    cw = 768 / cols
    fnt(16, 1) if @xl_compact
    i = 0
    while i < ys.size && i < rk
      text_spaced(x + (i % cols) * cw, y + (i / cols) * lh, fit(yaku_label(w, i), cw - 8))
      i += 1
    end
    fnt(12, 2)
    y += ((ys.size + cols - 1) / cols) * lh
    pt = w["pt"].to_s
    pt_on = rk > ys.size
    text_spaced(x, y, fit(pt, 768), C_TURN) if pt_on
    pa = pao_text(w)
    unless pa.empty?
      if xl_pt_lines(w) == 1
        text_spaced(x + tw(pt) + 8, y, pa, C_AWAY) if pt_on
      else
        y += @xl_compact ? 26 : 30
        text_spaced(x, y, fit(pa.strip, 768), C_AWAY) if pt_on
      end
    end
    y + (@xl_compact ? 28 : 36)
  end
end
