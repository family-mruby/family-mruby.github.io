    # The host's answers (act, sit, ...) that the screen shows.
    @reasons = {
      "token" => "å“ã®äººã§ã¯ãªã„", "not seated" => "å¸­ã«ç€ã„ã¦ã„ãªã„", "stale" => "ç”»é¢ãŒå¤ã„: èª­ã¿ç›´ã—ä¸­",
      "not offered" => "ä»Šã¯ã§ããªã„", "not playing" => "å¯¾å±€ä¸­ã§ã¯ãªã„", "not waiting" => "å¾…ã¡åˆã‚ã›ä¸­ã§ã¯ãªã„",
