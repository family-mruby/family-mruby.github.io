enable = true
# hostname = "fmruby"        # ÁúÅ„Åè„Å® fmruby-XXXXXX (MAC „ÅÆÊú´Â∞æ)

[[networks]]                 # Êñ∞„Åó„ÅÑ„ÇÇ„ÅÆ„ÅåÂÖà„ÄÅ5 „Å§„Åæ„Åß
ssid = "home"
password = "„Éë„Çπ„ÉØ„Éº„Éâ"

[[networks]]
