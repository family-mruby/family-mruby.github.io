    setup_rule_strings
  end

  def t(k)
    @str[k] || k.to_s
  end

  # A reply of the host as the screen says it.
  def reason(r)
    s = r.to_s
    @reasons[s] || s
  end

  # ------------------------------------------------------------ start

  def on_create
    setup_strings
    @gfx.set_font(:ja, 12)
    @started = Machine.board_millis
    @dirty = true
    @keys = []
    @clicks = []
    @hits = FmrbUI::HitAreas.new
    @unsupported = FmrbConst::HW_FAMILY != "modern"
    @hand_sheet = nil
    @river_sheet = nil
    @xl_sheets = false
    @turned = nil           # the small tiles in four turns (load_turned_sheets)
    @xl_items = nil         # the 1280x720 table's drawn items (nil: draw it all)
    @fw = 12                # the full-width character width of the text drawn now
    @perf_on = perf_wanted?
    @perf = []
    @xl_n_items = 0         # what the last drawing of the 1280x720 table drew
    @xl_n_px = 0
    layout
    if @unsupported
      draw_screen
      return
    end
    @river_sheet = load_sheet("tiles_river.bmp", 240, 128)
    load_hand_sheet
    load_xl_sheets
    st = ::FmrbAsterism.settings
    # The tables ("<host>/games/mahjong*", tables[p] = {st, sk, mb} from its
    # last put, {} before one), the table this app is at, its token: the
    # table client's.
    @tc = ::FmrbAsterism::TableClient.new(self, "mahjong", tag: "mahjong", settings: st, blank: {})
    @assist = load_assist
    @name_machine = st.name.to_s       # config.toml's name: what the first name prompt starts from
    @name = @name_set || (@name_machine.empty? ? st.node : @name_machine) # shown; join waits for @name_set
    @pending_join = nil
    @join_to = nil        # the table the last join went to (the refusal names it)
    @name_edit = nil      # the name being typed in the lobby (nil: not editing)
    @rename_f = nil
    @list_sel = 0
    @probed = []          # tables asked mine()
    @mine = {}            # tables where this node has a seat (marked in the list)
    @probe_f = nil
    @probe_path = nil
    @probe_at = Machine.board_millis
    @seat = nil           # nil: no seat (the lobby or watching)
    @act_f = nil
    @cmd_f = nil
    @view = nil
    @host_away = false    # the host did not answer a call (its state puts clear it)
    @note = ""
    @sel = -1             # the chosen hand tile (lifted): by the keys or under the mouse
    @mouse_sel = false    # @sel follows the mouse (moving off the hand drops it)
    @move = nil           # the last mouse position not yet looked at
    @waits = {}           # the help: discard tile => [[wait, left], ...] (the view's "wt")
    @uk = {}              # the help (level 3): discard tile => [shanten, [[tile, left], ...]] (the view's "uk")
    @uk_min = 9           # the least shanten after a discard (the tiles marked)
    @hand_redraw = nil    # the 640x360 table: only these hand tiles changed
    @pick = false         # choosing the riichi tile
    @act_t0 = nil         # when the last action was sent (for the latency)
    @act_sv = 0
    @lat = nil
    @deadline = nil
    @bank_ms = 0          # the bank's ms in the time left of the own move (README "Time")
    @others = false       # the host waits for other seats' calls
    @second = 0
    @mem_at = 0
    @title_until = Machine.board_millis + TITLE_MS # the title (MJ8) while the network comes up
    require "#{APP_DIR}/mahjong_sound" # MJ11: wraps some methods, so after the class body
    snd_start
    draw_screen
  end

  def on_resize(w, h)
    layout
    unless @unsupported
      load_hand_sheet
      load_xl_sheets
    end
    @xl_items = nil
    @dirty = true
  end

  def layout
    @x0 = @user_area_x0
    @y0 = @user_area_y0
    @w = @user_area_width
    @h = @user_area_height
    @big = @w >= 640 && @h >= 360
    @xl = @w >= 1280 && @h >= 720
    @k = @xl ? 2 : 1        # the lists and the lobby: the 640x360 screens at twice the size
  end

  # A sheet as a SpriteImage, or nil (the tiles are then drawn as text).
  # dir: a directory under APP_DIR (the cache keeps the file name only).
  def load_sheet(name, w, h, dir = "")
    t0 = Machine.board_millis
    @gfx.sync_file("#{APP_DIR}/#{dir}#{name}", dest: "#{CACHE_DIR}/#{name}")
    img = SpriteImage.new(@gfx, width: w, height: h, transparent_color: KEY_COLOR, use_transparent: true)
    img.load_bmp("#{CACHE_DIR}/#{name}")
    Log.info("mahjong: tiles: #{name} #{Machine.board_millis - t0} ms")
    img
  rescue => e
    Log.error("mahjong: tiles: #{name}: #{e.message}")
    nil
  end

  # The hand sheet and mahjong_640.rb, the first time the table is big (the
  # 640x360 table).
  def load_hand_sheet
    return unless @big && !@xl
    m640_load
    @hand_sheet = load_sheet("tiles_hand.bmp", 420, 224) if @hand_sheet.nil?
  end

  # ------------------------------------------------------------ network
  # The connection, the list, joining and the view are @tc's
  # (FmrbAsterism::TableClient); these are its calls and the game's own.

  # A put of a mahjong table: {st, sk, mb} for the list (a table not put
  # yet keeps {}); at this table the host is there, and before the token
  # the put is the view.
  def table_state(p, pv)
    @host_ver = pv["hv"].to_s if pv["hv"].is_a?(String)
    @dirty = true if @tc.table.nil?
    if p == @tc.table
      @host_away = false
      @view = pv if @tc.token.nil?
    end
    { "st" => pv["st"], "sk" => pv["sk"], "mb" => (pv["mb"].is_a?(Array) ? pv["mb"].size : 0) }
  end

  # A host's tables left the list: their marks go too.
  def tables_changed(added)
    unless added
      l = @tc.table_list
      @mine.keys.each { |p| @mine.delete(p) if l.index(p).nil? }
      @probed = @probed.select { |p| l.index(p) }
      @list_sel = 0 if @list_sel >= l.size
    end
    @dirty = true
  end

  def table_link_up(link)
    @dirty = true
  end

  def table_link_down(link)
    @act_f = nil
    @cmd_f = nil
    @probe_f = nil
    @dirty = true
  end

  def table_host_gone
    @dirty = true
  end

  def table_host_back
    @host_away = false
    @dirty = true
  end

  # The help level always goes with the call (asterism-games README "Assist").
  def table_ask_view(px, token)
    px.view(token, @assist)
  end

  def table_view(v)
    @host_away = false
    take_view(v)
  end

  def table_view_failed
    @host_away = true
    Log.info("mahjong: view: no answer")
    @dirty = true
  end

  # The host lost our membership (a new state): back to the list, without
  # a leave (it does not know the token).
  def table_dropped
    @tc.forget
    @seat = nil
    @view = nil
    @probed = []
    @mine = {}
    @host_away = false
    @dirty = true
  end

  # A table found for the first time (and every table again every
  # PROBE_EVERY_MS while the list is shown): was this node at it (the app
  # started again, or the host seated it)? Then the list marks it; Enter
  # goes back to the seat (join gives the same node its token back). The
  # app does not go in by itself, so a player who wants to watch another
  # table is not taken back to its own.
  def probe_tables
    if @probe_f
      return unless @probe_f.done?
      f = @probe_f
      p = @probe_path
      @probe_f = nil
      begin
        r = f.value
        had = @mine[p]
        if r.is_a?(Hash) && r["token"]
          @mine[p] = true
        else
          @mine.delete(p)
        end
        @dirty = true if had != @mine[p]
      rescue ::Asterism::Error => e
        @probed.delete(p) # ask again later
      end
      return
    end
    now = Machine.board_millis
    if now - @probe_at >= PROBE_EVERY_MS
      @probe_at = now
      @probed = []
    end
    l = @tc.table_list
    i = 0
    while i < l.size
      p = l[i]
      if @probed.index(p).nil?
        @probed << p
        @probe_path = p
        @probe_f = @tc.proxy(p).async.mine
        return
      end
      i += 1
    end
  rescue ::Asterism::Error => e
    @probe_f = nil
  end

  def join(p)
    return if @tc.joining? || p.nil?
    # A name first (MJ5): the table shows it; asked once, kept on this machine.
    unless @name_set
      @pending_join = p
      name_begin
      return
    end
    @join_to = p
    err = @tc.join(p, @name)
    @note = err if err
    @dirty = true
  end

  def table_joined(r)
    s = r["seat"].to_i
    @seat = s >= 0 ? s : nil
    @view = nil
    @host_away = false
    @note = ""
    @dirty = true
  end

  def table_refused(why)
    @note = if why.nil? then t(:mj_host_away)
            elsif why == "full" then "#{t(:mj_full)}: #{@join_to}"
            else reason(why)
            end
    @dirty = true
  end

  # Back to the list of tables.
  def leave_table
    @tc.leave
    @seat = nil
    @view = nil
    @act_f = nil
    @cmd_f = nil
    @note = ""
    @dirty = true
  end

  def take_view(v)
    old = @view
    @view = v
    me = v["me"]
    @seat = me.is_a?(Integer) && me >= 0 ? me : nil
    # dl: the seats whose time runs (bits), the ms left, the bank's ms.
    # (nil first: the app's VM calls deconstruct on whatever it is given,
    # so an array pattern must not meet a nil.)
    bits, left, bank = case v["dl"]
                       in nil then [0, 0, 0]
                       in [Integer => b, Integer => l, Integer => k, *] then [b, l, k]
                       in [Integer => b, Integer => l] then [b, l, 0]
                       else [0, 0, 0]
                       end
    mine = @seat ? (1 << @seat) : 0
    @deadline = bits & mine != 0 ? Machine.board_millis + left : nil
    @bank_ms = @deadline ? bank : 0
    # In the calls, the screen waits for the others whenever this seat has
    # nothing (more) to answer; who they are it is not told (a host before
    # MJ5 gives their bits, this one the three others' alike).
    @others = bits & mine == 0
    @pick = false unless offer(A_RIICHI)
    @waits = parse_waits(v["wt"])
    parse_uk(v["uk"])
    n = hand_codes.size
    @sel = -1 if @sel >= n
    if @act_t0 && v["sv"].to_i > @act_sv
      @lat_pending = Machine.board_millis - @act_t0
      @act_t0 = nil
    end
    took_view(v, old)
    @dirty = true if old.nil? || old["v"] != v["v"]
  end

  # The view's "wt" (asterism-games README "Views"): per riichi discard the
  # tile, the number of waits n and n pairs [wait, left].
  def parse_waits(s)
    out = {}
    b = bytes_of(s)
    i = 0
    while i + 1 < b.size
      n = b[i + 1]
      list = []
      j = 0
      while j < n
        list << [b[i + 2 + j * 2], b[i + 3 + j * 2]]
        j += 1
      end
      out[b[i]] = list
      i += 2 + n * 2
    end
    out
  end

  # The view's "uk": per discard the tile, the shanten after it, n and n
  # pairs [tile, left] (the tiles that bring the shanten down).
  def parse_uk(s)
    @uk = {}
    @uk_min = 9
    b = bytes_of(s)
    i = 0
    while i + 2 < b.size
      n = b[i + 2]
      list = []
      j = 0
      while j < n
        list << [b[i + 3 + j * 2], b[i + 4 + j * 2]]
        j += 1
      end
      @uk[b[i]] = [b[i + 1], list]
      @uk_min = b[i + 1] if b[i + 1] < @uk_min
      i += 3 + n * 2
    end
  end

  # The acceptance after discarding the chosen tile, [shanten, list] or nil.
  def sel_uk
    return nil if @uk.empty? || @sel < 0
    c = hand_at(@sel)
    c ? @uk[c] : nil
  end

  # The mark of hand tile c: :tenpai (a discard that leaves it tenpai),
  # :keep (level 3: one that keeps the least shanten) or nil.
  def help_mark(c)
    return :tenpai if @waits[c]
    u = @uk[c]
    u && u[0] == @uk_min ? :keep : nil
  end

  # ------------------------------------------------------------ the help level

  # /home/mahjong.toml (app_settings): "assist = N" and the player's name
  # ("name = \"...\"", mahjong_panels.rb). Sets @name_set too.
  def load_assist
    conf = app_settings
    @name_set = nil
    n = conf["name"]
    if n.is_a?(String)
      n = clean_player_name(n)
      @name_set = n unless n.empty?
    end
    lv = conf["assist"]
    lv = ASSIST_DEFAULT unless lv.is_a?(Integer)
    lv < 0 || lv > ASSIST_MAX ? ASSIST_DEFAULT : lv
  end

  # Writes the help level, the name (none: the line goes) and the sound
  # switches into /home/mahjong.toml. Only those lines change
  # (save_app_settings, FmrbToml.update): the player's comments and any
  # other line stay. A new file starts with a comment that says what is in it.
  def save_assist
    v = { "assist" => @assist, "name" => @name_set }
    snd_settings(v) if @snd_conf
    path = app_settings_path
    unless File.exist?(path)
      begin
        File.open(path, "w") do |f|
          f.write("# The mahjong table: assist (help, 0 none, 1 riichi, 2 tenpai, 3 shanten),\n" \
                  "# name (shown at the table; none: the machine's), bgm (0 off, 1 low, 2 mid,\n" \
                  "# 3 high), se and voice (true / false)\n")
        end
      rescue => e
        Log.info("mahjong: #{path}: #{e.message}")
        return
      end
    end
    Log.info("mahjong: #{FmrbToml.error}") unless save_app_settings(v)
  end

  # The next level (3 goes back to 0); the view is asked again at once.
  def cycle_assist
    @assist = @assist >= ASSIST_MAX ? 0 : @assist + 1
    save_assist
    @waits = {}
    @uk = {}
    @uk_min = 9
    @tc.refresh_view
    @xl_items = nil
    @dirty = true
    Log.info("mahjong: assist #{@assist}")
  end

  def assist_label
    "#{t(:mj_assist)}: #{@assist_names[@assist]}[A]"
  end

  # The waits after discarding the chosen tile (nil: no riichi help for it).
  def sel_waits
    return nil if @waits.empty? || @sel < 0
    c = hand_at(@sel)
    c ? @waits[c] : nil
  end

  # Sends an action; tiles are tile numbers.
  def act(type, tiles)
    return if @act_f || @tc.token.nil? || @view.nil?
    s = ("\x00" * tiles.size).b
    i = 0
    while i < tiles.size
      s.setbyte(i, tiles[i])
      i += 1
    end
    @act_t0 = Machine.board_millis
    @act_type = type
    @act_sv = @view["sv"].to_i
    @act_f = @tc.proxy.async.act(@tc.token, @act_sv, type, s)
    @pick = false
  rescue ::Asterism::Error => e
    @act_f = nil
    @note = e.message.to_s
    @dirty = true
  end

  def collect_act
    f = @act_f
    return unless f && f.done?
    @act_f = nil
    begin
      r = f.value
      if r == "ok"
        @tc.ask_view
      else
        @note = reason(r)
        @act_t0 = nil
        @tc.ask_view
        @dirty = true
      end
    rescue ::Asterism::Error => e
      @host_away = true
      @act_t0 = nil
      @dirty = true
    end
  end

  # A lobby call: sit / stand / cpu / start; ai (a kind of "ak") puts that
  # AI player in the seat (in place of the CPU or AI player there).
  def lobby(kind, seat, ai = nil)
    tok = @tc.token
    return if @cmd_f || tok.nil?
    px = @tc.proxy.async
    @cmd_f = if kind == B_SIT then px.sit(tok, seat)
             elsif kind == B_STAND then px.stand(tok)
             elsif kind == B_CPU_ON then px.cpu(tok, seat, ai || true)
             elsif kind == B_CPU_OFF then px.cpu(tok, seat, false)
             elsif kind == B_WATCH then px.watch(tok)
             else px.start(tok)
             end
  rescue ::Asterism::Error => e
    @cmd_f = nil
    @note = e.message.to_s
    @dirty = true
  end

  def collect_cmd
    f = @cmd_f
    return unless f && f.done?
    @cmd_f = nil
    begin
      r = f.value
      @note = r == "ok" ? "" : reason(r)
    rescue ::Asterism::Error => e
      @host_away = true
    end
    @tc.ask_view
    @dirty = true
  end

  # ------------------------------------------------------------ the view

  def bytes_of(s)
    out = []
    return out unless s.is_a?(String)
    i = 0
    n = s.bytesize
    while i < n
      out << s.getbyte(i)
      i += 1
    end
    out
  end

  def hand_codes
    @view && @seat ? bytes_of(@view["h"]) : []
  end

  def drawn
    d = @view && @seat ? @view["dt"] : nil
    d.is_a?(Integer) ? d : -1
  end

  # The offer [type, tiles] of a type, or nil.
  # The n-th offer (0 the first) whose type is one of types, as the host
  # lists them: the order the buttons show them in.
  def run_nth_offer(types, n)
    a = @view ? @view["a"] : nil
    return unless a.is_a?(Array)
    i = 0
    while i < a.size
      o = a[i]
      if o.is_a?(Array) && types.include?(o[0])
        return run_button(o[0], bytes_of(o[1])) if n == 0
        n -= 1
      end
      i += 1
    end
  end

  # The key of a chi or kan button: C (K) for the first of its kind, V B (L J)
  # for the next ones, as shortcut reads them.
  def call_key(type, tl)
    chi = type == A_CHI
    keys = chi ? CHI_KEYS : KAN_KEYS
    a = @view ? @view["a"] : nil
    return keys[0] unless a.is_a?(Array)
    n = 0
    i = 0
    while i < a.size
      o = a[i]
      if o.is_a?(Array) && (chi ? o[0] == A_CHI : (o[0] == A_ANKAN || o[0] == A_KAKAN || o[0] == A_MINKAN))
        return keys[n < keys.size ? n : keys.size - 1] if o[0] == type && bytes_of(o[1]) == tl
        n += 1
      end
      i += 1
    end
    keys[0]
  end

  def offer(type)
    a = @view ? @view["a"] : nil
    return nil unless a.is_a?(Array)
    i = 0
    while i < a.size
      return a[i] if a[i].is_a?(Array) && a[i][0] == type
      i += 1
    end
    nil
  end

  # Whether tile code c may be discarded now (or chosen for riichi).
  def can_discard?(c)
    o = offer(@pick ? A_RIICHI : A_DAHAI)
    return false unless o
    bytes_of(o[1]).index(c) ? true : false
  end

  def discard(c)
    return unless can_discard?(c)
    act(@pick ? A_RIICHI : A_DAHAI, [c])
  end

  # The hand tile at index i (the drawn tile is the last).
  def hand_at(i)
    h = hand_codes
    return h[i] if i < h.size
    i == h.size && drawn >= 0 ? drawn : nil
  end

  def rel(seat)
    (seat - (@seat || 0)) % 4
  end

  WIND = ["æ±", "å—", "è¥¿", "åŒ—"]

  def wind_of(seat)
    r = @view ? @view["r"] : nil
    oya = r.is_a?(Array) && r.size > 4 ? r[4].to_i : 0
    WIND[(seat - oya) % 4]
  end

  def tile_text(c)
    return "--" if c.nil? || c < 0
    return "##" if c >= 37
    return ["æ±", "å—", "è¥¿", "åŒ—", "ç™½", "ç™¼", "ä¸­"][c - 30] if c >= 30
    n = c % 10
    s = ["m", "p", "s"][c / 10]
    n == 9 ? "0#{s}" : "#{n + 1}#{s}"
  end

  # The screen: :status (connecting, joining), :list, :lobby, :table.
  def mode
    return :status if @tc.net != :up && @tc.table.nil?
    return :list if @tc.table.nil?
    return :status if @tc.token.nil? || @view.nil?
    @view["st"] == "wait" ? :lobby : :table
  end

  # The host waits for calls on a discard (r[7] == 2).
  def calls_phase?
    r = @view ? @view["r"] : nil
    r.is_a?(Array) && r.size > 7 && r[7] == 2
  end

  # The owner: "mo" says so in this member's own view (asterism-games
  # 0.20.0: an owner without a seat too); an older host's "ow" is the
  # owner's seat.
  def owner?
    return false unless @view
    return true if @view["mo"] == 1
    @seat && @view["ow"] == @seat
  end

  # The host says a watch game may start now (the lobby view's "wc": 1
  # yes, 2 the seats are over the AI limit; none from an older host).
  def watch_code
    wc = @view ? @view["wc"] : nil
    # (the app's VM has no nil.to_i)
    wc.is_a?(Integer) ? wc : 0
  end

  def seat_kinds
    sk = @view ? @view["sk"] : nil
    sk.is_a?(Array) ? sk : [0, 0, 0, 0]
  end

  def away?(seat)
    @view && (@view["aw"].to_i >> seat) & 1 == 1
  end

  # ------------------------------------------------------------ input

  def on_event(ev)
    t = ev[:type]
    return if title_skip(t)
    if t == :key_down
      @keys << [ev[:scancode], ev[:character] || 0]
    elsif t == :mouse_up && ev[:button] == 1
      @clicks << [ev[:x], ev[:y]]
    elsif t == :mouse_move
      @move = [ev[:x], ev[:y]]
    end
  end

  def run_key(k)
    m = mode
    if m == :list
      list_key(k)
    elsif m == :lobby
      lobby_key(k)
    elsif m == :table
      return if rv_skip
      if @seat.nil?
        leave_table if k[0] == FmrbConst::KEY_ESC || k[1] == 27
      else
        table_key(k)
      end
    end
  end

  def enter?(k)
    k[0] == FmrbConst::KEY_ENTER || k[1] == 13 || k[1] == 10
  end

  def list_key(k)
    return name_key(k) if @name_edit
    ch = k[1]
    return name_begin if ch == 110 || ch == 78
    l = @tc.table_list
    n = l.size
    return if n == 0
    return rp_open(l[@list_sel % n]) if ch == 104 || ch == 72
    if k[0] == FmrbConst::KEY_UP
      @list_sel = (@list_sel - 1) % n
      @dirty = true
    elsif k[0] == FmrbConst::KEY_DOWN
      @list_sel = (@list_sel + 1) % n
      @dirty = true
    elsif enter?(k)
      join(l[@list_sel % n])
    end
  end

  def lobby_key(k)
    return name_key(k) if @name_edit
    ch = k[1]
    ch += 32 if ch >= 65 && ch <= 90
    return if seat_key(k) || rule_key(k)
    if k[0] == FmrbConst::KEY_ESC || ch == 27
      leave_table
    elsif enter?(k)
      lobby(B_START, -1) if owner?
    elsif ch >= 49 && ch <= 52
      lobby(B_SIT, ch - 49)
    elsif ch == 115
      lobby(B_STAND, -1)
    elsif ch == 99
      lobby(B_CPU_ON, -1) if owner?
    elsif ch == 119
      lobby(B_WATCH, -1) if owner? && watch_code == 1
    elsif ch == 97
      cycle_assist
    elsif ch == 110
      name_begin
    elsif ch == 104
      rp_open(@tc.table)
    end
  end

  # The recent games and their records (MJ6): a file of its own, read
  # only when opened (the game itself never loads it).
  def rp_open(p)
    return unless p
    require "#{APP_DIR}/mahjong_replay"
    watch_load
    rp_start(p)
  end

  def table_key(k)
    sc = k[0]
    ch = k[1]
    n = hand_codes.size + (drawn >= 0 ? 1 : 0)
    if sc == FmrbConst::KEY_LEFT
      choose(@sel <= 0 ? n - 1 : @sel - 1, false)
    elsif sc == FmrbConst::KEY_RIGHT
      choose(@sel >= n - 1 ? 0 : @sel + 1, false)
    elsif enter?(k)
      if offer(A_NEXT)
        act(A_NEXT, [])
      else
        c = hand_at(@sel < 0 ? n - 1 : @sel)
        if @pick && !can_discard?(c)
          o = offer(A_RIICHI)
          c = o ? o[1].getbyte(0) : nil
        end
        discard(c) if c
      end
    elsif sc == FmrbConst::KEY_ESC || ch == 27
      if @pick
        @pick = false
        @dirty = true
      elsif offer(A_SKIP)
        act(A_SKIP, [])
      end
    else
      shortcut(ch)
    end
  end

  # Letters for the buttons: r riichi, t tsumo / ron, p pon, c v b the
  # first, second and third chi, k l j the first, second and third kan, n nine
  # kinds.
  CHI_KEYS = ["C", "V", "B"].freeze
  KAN_KEYS = ["K", "L", "J"].freeze
  CHI_CH = [99, 118, 98].freeze  # c v b
  KAN_CH = [107, 108, 106].freeze # k l j

  def shortcut(ch)
    ch += 32 if ch >= 65 && ch <= 90
    return cycle_assist if ch == 97
    n = CHI_CH.index(ch)
    return run_nth_offer([A_CHI], n) if n
    n = KAN_CH.index(ch)
    return run_nth_offer([A_ANKAN, A_KAKAN, A_MINKAN], n) if n
    types = if ch == 114 then [A_RIICHI]
            elsif ch == 116 then [A_TSUMO, A_RON]
            elsif ch == 112 then [A_PON]
            elsif ch == 110 then [A_KYUUSHU]
            else []
            end
    i = 0
    while i < types.size
      o = offer(types[i])
      if o
        run_button(o[0], bytes_of(o[1]))
        return
      end
      i += 1
    end
  end

  # The hand tile under the mouse is chosen (lifted) while the mouse is on
  # it; off the hand, a tile the mouse chose is let go (one the keys chose
  # stays).
  def run_move(m)
    return unless mode == :table && @seat
    idx = @xl ? xl_hand_index_at(m[0], m[1]) : hand_index_at(m[0], m[1])
    if idx
      choose(idx, true)
    elsif @mouse_sel && @sel >= 0
      choose(-1, true)
    end
  end

  # Chooses hand tile i (-1: none). The 1280x720 table redraws what changed
  # anyway; the 640x360 one redraws the two tiles alone unless the help line
  # (the waits or the acceptance) changes too.
  def choose(i, mouse)
    @mouse_sel = mouse
    return if i == @sel || (i >= 0 && answering_call?)
    old = @sel
    ow = [sel_waits, sel_uk]
    @sel = i
    if @xl || !@big
      @dirty = true
    elsif ow != [sel_waits, sel_uk] || @dirty || marks_differ?(old, i)
      @dirty = true
    else
      @hand_redraw = [] if @hand_redraw.nil?
      @hand_redraw << old if old >= 0
      @hand_redraw << i if i >= 0
    end
  end

  def run_click(c)
    return if mode == :table && rv_skip
    x = c[0]
    y = c[1]
    b = @hits.at(x, y)
    return run_button(b[0], b[5]) if b
    return unless mode == :table && @seat
    idx = @xl ? xl_hand_index_at(x, y) : hand_index_at(x, y)
    return if idx.nil?
    choose(idx, true)
    cd = hand_at(idx)
    discard(cd) if cd
    @dirty = true
  end

  def run_button(type, tiles)
    if type == A_RIICHI
      @pick = !@pick
      @dirty = true
    elsif type == B_JOIN
      join(@tc.table_list[tiles[0]])
    elsif type == B_LEAVE
      leave_table
    elsif type == B_ASSIST
      cycle_assist
    elsif type == B_NAME
      @name_edit ? name_done : name_begin
    elsif type == B_RULE
      @rule_sel = tiles[0]
      @seat_sel = nil
      rule_step(tiles[0], 1)
    elsif type == B_RULE_PAGE
      rule_flip(tiles[0])
    elsif type == B_SEAT
      @seat_sel = tiles[0]
      seat_step(tiles[0], 1)
    elsif type == B_RECORDS
      rp_open(@tc.table || @tc.table_list[tiles[0]])
    elsif type == B_QUIT
      stop
    elsif type >= B_SIT
      lobby(type, tiles.empty? ? -1 : tiles[0])
    else
      act(type, tiles)
    end
  end

  # ------------------------------------------------------------ drawing

  def tile_w
    @big ? 42 : 24
  end

  def tile_h
    @big ? 56 : 32
  end

  def hand_y
    @y0 + @h - tile_h - 4
  end

  def hand_x(i)
    x = @x0 + 6 + i * tile_w
    x += 8 if i >= hand_codes.size
    x
  end

  def hand_index_at(x, y)
    return nil if y < hand_y - 8 || y >= hand_y + tile_h
    n = hand_codes.size + (drawn >= 0 ? 1 : 0)
    i = 0
    while i < n
      hx = hand_x(i)
      return i if x >= hx && x < hx + tile_w
      i += 1
    end
    nil
  end

  def big_tile(c, x, y)
    return draw_text_tile(c, x, y, 42, 56) unless @hand_sheet
    @gfx.draw_tile(@hand_sheet.id, (c % 10) * 42, (c / 10) * 56, 42, 56, dst_x: x, dst_y: y)
  end

  def small_tile(c, x, y)
    return draw_text_tile(c, x, y, 24, 32) unless @river_sheet
    @gfx.draw_tile(@river_sheet.id, (c % 10) * 24, (c / 10) * 32, 24, 32, dst_x: x, dst_y: y)
  end

  def draw_text_tile(c, x, y, w, h)
    @gfx.fill_rect(x, y, w - 1, h - 1, C_TEXT)
    @gfx.draw_text(x + 2, y + 2, tile_text(c), 0x00)
  end

  def text(x, y, s, color = C_TEXT)
    @gfx.draw_text(x, y, s, color)
  end

  # The font: px 12 or 16 (efont), scaled by size (1 or 2).
  def fnt(px, size)
    @gfx.set_font(:ja, px)
    @gfx.set_text_size(size)
    @fw = px * size
  end

  # The 640x360 screens' pixels at this screen's scale.
  def u(n)
    n * @k
  end

  # Pixel width with the font set by fnt (ASCII half the full width).
  def tw(s)
    w = 0
    i = 0
    n = s.bytesize
    half = @fw / 2
    while i < n
      b = s.getbyte(i)
      if b < 0x80
        w += half
        i += 1
      else
        w += @fw
        i += b >= 0xF0 ? 4 : (b >= 0xE0 ? 3 : 2)
      end
    end
    w
  end

  # Text with 2 px between a half-width character and a full-width one
  # after it. The 12 px font draws some digits up to the right edge of their
  # cell ("2" fills columns 1-5 of 6) and kanji from the left edge of theirs,
  # so "2ç¿»" has no blank column between them and the 2 reads as covered.
  def text_spaced(x, y, s, color = C_TEXT)
    run = ""
    wide = false
    n = s.bytesize
    i = 0
    while i < n
      b = s.getbyte(i)
      len = b < 0x80 ? 1 : (b >= 0xF0 ? 4 : (b >= 0xE0 ? 3 : 2))
      ch = s.byteslice(i, len)
      if !run.empty? && (b >= 0x80) != wide
        text(x, y, run, color)
        x += tw(run)
        x += 2 if !wide && run.getbyte(run.bytesize - 1) != 32
        run = ""
      end
      wide = b >= 0x80
      run << ch
      i += len
    end
    text(x, y, run, color) unless run.empty?
  end

  # label: a text, or a call's [head, tiles, key] (MJ8: the tiles as pictures).
  def button(type, tiles, x, y, label, h = u(20))
    w = btn_label_w(label) + u(12)
    @hits.add(type, x, y, w, h, tiles)
    @gfx.fill_round_rect(x, y, w, h, u(4), C_BTN)
    btn_content(label, x, y, w, h)
    w
  end

  def draw_screen
    return title_draw if @title_until
    t0 = Machine.board_millis
    @mk = mark_kind
    m = @unsupported ? :retro : mode
    if @xl && m == :table
      xl_draw
      @gfx.present
      perf_note(:draw, Machine.board_millis - t0)
      note_latency
      return
    end
    @xl_items = nil
    @hits.clear
    clear_user_area(C_FELT)
    fnt(12, @k)
    if m == :table && watching?
      watch_load
      draw_watch
      draw_shout
      draw_result if (@view["res"] || @view["fin"]) && !@shout
      draw_intro
    elsif m == :retro
      text(@x0 + 8, @y0 + 8, t(:mj_title))
      text(@x0 + 8, @y0 + 26, t(:mj_retro))
    elsif m == :status
      draw_status
    elsif m == :list
      draw_list
    elsif m == :lobby
      draw_lobby
    else
      draw_info
      draw_seats
      draw_rivers
      draw_melds
      draw_hand
      draw_controls
      draw_shout
      draw_result if (@view["res"] || @view["fin"]) && !@shout
      draw_intro
    end
    @gfx.present
    perf_note(:draw, Machine.board_millis - t0) if m == :table
    note_latency
  end

  def note_latency
    return unless @lat_pending
    @lat = @lat_pending
    @lat_pending = nil
    Log.info("mahjong: act -> screen #{@lat} ms")
    perf_note(:lat, @lat)
  end

  # ------------------------------------------------------------ measuring
  #
  # With /home/mahjong_perf.on present, the time of every table drawing and
  # of every action to its screen go to /home/mahjong_perf.txt (one line
  # each: "draw ms items px" / "lat ms action"), rewritten every 20 lines.

  def perf_wanted?
    File.exist?(PERF_ON)
  rescue
    false
  end

  def perf_note(kind, ms)
    return unless @perf_on
    @perf << (kind == :draw ? "draw #{ms} #{@xl ? @xl_n_items : 0} #{@xl ? @xl_n_px : 0}" : "lat #{ms} #{@act_type}")
    @perf.shift if @perf.size > 5000
    return unless @perf.size % 20 == 0
    begin
      f = File.open(PERF_OUT, "w")
      f.write(@perf.join("\n") + "\n")
      f.close
    rescue => e
      Log.info("mahjong: perf: #{e.message}")
    end
  end

  def net_line
    net = @tc.net
    if net == :connecting
      "#{t(:mj_connecting)}: #{@tc.link.router}"
    elsif net == :down || @tc.reconnecting?
      "#{t(:mj_lost)} #{@tc.link.reason}"
    elsif @tc.host_gone?
      t(:mj_host_left)
    elsif @host_away
      t(:mj_host_away)
    else
      nil
    end
  end

  def draw_status
    x = @x0 + u(8)
    y = @y0 + u(8)
    text(x, y, "#{t(:mj_title)}  #{@name}")
    line = net_line || "#{t(:mj_joining)}: #{@tc.table}"
    text(x, y + u(20), line, C_DIM)
    text(x, y + u(40), @note, C_TURN) unless @note.empty?
  end

  # The tables on the network, with what their last put said.
  def draw_list
    x = @x0 + u(8)
    y = @y0 + u(8)
    text(x, y, t(:mj_title))
    nx = x + tw(t(:mj_title)) + u(12)
    # The app's close button at the top right (a fullscreen app has no window
    # frame to close it by), the name's button in the room left of it.
    qx = @x0 + @w - tw(t(:mj_quit)) - u(20)
    button(B_QUIT, [], qx, y - u(3), t(:mj_quit))
    sx = qx - snd_buttons_w
    snd_buttons(sx, y - u(3))
    draw_name_button(nx, y - u(3), sx - nx - u(8))
    l = net_line
    text(x, y + u(18), l, C_DIM) if l
    y += u(40)
    l = @tc.table_list
    if l.empty?
      text(x, y, t(:mj_searching), C_DIM)
    else
      text(x, y, t(:mj_tables), C_DIM)
      rb = t(:mj_records)
      button(B_RECORDS, [@list_sel % l.size], @x0 + @w - tw(rb) - u(20), y - u(5), rb)
      y += u(18)
      i = 0
      while i < l.size
        p = l[i]
        s = @tc.tables[p] || {}
        @gfx.fill_rect(x - u(2), y - u(3), @w - u(16), u(20), C_SEL) if i == @list_sel % l.size
        # The host's app is always games: show <host>/<table>.
        parts = p.split("/")
        line = "#{parts[0]}/#{parts[2]}  #{table_status(s)}"
        line = "#{line}  #{t(:mj_mine)}" if @mine[p]
        text(x + u(2), y + u(1), fit(line, @w - u(20)), i == @list_sel % l.size ? C_TURN : C_TEXT)
        @hits.add(B_JOIN, x - u(2), y - u(3), @w - u(16), u(20), [i])
        y += u(22)
        i += 1
      end
    end
    text(x, @y0 + @h - u(18), @note, C_TURN) unless @note.empty?
    draw_host_version(true)
  end

  # The AI players the host offers (the lobby view's "ak"; none without
  # its keys), and whether a seat is one ("ai").
  def ai_kinds
    ak = @view ? @view["ak"] : nil
    ak.is_a?(Array) ? ak : []
  end

  def ai_seat?(s)
    ai = @view ? @view["ai"] : nil
    ai.is_a?(Array) && !ai[s].to_s.empty?
  end

  def ai_label(kind)
    kind == "claude" ? "Claude" : (kind == "jev" ? "Jev" : kind.to_s)
  end

  def table_status(s)
    st = s["st"].to_s
    return "" if st.empty?
    sk = s["sk"].is_a?(Array) ? s["sk"] : []
    hn = 0
    cn = 0
    i = 0
    while i < sk.size
      hn += 1 if sk[i] == 1
      cn += 1 if sk[i] == 2
      i += 1
    end
    head = st == "wait" ? t(:mj_lobby) : (st == "over" ? t(:mj_ended) : t(:mj_playing))
    line = "#{head}  #{t(:mj_humans)} #{hn} / #{t(:mj_cpus)} #{cn} / #{t(:mj_free)} #{4 - hn - cn}"
    @big ? "#{line}  (#{s['mb'].to_i}#{t(:mj_members)})" : line
  end

  # The lobby: the four seats, who watches, the owner's buttons.
  def draw_lobby
    v = @view
    x = @x0 + u(8)
    y = @y0 + u(8)
    text(x, y, "#{t(:mj_title)}  #{t(:mj_lobby)}  #{@tc.table}")
    l = net_line
    text(x, y + u(16), l, C_DIM) if l
    nm = v["nm"].is_a?(Array) ? v["nm"] : []
    sk = seat_kinds
    ow = v["ow"].to_i
    row_h = u(@big ? 30 : 24)
    y = @y0 + u(@big ? 44 : 36)
    bx = @x0 + u(@big ? 330 : 230)
    s = 0
    while s < 4
      @gfx.fill_rect(x - u(2), y - u(4), (rules && @big ? u(436) : @w - u(16)), row_h - u(4), C_SEL) if s == @seat
      who = sk[s] == 0 ? t(:mj_empty) : nm[s].to_s
      label = "#{t(:mj_seat)}#{s + 1}  #{who}"
      label = "#{label}  [#{t(:mj_ai)}]" if ai_seat?(s)
      label = "#{label}  (#{t(:mj_owner)})" if s == ow
      label = "#{label}  (#{t(:mj_away)})" if away?(s)
      text(x + u(2), y + u(2), label, sk[s] == 0 ? C_DIM : (s == @seat ? C_TURN : C_TEXT))
      cx = bx
      if s == @seat
        cx += button(B_STAND, [], cx, y - u(2), t(:mj_stand)) + u(4)
      elsif sk[s] != 1
        cx += button(B_SIT, [s], cx, y - u(2), "#{t(:mj_sit)}[#{s + 1}]") + u(4)
      end
      draw_seat_state(s, cx, y - u(2)) if sk[s] != 1
      y += row_h
      s += 1
    end
    # Members without a seat.
    mb = v["mb"].is_a?(Array) ? v["mb"] : []
    w = ""
    i = 0
    while i < mb.size
      # [name, seat (-1: none), flags (1 away, 2 owner)]
      case mb[i]
      in [name, Integer => seat, Integer => flags, *] if seat < 0
        w = "#{w} #{name}"
        w = "#{w}(#{t(:mj_owner)})" if flags & 2 == 2
        w = "#{w}(#{t(:mj_away)})" if flags & 1 == 1
      else
      end
      i += 1
    end
    text(x + u(2), y + u(2), fit("#{t(:mj_watchers)}#{w}", rules && @big ? u(436) : @w - u(16)), C_DIM)
    draw_rules
    y += u(22)
    cx = x
    wc = watch_code
    if owner?
      cx += button(B_CPU_ON, [], cx, y, t(:mj_fill)) + u(6) if sk.index(0)
      # Every seat a CPU or an AI player: a watch game (GS15) in place of
      # the start, which needs a person.
      if wc == 1
        cx += button(B_WATCH, [], cx, y, t(:mj_watch)) + u(6)
      elsif sk.index(0).nil? && sk.index(1)
        # (the start needs a person seated)
        cx += button(B_START, [], cx, y, t(:mj_start)) + u(6)
      end
    end
    cx += button(B_LEAVE, [], cx, y, t(:mj_leave)) + u(6)
    cx += button(B_RECORDS, [], cx, y, t(:mj_records)) + u(6) if @big
    button(B_QUIT, [], cx, y, t(:mj_quit))
    if !owner?
      text(x + u(2), y + u(26), t(:mj_owner_starts), C_DIM)
    elsif wc == 2
      text(x + u(2), y + u(26), t(:mj_watch_ai), C_DIM)
    end
    text(x + u(2), y + u(44), @note, C_TURN) unless @note.empty?
    y += u(@big ? 68 : 62)
    cx = x + button(B_ASSIST, [], x, y, assist_label) + u(8)
    text(cx, y + u(4), @assist_notes[@assist], C_DIM) if @big
    if @big
      draw_name_button(x, y + u(28), @w - u(16))
      snd_credit(snd_buttons(x, y + u(56)), y + u(56))
    else
      cx = snd_buttons(cx, y)
      draw_name_button(cx, y, @x0 + @w - cx - u(8))
    end
    draw_host_version(false)
  end

  # 640x360: the round on two lines at the top left (clear of the opposite
  # seat's name), the dora at the top right (draw_dora). The small table:
  # one line, the dora after it.
  def draw_info
    v = @view
    x = @x0 + (@big ? 4 : 92)
    y = @y0 + 2
    # r: [wind, hand, repeats, sticks, dealer, tiles left, ...]
    case v["r"]
    in nil then return
    in [wind, hand, repeats, sticks, *rest]
      head = "#{WIND[wind.to_i % 4]}#{hand}#{t(:mj_kyoku)}  #{repeats}#{t(:mj_honba)}"
      tail = "#{t(:mj_sticks)}#{sticks}"
      tail = "#{tail}  #{t(:mj_left)}#{rest[1]}" if rest.size > 1
    else
      return
    end
    if @big
      text_spaced(x, y, head)
      text_spaced(x, y + 16, tail)
      return draw_dora
    end
    s = "#{head}  #{tail}"
    text_spaced(x, y, s)
    dx = x + tw(s) + 20
    d = bytes_of(v["dora"])
    text(dx, y, t(:mj_dora))
    dx += tw(t(:mj_dora)) + 4
    i = 0
    while i < d.size
      text(dx + i * 14, y, tile_text(d[i]), C_TURN)
      i += 1
    end
  end

  # 640x360: the dora indicators right-aligned against the assist button
  # (LAYOUT640 :dora), so up to five of them fit.
  def draw_dora
    d = bytes_of(@view["dora"])
    r = layout640(:dora)
    y = @y0 + r[1]
    dx = @x0 + r[0] + r[2] - (tw(t(:mj_dora)) + 4 + d.size * 24)
    text(dx, y + 8, t(:mj_dora))
    dx += tw(t(:mj_dora)) + 4
    i = 0
    while i < d.size
      small_tile(d[i], dx + i * 24, y)
      same_mark(d[i], dx + i * 24, y, 24, 32)
      i += 1
    end
  end

  # Name, wind, score, riichi, away of each seat.
  def draw_seats
    v = @view
    nm = v["nm"].is_a?(Array) ? v["nm"] : []
    sc = v["sc"].is_a?(Array) ? v["sc"] : []
    ri = v["ri"].to_i
    r = v["r"]
    cur = r.is_a?(Array) && r.size > 6 ? r[6].to_i : -1
    s = 0
    while s < 4
      tail = " #{sc[s]}"
      tail = "#{tail} #{t(:mj_riichi)}" if (ri >> s) & 1 == 1
      away = away?(s)
      tail = "#{tail} (#{t(:mj_away)})" if away
      head = "#{wind_of(s)} "
      name = s == @seat ? t(:mj_you) : nm[s].to_s
      rl = rel(s)
      # The name gives way so the label stays in its place (the left and the
      # across labels are on one line).
      room = (@big ? [160, 136, 192, 136][rl] : (rl == 2 ? 230 : 86)) - tw(head) - tw(tail)
      label = "#{head}#{fit(name, room)}#{tail}"
      turn = s == cur && v["st"] == "play"
      p = seat_label_pos(rl)
      if @big
        seat_box(rl, p[0], p[1], label, away, turn) # white on a box, as the own seat's (MJ8)
      else
        text(p[0], p[1], label, away ? C_AWAY : (turn ? C_TURN : C_TEXT))
        # The seat to act: underlined too (a spectator has no hand to tell it).
        @gfx.fill_rect(p[0], p[1] + 13, tw(label), 2, C_TURN) if turn
      end
      s += 1
    end
  end

  # s cut (by characters) to at most w pixels, with ".." when cut (the room
  # for ".." measured at the current text size).
  def fit(s, w)
    @gfx.fit_text(s, w, "..")
  end

  def seat_label_pos(rl)
    if @big
      return [[@x0 + 4, @y0 + 250], [@x0 + 492, @y0 + 38], [@x0 + 152, @y0 + 22], [@x0 + 4, @y0 + 38]][rl]
    end
    [[@x0 + 92, @y0 + 160], [@x0 + 336, @y0 + 14], [@x0 + 92, @y0 + 14], [@x0 + 2, @y0 + 14]][rl]
  end

  # River areas: [x, y, tiles per row, rows].
  def river_area(rl)
    if @big
      return [[@x0 + 176, @y0 + 170, 12, 3], [@x0 + 492, @y0 + 120, 6, 4],
              [@x0 + 176, @y0 + 72, 12, 3], [@x0 + 4, @y0 + 120, 6, 4]][rl]
    end
    [[@x0 + 92, @y0 + 120, 18, 3], [@x0 + 336, @y0 + 40, 7, 9],
     [@x0 + 92, @y0 + 40, 18, 3], [@x0 + 2, @y0 + 40, 7, 9]][rl]
  end

  def draw_rivers
    kw = @view["kw"]
    return unless kw.is_a?(Array)
    ls = @view["ls"]
    s = 0
    while s < 4
      a = river_area(rel(s))
      b = bytes_of(kw[s])
      cw = @big ? 24 : 13
      ch = @big ? 32 : 13
      # The tiles past the last row's room close up in it.
      n = 0
      b.each { |c| n += 1 if c & 0x80 == 0 }
      before = (a[3] - 1) * a[2] # the tiles of the rows before the last
      lens = []
      (n - before).times { lens << cw } if n > before
      offs = close_up(lens, a[2] * cw)
      i = 0
      k = 0
      while i < b.size
        c = b[i]
        if c & 0x80 == 0 # a tile called away is not in the river
          if k < before
            x = a[0] + (k % a[2]) * cw
            y = a[1] + (k / a[2]) * ch
          else
            x = a[0] + offs[k - before]
            y = a[1] + (a[3] - 1) * ch
          end
          code = c & 0x3F
          if @big
            small_tile(code, x, y)
            same_mark(code, x, y, 24, 32)
            @gfx.fill_rect(x + 2, y + 28, 20, 3, C_RED) if c & 0x40 != 0
          else
            text(x, y, tile_text(code), c & 0x40 != 0 ? C_RED : C_TEXT)
          end
          last = i == b.size - 1 && ls.is_a?(Array) && ls[0] == s
          @gfx.draw_rect(x, y, cw - 1, ch - 1, C_LAST) if last
          k += 1
        end
        i += 1
      end
      s += 1
    end
  end

  # Melds: [kind, from, n, tiles...]; kind 3 is a closed kan.
  def draw_melds
    fu = @view["fu"]
    return unless fu.is_a?(Array)
    return draw_melds640 if @big
    s = 0
    while s < 4
      b = bytes_of(fu[s])
      rl = rel(s)
      tiles = []
      i = 0
      while i + 2 < b.size
        n = b[i + 2]
        j = 0
        while j < n
          c = b[i + 3 + j]
          c = 37 if b[i] == 3 && (j == 0 || j == n - 1)
          tiles << c
          j += 1
        end
        tiles << -1
        i += 3 + n
      end
      draw_meld_tiles(rl, tiles)
      s += 1
    end
  end

  # The small table's melds: the own ones as short texts ("3m-5m" a chi,
  # "3mx3" a pon, "3mx4" a kan), the others' as a count (640x360:
  # draw_melds640, mahjong_panels.rb).
  def draw_meld_tiles(rl, tiles)
    return if tiles.empty?
    ms = []
    cur = []
    tiles.each do |c|
      if c < 0
        ms << cur
        cur = []
      else
        cur << c
      end
    end
    if rl == 0
      s = ""
      ms.each do |m|
        f = m[0] == 37 ? m[1] : m[0]
        s = "#{s} #{m[0] == m[1] || m[0] == 37 ? "#{tile_text(f)}x#{m.size}" : "#{tile_text(m[0])}-#{tile_text(m[m.size - 1])}"}"
      end
      text(@x0 + 250, @y0 + 160, s.strip, C_DIM)
    else
      k = 0
      ms.each { |m| k += 1 if m.size == 4 }
      s = "é³´#{ms.size}"
      s = "#{s} æ§“#{k}" if k > 0
      text(rl == 2 ? @x0 + 92 : (rl == 1 ? @x0 + 336 : @x0 + 2), @y0 + 27, s, C_DIM)
    end
  end

  def draw_hand
    n = hand_codes.size + (drawn >= 0 ? 1 : 0)
    i = 0
    while i < n
      draw_hand_tile(i)
      i += 1
    end
  end

  SEL_LIFT = 6            # the 640x360 table: the chosen tile is this much higher

  # Hand tile i: lifted and framed in blue when chosen; the help marks the
  # discards that leave the hand tenpai (a triangle above the tile); while
  # picking the riichi tile, the others get a bar.
  def draw_hand_tile(i)
    c = hand_at(i)
    return unless c
    x = hand_x(i)
    y = hand_y
    y -= SEL_LIFT if i == @sel
    if @big
      big_tile(c, x, y)
    else
      small_tile(c, x, y)
    end
    chosen_frame(x, y, tile_w, tile_h) if i == @sel
    mk = help_mark(c)
    if mk
      assist_mark(x, y, tile_w, mk == :keep ? C_KEEP : C_TURN)
    elsif @pick && !can_discard?(c)
      @gfx.fill_rect(x + 2, y + tile_h - 8, tile_w - 4, 3, C_DIM)
    end
  end

  # A downward triangle in a w wide box at (x, y) (r: its half width): the
  # legend of the 1280x720 help line (the hand tiles use assist_mark).
  def tenpai_mark(x, y, w, r, col = C_TURN)
    cx = x + w / 2
    @gfx.fill_triangle(cx - r - 1, y + 2, cx + r + 1, y + 2, cx, y + r + r + 3, 0x00)
    @gfx.fill_triangle(cx - r, y + 3, cx + r, y + 3, cx, y + r + r + 1, col)
  end

  # The 640x360 table: only the chosen tile moved (the mouse or the keys).
  def redraw_hand_tiles(list)
    i = 0
    while i < list.size
      k = list[i]
      x = hand_x(k)
      top = hand_y - SEL_LIFT - mark_rise
      @gfx.fill_rect(x, top, tile_w, hand_y + tile_h - top, C_FELT)
      draw_hand_tile(k)
      i += 1
    end
    @gfx.present
  end

  # "å¾…ã¡ 1s:3 4s:3 è¨ˆ6æžš" for the chosen tile (nil: no help).
  def waits_text
    w = sel_waits
    return uk_text unless w
    s = t(:mj_waits)
    sum = 0
    i = 0
    while i < w.size
      s = "#{s} #{tile_text(w[i][0])}:#{w[i][1]}"
      sum += w[i][1]
      i += 1
    end
    "#{s} #{t(:mj_total)}#{sum}#{t(:mj_mai)}"
  end

  # "1å‘è´ å—ã‘å…¥ã‚Œ 2m 5p 8s 3ç¨®10æžš" for the chosen tile (level 3; the
  # tiles only while the line stays short).
  def uk_text
    u = sel_uk
    return nil unless u
    return t(:mj_no_wait) if u[0] == 0
    l = u[1]
    sum = 0
    tl = ""
    i = 0
    while i < l.size
      sum += l[i][1]
      tl = "#{tl} #{tile_text(l[i][0])}"
      i += 1
    end
    head = "#{u[0]}#{t(:mj_shanten)} #{t(:mj_ukeire)}"
    tail = "#{l.size}#{t(:mj_kinds)}#{sum}#{t(:mj_mai)}"
    l.size <= 8 ? "#{head}#{tl} #{tail}" : "#{head} #{tail}"
  end

  def button_label(type, tl)
    case type
    when A_RIICHI then "#{t(:mj_riichi)}[R]"
    when A_TSUMO then "#{t(:mj_tsumo)}[T]"
    when A_RON then "#{t(:mj_ron)}[T]"
    when A_PON then "#{t(:mj_pon)}[P]"
    when A_CHI then "#{t(:mj_chi)} #{tile_text(tl[0])}#{tile_text(tl[1])}[#{call_key(type, tl)}]"
    when A_ANKAN, A_KAKAN then "#{t(:mj_kan)} #{tile_text(tl[0])}[#{call_key(type, tl)}]"
    when A_MINKAN then "#{t(:mj_kan)}[#{call_key(type, tl)}]"
    when A_SKIP then "#{t(:mj_pass)}[Esc]"
    when A_KYUUSHU then "#{t(:mj_kyuushu)}[N]"
    when A_NEXT then "#{t(:mj_next)}[Enter]"
    end
  end

  def seat_name(s)
    return "-" unless s.is_a?(Integer)
    return t(:mj_you) if s == @seat
    nm = @view["nm"]
    nm.is_a?(Array) ? nm[s].to_s : s.to_s
  end

  # ------------------------------------------------------------ the loop

  def on_update
    now = Machine.board_millis
    title_tick(now)
    return 500 if @unsupported
    if @tc.update
      if @tc.table.nil?
        probe_tables
      else
        collect_act
        collect_cmd
        @tc.update_view(now)
        if @rename_f && @rename_f.done?
          @rename_f = nil
          @tc.ask_view
        end
      end
    end
    run_key(@keys.shift) until @keys.empty?
    if @move
      run_move(@move)
      @move = nil
    end
    run_click(@clicks.shift) until @clicks.empty?
    if now >= @mem_at
      # The VM pool, now and then, for the report (doc/ruby_asterism/report/mj2.md).
      @mem_at = now + MEM_EVERY_MS
      Log.info("mahjong: pool #{FmrbApp.pool_used / 1024} KB (#{FmrbApp.pool_usage}%)")
    end
    shout_tick(now)
    round_tick(now)
    if @deadline && (@deadline - now) / 1000 != @second
      @second = (@deadline - now) / 1000
      @dirty = true
    end
    if @dirty
      @dirty = false
      @hand_redraw = nil
      draw_screen
    elsif @hand_redraw
      redraw_hand_tiles(@hand_redraw)
      @hand_redraw = nil
    end
    30
  end

  # The host keeps the seat (a player who closes the app comes back to it):
  # no leave, the connection closed only.
  def on_destroy
    @tc.close unless @unsupported
    Log.info("mahjong: closed")
  rescue => e
    Log.info("mahjong: close: #{e.message}")
  end
end

begin
  app = MahjongApp.new
  app.start
rescue => e
  puts "mahjong: #{e.message}"
end
app_handle_name = "mahjong"
app_screen_name = "Hide Jong"
app_screen_name_ja = "ãƒ’ãƒ‡é›€"
default_window_mode = "fullscreen"
# 640x360 on Modern and the browser build while it is on top.
fullscreen_hires = true
single_instance = true
# The LARGE pool (2x the ordinary one). Compiling the 57 KB main file peaks
# at 94% of the ordinary pool on Modern (986 KB of 1 MB); after that compile
# the pool is in pieces and the required files no longer fit
# (doc/reference/app_memory.md).
large_memory = 1
icon = "app/game/mahjong/mahjong.icon"
