## id: pattern_bind_in_block
## area: pattern
## title: binding an outer local inside a block
## expect: 1
def rp_bind_in_block
  pre = nil
  [{a: 1}].each do |m|
    case m
    in {a: pre} then nil
    end
  end
  pre
end
rp_bind_in_block

