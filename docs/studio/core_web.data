in [*, 42 => x, *] then x
end

## id: pattern_guard_alt
## area: pattern
## title: guard and alternative
## expect: [:odd, :one_or_three]
r = []
r << (case 5
      in Integer => n if n % 2 == 1 then :odd
      else :even
      end)
r << (case 3
      in 1 | 3 then :one_or_three
      else :no
      end)
r

